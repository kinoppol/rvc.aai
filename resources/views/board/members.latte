{layout '../layout.latte'}

{block title}จัดการสมาชิก · {$group['name']}{/block}

{block content}
<div class="form-page">
    <a class="back-link" href="{$base}/board/{$group['id']}">← กลับไปที่ {$group['name']}</a>
    <h1>จัดการสมาชิก</h1>

    {var $pending = array_filter($members, fn($m) => $m['status'] === 'pending')}
    {var $approved = array_filter($members, fn($m) => $m['status'] === 'approved')}

    {if $pending}
        <div style="margin-top:24px">
            <div class="section-label" style="margin-bottom:10px">รออนุมัติ ({count($pending)} คน)</div>
            <div class="list" style="border-radius:10px;overflow:hidden">
                {foreach $pending as $m}
                    <div class="list-row">
                        <div class="grow">
                            <div class="list-title">{$m['full_name']}</div>
                            <div class="list-meta">@{$m['username']}</div>
                        </div>
                        <div style="display:flex;gap:8px">
                            <form method="post" action="{$base}/board/{$group['id']}/members/{$m['user_id']}/approve">
                                <input type="hidden" name="_token" value="{$csrf}">
                                <button class="btn btn-sm btn-primary">อนุมัติ</button>
                            </form>
                            <form method="post" action="{$base}/board/{$group['id']}/members/{$m['user_id']}/reject">
                                <input type="hidden" name="_token" value="{$csrf}">
                                <button class="btn btn-sm btn-ghost-danger">ปฏิเสธ</button>
                            </form>
                        </div>
                    </div>
                {/foreach}
            </div>
        </div>
    {/if}

    {if $approved}
        <div style="margin-top:24px">
            <div class="section-label" style="margin-bottom:10px">สมาชิก ({count($approved)} คน)</div>
            <div class="list" style="border-radius:10px;overflow:hidden">
                {foreach $approved as $m}
                    <div class="list-row">
                        <div class="grow">
                            <div class="list-title">{$m['full_name']}</div>
                            <div class="list-meta">@{$m['username']}</div>
                        </div>
                        {if $m['user_id'] != $group['created_by']}
                            <form method="post" action="{$base}/board/{$group['id']}/members/{$m['user_id']}/reject"
                                  data-confirm-title="ลบสมาชิก" data-confirm-ok="ลบออกจากกลุ่ม" data-confirm-danger
                                  data-confirm="ลบสมาชิกคนนี้ออกจากกลุ่มใช่หรือไม่">
                                <input type="hidden" name="_token" value="{$csrf}">
                                <button class="btn btn-sm btn-ghost-danger">นำออก</button>
                            </form>
                        {else}
                            <span style="font-size:12px;color:var(--ink2)">ผู้สร้าง</span>
                        {/if}
                    </div>
                {/foreach}
            </div>
        </div>
    {/if}

    {if !$pending && !$approved}
        <div class="empty" style="margin-top:24px"><h3>ยังไม่มีสมาชิก</h3></div>
    {/if}
</div>
{/block}
