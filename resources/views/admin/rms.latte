{layout '../layout.latte'}

{block title}โอนข้อมูลจาก RMS{/block}

{block content}
{include '../_partials/system-tabs.latte'}
<style>
    .rms-item { display: flex; gap: 14px; align-items: flex-start; }
    .rms-item + .rms-item { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); }
    .rms-icon { font-size: 26px; line-height: 1; }
    .rms-body { flex: 1; min-width: 0; }
    .rms-body h3 { margin: 0 0 2px; font-size: 16px; }
    .rms-body ul { margin: 6px 0 0; padding-left: 18px; color: var(--ink3); font-size: 13px; }
    .rms-result { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px; font-size: 13px; }
    .rms-bar { height: 8px; border-radius: 99px; background: var(--surface2); overflow: hidden; margin-top: 10px; }
    .rms-bar > i { display: block; height: 100%; width: 0; background: var(--brand); transition: width .25s; }
    .rms-bar.scan > i { width: 30%; animation: rmsScan 1.1s linear infinite; }
    @keyframes rmsScan { from { transform: translateX(-100%); } to { transform: translateX(340%); } }
    .rms-progress-text { font-size: 12.5px; color: var(--ink3); margin-top: 4px; }
    .rms-icon { position: relative; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; }
    .rms-item.is-running .rms-icon { background: var(--brandSoft); animation: rmsBob 1.4s ease-in-out infinite; }
    .rms-item.is-running .rms-icon::after {
        content: ''; position: absolute; inset: -4px; border-radius: 50%;
        border: 3px solid var(--brandLine); border-top-color: var(--brand); animation: rvcSpin .9s linear infinite;
    }
    @keyframes rmsBob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
    .rms-item.is-running .rms-body h3::after { content: ' · กำลังโอน'; color: var(--brand); font-weight: 600; font-size: 13px; }
    .rms-item [data-run] { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; }
    .rms-clock { font-variant-numeric: tabular-nums; opacity: .8; }
    @media (prefers-reduced-motion: reduce) {
        .rms-item.is-running .rms-icon, .rms-bar.scan > i { animation: none; }
        .rms-bar.scan > i { width: 100%; opacity: .5; }
    }
    @media (max-width: 640px) { .rms-item { flex-wrap: wrap; } }
</style>

<div class="wizard-page" style="max-width:820px">
    <h1>โอนข้อมูลจาก RMS</h1>
    <div class="sub">ดึงข้อมูลบุคลากร กลุ่มเรียน และนักเรียนจากระบบ RMS ของวิทยาลัยเข้ามาใช้ในระบบ — กดซ้ำได้ ข้อมูลไม่ซ้ำซ้อน</div>

    <div class="card" style="margin-top:22px">
        <div class="rms-item">
            <div class="rms-icon">🔑</div>
            <div class="rms-body">
                <h3>ผู้ใช้จาก RVC-ONE</h3>
                <div class="hint">
                    ผูกกับ RVC-ONE แล้ว {$oa['linked']} บัญชี
                    {if $oa['since']} · ซิงค์ครบล่าสุดถึง {App\Support\Thai::dateTime($oa['since'])}{else} · ยังไม่เคยซิงค์ครบ (รอบแรกจะดึงทั้งหมด){/if}
                </div>
                <ul>
                    <li>ดึงครูและบุคลากร และนักเรียนนักศึกษา จาก User-sync API ของ RVC-ONE ด้วยรหัสแอปเดียวกับปุ่มเข้าสู่ระบบ (client_secret ตั้งที่หน้า "ทั่วไป")</li>
                    <li>จับคู่ด้วย id ของ RVC-ONE — บัญชีเดิม (เช่นที่โอนจาก RMS) จะถูกผูกด้วยเลขบัตร / ชื่อผู้ใช้ / อีเมล แทนการสร้างซ้ำ · บัญชีใหม่เข้าสู่ระบบผ่าน RVC-ONE</li>
                    <li>ผู้ที่ถูกระงับใน RVC-ONE จะถูก <b>ระงับบัญชี</b> (ไม่ลบ ยกเว้นผู้ดูแลระบบ) และเปิดคืนเองเมื่อกลับมาใช้งาน · ไม่ทับบทบาทและรหัสผ่าน</li>
                    <li>ตั้งเวลาให้รันเองได้บนเซิร์ฟเวอร์: <code>php bin/rvc-one-sync.php</code> (เพิ่ม <code>--full</code> เพื่อดึงทั้งหมดใหม่)</li>
                </ul>
                {if !$oa['ready']}
                    <div class="rms-result"><span class="chip chip-warn">ต้องรันไมเกรชันที่หน้า "ไมเกรชัน" ก่อนจึงจะซิงค์ได้</span></div>
                {elseif $oa['last']}
                    {var $l = $oa['last']}
                    <div class="rms-result">
                        <span class="chip chip-muted">รอบล่าสุด {App\Support\Thai::dateTime($l['at'] ?? null)} · {($l['full'] ?? false) ? 'ทั้งหมด' : 'เฉพาะที่เปลี่ยน'}</span>
                        {if $l['ok'] ?? false}
                            {var $s = $l['stats'] ?? []}
                            <span class="chip chip-ok">เพิ่ม {$s['created'] ?? 0}</span>
                            <span class="chip chip-muted">อัปเดต {$s['updated'] ?? 0}</span>
                            <span class="chip chip-muted">ผูกบัญชีเดิม {$s['linked'] ?? 0}</span>
                            <span n:class="chip, ($s['suspended'] ?? 0) ? 'chip-warn' : 'chip-muted'">ระงับ {$s['suspended'] ?? 0}</span>
                            <span class="chip chip-muted">เปิดคืน {$s['reactivated'] ?? 0}</span>
                            <span n:class="chip, ($s['skipped'] ?? 0) ? 'chip-warn' : 'chip-muted'">ข้าม {$s['skipped'] ?? 0}</span>
                        {else}
                            <span class="chip chip-err">ไม่สำเร็จ: {$l['message'] ?? ''}</span>
                        {/if}
                    </div>
                {/if}
            </div>
            <div style="display:flex;flex-direction:column;gap:6px">
                <form method="post" action="{$base}/admin/rms/rvc-one">
                    <input type="hidden" name="_token" value="{$csrf}">
                    <button type="submit" class="btn btn-primary" style="width:100%" n:attr="disabled: !$oa['ready']">ซิงค์ที่เปลี่ยน</button>
                </form>
                <form method="post" action="{$base}/admin/rms/rvc-one" data-confirm="ดึงรายชื่อผู้ใช้ทั้งหมดจาก RVC-ONE ใหม่ตั้งแต่ต้น อาจใช้เวลาหลายนาที" data-confirm-title="ซิงค์ทั้งหมดใหม่" data-confirm-ok="เริ่มซิงค์">
                    <input type="hidden" name="_token" value="{$csrf}">
                    <input type="hidden" name="mode" value="full">
                    <button type="submit" class="btn" style="width:100%" n:attr="disabled: !$oa['ready']">ซิงค์ทั้งหมดใหม่</button>
                </form>
            </div>
        </div>
    </div>

    <form method="post" action="{$base}/admin/rms/url" class="card" style="margin-top:16px">
        <input type="hidden" name="_token" value="{$csrf}">
        <div class="step-label">ที่อยู่เซิร์ฟเวอร์ RMS</div>
        <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
            <input type="url" name="rms_base_url" class="input" style="flex:1 1 260px" required value="{$rmsUrl}" placeholder="http://rms.rvc.ac.th">
            <button type="submit" class="btn">บันทึก</button>
        </div>
        <div class="hint" style="margin-top:6px">ใส่เฉพาะโฮสต์ เช่น http://rms.rvc.ac.th — ระบบเติม /api_connection.php ให้เอง</div>
    </form>

    <div class="card" style="margin-top:16px">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
            <h2 style="margin:0">ชุดข้อมูล</h2>
            <button type="button" class="btn btn-primary" id="rmsAll">โอนทั้งหมดตามลำดับ</button>
        </div>
        <div class="hint" style="margin:6px 0 16px">ลำดับที่แนะนำ: บุคลากร → กลุ่มเรียน → นักเรียน (นักเรียนจะผูกกับกลุ่มเรียนได้ก็ต่อเมื่อโอนกลุ่มเรียนมาก่อน) · ระหว่างโอนนักเรียน <b>อย่าปิดหน้านี้</b></div>

        <div class="rms-item" data-key="people">
            <div class="rms-icon">👥</div>
            <div class="rms-body">
                <h3>บุคลากร</h3>
                <div class="hint">ในระบบตอนนี้ {$totals['people']} คน</div>
                <ul>
                    <li>เฉพาะผู้ที่ยังปฏิบัติงานอยู่ ชื่อผู้ใช้ = รหัสบุคลากรใน RMS บัญชีใหม่เป็นบทบาท "ครู"</li>
                    <li>ล็อกอินครั้งแรกด้วยรหัสผ่านเดียวกับ RMS ได้ (people_pass) เมื่อล็อกอินสำเร็จ ระบบจะเก็บรหัสผ่านแบบปลอดภัยแล้วเลิกใช้รหัสจาก RMS · ถ้ารหัสใน RMS เปลี่ยน การโอนครั้งถัดไปจะเปิดให้ใช้รหัสใหม่ได้อีกหนึ่งครั้ง</li>
                    <li>ไม่ทับบทบาท และไม่ทับรหัสผ่านที่ผู้ใช้ตั้งเองแล้ว</li>
                    <li>ผู้ที่หายจาก RMS จะถูก <b>ระงับบัญชี</b> (ไม่ลบ) และเปิดคืนเองเมื่อกลับมาใน RMS</li>
                </ul>
                <div class="rms-bar" hidden><i></i></div>
                <div class="rms-progress-text"></div>
                <div class="rms-result"></div>
            </div>
            <button type="button" class="btn" data-run>เริ่มโอน</button>
        </div>

        <div class="rms-item" data-key="groups">
            <div class="rms-icon">🏫</div>
            <div class="rms-body">
                <h3>กลุ่มเรียน</h3>
                <div class="hint">ในระบบตอนนี้ {$totals['groups']} กลุ่ม</div>
                <ul>
                    <li>จับคู่ด้วยรหัสกลุ่ม เก็บข้อมูลจากภาคเรียนล่าสุดที่พบ ใช้เป็นตัวเลือก "กลุ่มเรียน" ของรายวิชา</li>
                    <li>ครูที่ปรึกษาจะผูกกับบัญชีครูเมื่อชื่อ-นามสกุลตรงกัน (ควรโอนบุคลากรก่อน)</li>
                </ul>
                <div class="rms-bar" hidden><i></i></div>
                <div class="rms-progress-text"></div>
                <div class="rms-result"></div>
            </div>
            <button type="button" class="btn" data-run>เริ่มโอน</button>
        </div>

        <div class="rms-item" data-key="students">
            <div class="rms-icon">🧑‍🎓</div>
            <div class="rms-body">
                <h3>นักเรียน</h3>
                <div class="hint">ในระบบตอนนี้ {$totals['students']} คน · โหลดทีละ 100 คน</div>
                <ul>
                    <li>ชื่อผู้ใช้ = รหัสนักศึกษา รหัสผ่านเริ่มต้น = เลขประจำตัวประชาชน (ตั้งเฉพาะบัญชีใหม่)</li>
                    <li>บัญชีนักเรียนที่ครูสร้างไว้แล้วด้วยรหัสเดียวกันจะถูกอัปเดตแทนการสร้างซ้ำ</li>
                    <li>ระบบไม่เก็บเลขประจำตัวประชาชนไว้</li>
                </ul>
                <div class="rms-bar" hidden><i></i></div>
                <div class="rms-progress-text"></div>
                <div class="rms-result"></div>
            </div>
            <button type="button" class="btn" data-run>เริ่มโอน</button>
        </div>
    </div>
</div>

<script>
(function () {
    var base = {$base};
    var token = {$csrf};
    var busy = false;

    function post(path, body) {
        var fd = new FormData();
        fd.append('_token', token);
        Object.keys(body || { }).forEach(function (k) { fd.append(k, body[k]); });
        return fetch(base + path, { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .catch(function () { return { success: false, message: 'ติดต่อเซิร์ฟเวอร์ไม่สำเร็จ' }; });
    }

    function chip(label, n, kind) {
        return '<span class="chip chip-' + (kind || 'muted') + '">' + label + ' ' + Number(n || 0).toLocaleString('th-TH') + '</span>';
    }
    function fail(msg) {
        return '<span class="chip chip-err">' + String(msg).replace(/[<>&]/g, '') + '</span>';
    }

    // เพิ่มชุดข้อมูลใหม่ = เพิ่ม object ในรายการนี้
    var transfers = {
        people: {
            run: function (el) {
                return post('/admin/rms/people').then(function (r) {
                    if (!r.success) { el.result.innerHTML = fail(r.message); return false; }
                    var d = r.data;
                    el.result.innerHTML = chip('เพิ่ม', d.created, 'ok') + chip('อัปเดต', d.updated) +
                        chip('ระงับ', d.deactivated, d.deactivated ? 'warn' : 'muted') + chip('เปิดคืน', d.reactivated) + chip('รหัสผ่าน RMS ใหม่', d.password) +
                        chip('ข้าม', d.skipped, d.skipped ? 'warn' : 'muted') + chip('ปฏิบัติงานใน RMS', d.active_source);
                    return true;
                });
            }
        },
        groups: {
            run: function (el) {
                return post('/admin/rms/groups').then(function (r) {
                    if (!r.success) { el.result.innerHTML = fail(r.message); return false; }
                    var d = r.data;
                    el.result.innerHTML = chip('เพิ่ม', d.added, 'ok') + chip('อัปเดต', d.updated) +
                        chip('ข้าม', d.skipped) + chip('ได้จาก RMS', d.fetched);
                    return true;
                });
            }
        },
        students: {
            row: 100,
            run: async function (el) {
                var row = this.row, offset = 0, done = 0, total = 0, added = 0, updated = 0, skipped = 0;
                el.bar.hidden = false;
                el.bar.classList.add('scan');
                el.text.textContent = 'กำลังนับจำนวนนักเรียนใน RMS…';

                var c = await post('/admin/rms/students/count');
                if (c.success && c.data.total > 0) {
                    total = c.data.total;
                    el.bar.classList.remove('scan');
                }

                while (true) {
                    var r = await post('/admin/rms/students/batch', { offset: offset, row: row });
                    if (!r.success) {
                        el.result.innerHTML = fail('หยุดที่รายการที่ ' + done.toLocaleString('th-TH') + ': ' + r.message);
                        el.bar.classList.remove('scan');
                        return false;
                    }
                    added += r.data.added; updated += r.data.updated; skipped += r.data.skipped;
                    done += r.data.fetched; // แถวดิบจาก RMS ไม่ใช่แถวที่บันทึกได้ — ใช้ตัดสินการจบลูป
                    offset += row;
                    if (total) {
                        el.bar.firstElementChild.style.width = Math.min(100, done / total * 100) + '%';
                        el.text.textContent = done.toLocaleString('th-TH') + ' / ' + total.toLocaleString('th-TH') + ' รายการ';
                    } else {
                        el.text.textContent = 'โหลดแล้ว ' + done.toLocaleString('th-TH') + ' รายการ…';
                    }
                    el.result.innerHTML = chip('เพิ่ม', added, 'ok') + chip('อัปเดต', updated) + chip('ข้าม', skipped, skipped ? 'warn' : 'muted');

                    if (r.data.fetched < row) break;          // ท่อนสุดท้ายได้ไม่เต็ม = หมดแล้ว
                    if (total && done >= total) break;        // กัน RMS คืนเต็มท่อนไม่รู้จบ
                }
                el.bar.classList.remove('scan');
                el.bar.firstElementChild.style.width = '100%';
                el.text.textContent = 'เสร็จแล้ว รวม ' + done.toLocaleString('th-TH') + ' รายการ';
                return true;
            }
        }
    };

    function parts(key) {
        var item = document.querySelector('.rms-item[data-key="' + key + '"]');
        return {
            item: item,
            button: item.querySelector('[data-run]'),
            result: item.querySelector('.rms-result'),
            bar: item.querySelector('.rms-bar') || document.createElement('div'),
            text: item.querySelector('.rms-progress-text') || document.createElement('div')
        };
    }

    function setBusy(on) {
        busy = on;
        document.querySelectorAll('[data-run], #rmsAll').forEach(function (b) { b.disabled = on; });
    }

    function clock(sec) {
        return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0');
    }

    // ทุกชุดข้อมูลได้ภาพเคลื่อนไหว + นาฬิกาจับเวลา — ชุดที่ไม่มีความคืบหน้าจริง (บุคลากร/กลุ่มเรียน) ใช้แถบวิ่งไม่รู้จบ
    async function runOne(key) {
        var el = parts(key);
        var t = transfers[key];
        var label = el.button.textContent;
        var started = Date.now();
        el.item.classList.add('is-running');
        el.button.innerHTML = '<span class="spinner"></span>กำลังโอน… <span class="rms-clock">0:00</span>';
        var clockEl = el.button.querySelector('.rms-clock');
        el.result.innerHTML = '';
        if (!t.row) {
            el.bar.hidden = false;
            el.bar.classList.add('scan');
            el.bar.firstElementChild.style.width = '';
            el.text.textContent = 'กำลังดึงข้อมูลจาก RMS และบันทึกเข้าระบบ อาจใช้เวลาสักครู่…';
        }
        var timer = setInterval(function () {
            clockEl.textContent = clock(Math.round((Date.now() - started) / 1000));
        }, 1000);

        var ok = await t.run(el);

        clearInterval(timer);
        var took = clock(Math.round((Date.now() - started) / 1000));
        el.item.classList.remove('is-running');
        el.button.textContent = label;
        if (!t.row) {
            el.bar.classList.remove('scan');
            el.bar.firstElementChild.style.width = ok ? '100%' : '0';
            el.text.textContent = ok ? 'เสร็จแล้ว ใช้เวลา ' + took + ' นาที' : 'ไม่สำเร็จ (ใช้เวลา ' + took + ' นาที)';
        } else if (ok) {
            el.text.textContent += ' · ใช้เวลา ' + took + ' นาที';
        }
        return ok;
    }

    window.addEventListener('beforeunload', function (e) {
        if (busy) { e.preventDefault(); e.returnValue = ''; }
    });

    document.querySelectorAll('.rms-item [data-run]').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            var key = btn.closest('.rms-item').dataset.key;
            if (!(await rvcConfirm({ title: 'โอนข้อมูลจาก RMS', message: 'เริ่มโอนข้อมูลจาก RMS ตอนนี้?', confirmText: 'เริ่มโอนข้อมูล' }))) return;
            setBusy(true);
            await runOne(key);
            setBusy(false);
        });
    });

    document.getElementById('rmsAll').addEventListener('click', async function () {
        if (!(await rvcConfirm({ title: 'โอนข้อมูลทั้งหมด', message: 'โอนบุคลากร กลุ่มเรียน และนักเรียนตามลำดับ · ระหว่างนี้อย่าปิดหน้า', confirmText: 'เริ่มโอนทั้งหมด' }))) return;
        setBusy(true);
        for (var key of ['people', 'groups', 'students']) {
            if (!(await runOne(key))) break;
        }
        setBusy(false);
    });
})();
</script>
{/block}
