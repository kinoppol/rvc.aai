{layout '../layout.latte'}

{block title}รายวิชา สอศ.{/block}

{* คลังรายวิชามาตรฐาน สอศ. (ตาราง subject_catalog) — ข้อมูลจาก ศธ.02 ออนไลน์ ใช้เติมฟอร์มรายวิชาของครูเมื่อกรอกรหัสวิชา *}
{block content}
{include '../_partials/system-tabs.latte'}
<style>
    .subj-metrics { margin: 6px 0 22px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    @media (max-width: 860px) { .subj-metrics { grid-template-columns: 1fr; } }
</style>

<div class="page-head">
    <div>
        <h1>คลังรายวิชา สอศ.</h1>
        <div class="sub">
            ข้อมูลรายวิชามาตรฐานจากระบบ ศธ.02 ออนไลน์ (std2018.vec.go.th) — ครูกรอกรหัสวิชาในฟอร์มสร้างรายวิชา
            แล้วระบบเติมชื่อวิชา ท-ป-น คำอธิบาย จุดประสงค์ และสมรรถนะให้จากคลังนี้
        </div>
    </div>
    <div class="actions" n:if="$ready">
        <form method="post" action="{$base}/admin/subjects/import"
              onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='กำลังนำเข้า…'">
            <input type="hidden" name="_token" value="{$csrf}">
            <button type="submit" class="btn" n:attr="disabled: !$files" title="อ่านไฟล์ใน database/data แล้วเพิ่ม/ปรับปรุงรายวิชาในฐานข้อมูล">
                <span class="msi" aria-hidden="true">sync</span>นำเข้า/ปรับปรุงจากไฟล์
            </button>
        </form>
    </div>
</div>

{if !$ready}
    <div class="empty">
        <h3>ยังไม่มีตารางคลังรายวิชา</h3>
        <p>รัน migration <code>000138</code> ที่หน้า <a href="{$base}/admin/migrations">ฐานข้อมูล</a> ก่อน แล้วระบบจะนำเข้ารายวิชาจากไฟล์ในโปรเจกต์ให้อัตโนมัติ</p>
    </div>
{else}
    <div class="metric-grid subj-metrics">
        <div class="metric metric-indigo">
            <div class="metric-top"><div class="metric-icon"><span class="msi">library_books</span></div></div>
            <div class="metric-label">รายวิชาทั้งหมด</div>
            <div class="metric-value">{number_format($stats['count'])}</div>
            <div class="hint">
                {foreach $stats['years'] as $y => $n}หลักสูตร {$y}: {number_format($n)}{sep} · {/sep}{/foreach}
                {if !$stats['years']}ยังไม่มีข้อมูล{/if}
            </div>
        </div>
        <div class="metric metric-amber">
            <div class="metric-top"><div class="metric-icon"><span class="msi">description</span></div></div>
            <div class="metric-label">ยังไม่มีคำอธิบายรายวิชา</div>
            <div class="metric-value">{number_format($gaps['description'])}</div>
            <div class="hint">จุดประสงค์ขาด {number_format($gaps['objectives'])} · สมรรถนะขาด {number_format($gaps['competencies'])}</div>
        </div>
        <div class="metric metric-emerald">
            <div class="metric-top"><div class="metric-icon"><span class="msi">sync</span></div></div>
            <div class="metric-label">นำเข้าล่าสุด</div>
            <div class="metric-value" style="font-size: 20px">{$stats['imported_at'] ? date('j/n/Y H:i', strtotime($stats['imported_at'])) : '—'}</div>
            <div class="hint">{if $files}ไฟล์: {implode(', ', $files)}{else}ไม่พบไฟล์ใน database/data{/if}</div>
        </div>
    </div>

    {include '../_partials/subject-catalog.latte', catalogUrl: '/admin/subjects', adminView: true,
        rows: $rows, total: $total, pages: $pages, pageNo: $pageNo, filters: $filters, qs: $qs, qsNoPage: $qsNoPage,
        show: $show, years: $stats['years'], count: $stats['count']}
{/if}
{/block}
