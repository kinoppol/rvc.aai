{layout '../layout.latte'}

{block title}{$unit['title']}{/block}

{block content}
<div class="form-page">
    <a class="back-link" href="{$base}/admin/courses/{$course['id']}">← กลับไปที่ {$course['name']}</a>

    <div class="page-head" style="margin-top:10px">
        <div>
            <h1>{$unit['title']}</h1>
            <div class="sub">
                <span class="mono">{$course['code']}</span> · ตรวจสอบอย่างเดียว การแก้ไขและการเผยแพร่เป็นสิทธิ์ของครูเจ้าของรายวิชา
            </div>
        </div>
        <div class="actions">
            {if $unit['review_status'] === 'published'}<span class="chip chip-ok">เผยแพร่แล้ว</span>
            {elseif $unit['review_status'] === 'pending'}<span class="chip chip-warn">รอตรวจ</span>
            {else}<span class="chip chip-muted">ฉบับร่าง</span>{/if}
        </div>
    </div>

    {if $unit['key_content'] || $unit['objectives'] || $unit['competencies']}
        <div class="card">
            <h2 style="font:600 15px/1.4 var(--sans);margin-bottom:12px">บทนำ</h2>
            {if $unit['key_content']}
                <div style="margin-bottom:10px">
                    <div style="font-size:13px;font-weight:600;color:var(--ink2);margin-bottom:4px">สาระสำคัญ</div>
                    <div style="white-space:pre-line;line-height:1.7">{$unit['key_content']}</div>
                </div>
            {/if}
            {if $unit['objectives']}
                <div style="margin-bottom:10px">
                    <div style="font-size:13px;font-weight:600;color:var(--ink2);margin-bottom:4px">จุดประสงค์การเรียนรู้</div>
                    <div style="white-space:pre-line;line-height:1.7">{$unit['objectives']}</div>
                </div>
            {/if}
            {if $unit['competencies']}
                <div>
                    <div style="font-size:13px;font-weight:600;color:var(--ink2);margin-bottom:4px">สมรรถนะ</div>
                    <div style="white-space:pre-line;line-height:1.7">{$unit['competencies']}</div>
                </div>
            {/if}
        </div>
    {/if}

    {foreach $sections as $s}
        <div class="card">
            <div style="font-weight:600;margin-bottom:10px">{$s['title']}</div>
            {if $s['type'] === 'text'}
                <div style="white-space:pre-line;line-height:1.8">{$s['content']}</div>
            {elseif $s['type'] === 'video'}
                <div style="aspect-ratio:16/9;background:#000;border-radius:8px;overflow:hidden">
                    <iframe src="{$s['video_url']}" style="width:100%;height:100%;border:0" allowfullscreen loading="lazy"></iframe>
                </div>
            {elseif $s['type'] === 'pdf'}
                <div style="display:flex;align-items:center;gap:10px;padding:10px;background:var(--surface2);border-radius:8px">
                    <span style="font-size:22px">📄</span>
                    <span style="font-size:14px">{$s['file_name'] ?? 'ไฟล์ PDF'}</span>
                </div>
            {/if}
        </div>
    {/foreach}

    {if !$sections && !$unit['key_content'] && !$unit['objectives']}
        <div class="empty"><h3>หน่วยนี้ยังไม่มีเนื้อหา</h3></div>
    {/if}
</div>
{/block}
