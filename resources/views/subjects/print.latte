{*
    ใบข้อมูลรายวิชา (A4) จากคลังรายวิชา สอศ. — รูปแบบเดียวกับ "พิมพ์ข้อมูลรายละเอียดวิชา" ของระบบ ศธ.02
    หน้าเดี่ยว ไม่ใช้ layout.latte · ฟอนต์ TH Sarabun New (ในเครื่อง หรือ public/assets/fonts) สำรองด้วย Sarabun
*}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{$subject['code']} {$subject['name_th']}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;700&display=swap">
    <style>
        @font-face {
            font-family: 'SubjSarabun';
            font-weight: 400;
            src: local('TH Sarabun New'), local('THSarabunNew'),
                 url('{$base}/assets/fonts/THSarabunNew.ttf') format('truetype');
        }
        @font-face {
            font-family: 'SubjSarabun';
            font-weight: 700;
            src: local('TH Sarabun New Bold'), local('THSarabunNew-Bold'), local('THSarabunNew Bold'),
                 url('{$base}/assets/fonts/THSarabunNew-Bold.ttf') format('truetype');
        }
        @page { size: A4; margin: 2cm 2cm 2cm 2.5cm; }
        * { box-sizing: border-box; }
        html { background: #e9e9e6; }
        body {
            margin: 0;
            font-family: 'SubjSarabun', 'TH Sarabun New', 'THSarabunNew', 'Sarabun', sans-serif;
            font-size: 15pt;
            line-height: 1.3;
            color: #000;
        }
        .toolbar {
            position: sticky; top: 0; z-index: 5;
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
            padding: 10px 20px; background: rgba(255,255,255,.94);
            border-bottom: 1px solid #e3e3e8; box-shadow: 0 1px 12px rgba(20,20,40,.05);
            font-family: 'Sarabun', sans-serif; font-size: 14px; line-height: 1.4;
        }
        .toolbar .grow { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #555; }
        .toolbar a, .toolbar button {
            font: inherit; color: #1d1d27; text-decoration: none; cursor: pointer;
            padding: 7px 14px; border-radius: 10px; border: 1px solid #d9d9e0; background: #fff;
        }
        .toolbar .primary { background: #4f46e5; border-color: #4f46e5; color: #fff; font-weight: 600; }
        .sheet {
            width: 21cm; min-height: 29.7cm; margin: 24px auto; padding: 2cm 2cm 2cm 2.5cm;
            background: #fff; box-shadow: 0 2px 18px rgba(0,0,0,.12);
        }
        .meta { border-collapse: collapse; margin-bottom: 6pt; }
        .meta th, .meta td { padding: 2pt 0; vertical-align: top; text-align: left; font-weight: 700; }
        .meta th { width: 4.6cm; }
        h2 { font-size: 15pt; margin: 6pt 0 0; }
        h2 small { font-size: inherit; font-weight: 400; }
        ol, .para { margin: 0; padding-left: 2.6cm; font-size: 13.5pt; }
        ol { list-style: none; }
        ol li { text-indent: 0; }
        .para { white-space: pre-wrap; }
        .none { color: #777; }
        @media screen and (max-width: 22cm) {
            .sheet { width: auto; min-height: 0; margin: 12px; padding: 1.2cm 1cm; }
            ol, .para { padding-left: 1.2cm; }
        }
        @media print {
            html { background: none; }
            .toolbar { display: none; }
            .sheet { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <a href="{$base}/subjects?show={$subject['id']}#detail">← คลังรายวิชา</a>
        <span class="grow">{$subject['code']} {$subject['name_th']}</span>
        <button type="button" class="primary" onclick="window.print()">พิมพ์ใบข้อมูลรายวิชา</button>
    </div>

    <main class="sheet">
        <table class="meta">
            <tr><th>รหัสวิชา</th><td>{$subject['code']}</td></tr>
            <tr><th>กลุ่มสาระการเรียนรู้</th><td>{$subject['learning_area']}</td></tr>
            <tr><th>ชื่อวิชา (ไทย)</th><td>{$subject['name_th']}</td></tr>
            <tr><th>ชื่อวิชา (อังกฤษ)</th><td>{$subject['name_en'] ?: '-'}</td></tr>
            <tr><th>หน่วยกิต (ท-ป-น)</th><td>{$subject['theory_hours']}-{$subject['practice_hours']}-{$subject['credits'] + 0}</td></tr>
        </table>

        <h2>จุดประสงค์รายวิชา <small>เพื่อให้</small></h2>
        {if $objectives}
            <ol>{foreach $objectives as $line}<li>{$line}</li>{/foreach}</ol>
        {else}
            <p class="para none">-</p>
        {/if}

        <h2>สมรรถนะรายวิชา</h2>
        {if $competencies}
            <ol>{foreach $competencies as $line}<li>{$line}</li>{/foreach}</ol>
        {else}
            <p class="para none">-</p>
        {/if}

        <h2>คำอธิบายรายวิชา</h2>
        <p n:class="para, !$subject['description'] ? none">{$subject['description'] ?: '-'}</p>
    </main>
    <script n:syntax="off">
        /* ไม่มี TH Sarabun New ในเครื่องและโหลดไฟล์ไม่ได้ → ใช้ Sarabun จาก Google ซึ่งตัวใหญ่กว่า ลดขนาดลง */
        if (document.fonts && document.fonts.load) {
            document.fonts.load('15pt SubjSarabun', 'ก').then(function (faces) {
                if (!faces.length) { document.body.style.fontSize = '12pt'; }
            }).catch(function () { /* เบราว์เซอร์ไม่รองรับ — ปล่อยไว้ */ });
        }
    </script>
</body>
</html>
