{layout '../layout.latte'}

{block title}{$manual ? 'แก้ไขแบบทดสอบ' : 'ตรวจร่างข้อสอบ'}{/block}

{* หน้าแก้ไขแบบทดสอบ (ทั้งร่างจาก AI และที่ครูสร้างเอง): เพิ่ม/ลบ/สลับข้อ แก้คำถาม ตัวเลือก เฉลย และคะแนน
   ข้อสอบทั้งชุดถูกส่งไปในฟอร์มเดียว (payload + sync=1) — ตัวแก้ไขอยู่ใน public/assets/js/quiz-editor.js *}
{block content}
{var $published = $quiz['review_status'] === 'published'}
<div class="wizard-page mid" id="reviewRoot"
     data-base="{$base}" data-course="{$course['id']}" data-quiz="{$quiz['id']}" data-token="{$csrf}"
     data-regen="{$aiOn && $attemptCount === 0 ? 1 : 0}"
     data-editor="{json_encode($editorData, \JSON_UNESCAPED_UNICODE)}">

    <a class="back-link" href="{$base}/courses/{$course['id']}{$quiz['unit_id'] ? '/units/' . $quiz['unit_id'] . '/edit' : '?tab=quizzes'}">← กลับ</a>
    <div class="review-head">
        <div class="grow">
            <h1>{$quiz['title']}</h1>
            <div class="sub">
                {$manual ? 'สร้าง' : 'ร่าง'}{$createdAgo} · <span id="qCount">{count($questions)}</span> ข้อ ·
                {if $published}เผยแพร่ให้นักเรียนแล้ว{else}ยังไม่เผยแพร่ให้นักเรียน{/if}
            </div>
        </div>
        <span class="ai-chip">{$aiChip}</span>
    </div>

    {if !$manual && !$published}
        <div class="alert alert-warning review-warn">
            <div class="warn-mark">!</div>
            <div class="grow">
                <strong>เนื้อหานี้สร้างโดย AI กรุณาตรวจสอบความถูกต้องก่อนเผยแพร่</strong><br>
                แก้คำถาม ตัวเลือก เฉลย และคะแนนได้ในหน้านี้ เพิ่มหรือลบข้อได้เอง ยังไม่มีนักเรียนคนใดเห็นร่างนี้
            </div>
            <span class="tag tag-warn">สถานะ: รอครูตรวจ</span>
        </div>
    {/if}
    {if $attemptCount > 0}
        <div class="alert alert-info" style="margin-top:12px">
            <span class="msi" aria-hidden="true">info</span>
            <div>มีนักเรียนส่งแบบทดสอบนี้แล้ว {$attemptCount} คน — ถ้าเปลี่ยนเฉลยหรือคะแนน ระบบจะคิดคะแนนข้อปรนัยของทุกคนใหม่ให้ตอนบันทึก</div>
        </div>
    {/if}

    <div class="qe-meta">
        <div class="field grow">
            <label for="quizTitle">ชื่อแบบทดสอบ</label>
            <input class="input" type="text" id="quizTitle" value="{$quiz['title']}" maxlength="180">
        </div>
        <div class="field qe-time">
            <label for="quizTime">เวลาทำ (นาที)</label>
            <input class="input" type="number" id="quizTime" min="0" max="600" placeholder="ไม่จำกัด" value="{$quiz['time_limit_minutes']}">
        </div>
    </div>

    <div id="questionList"></div>

    <div class="qe-add">
        <button type="button" class="btn" data-add="choice"><span class="msi" aria-hidden="true">add</span>เพิ่มข้อปรนัย</button>
        <button type="button" class="btn" data-add="short_answer"><span class="msi" aria-hidden="true">add</span>เพิ่มข้ออัตนัย</button>
        <span class="hint">ปรนัยตรวจให้อัตโนมัติ · อัตนัยครูให้คะแนนเอง</span>
    </div>

    <form method="post" action="{$base}/courses/{$course['id']}/quizzes/{$quiz['id']}" class="review-footer" id="saveForm">
        <input type="hidden" name="_token" value="{$csrf}">
        <input type="hidden" name="sync" value="1">
        <input type="hidden" name="payload" id="payloadField">
        <input type="hidden" name="title" id="titleField">
        <input type="hidden" name="time_limit" id="timeField">
        <div class="grow hint" id="footHint"></div>
        {if $regenQuery}
            <a class="btn" href="{$base}/courses/{$course['id']}/quizzes/workspace?{$regenQuery|noescape}">ให้ AI ร่างใหม่ทั้งชุด</a>
        {/if}
        <button type="submit" name="action" value="draft" class="btn">{$published ? 'ซ่อนจากนักเรียน (เก็บเป็นร่าง)' : 'เก็บเป็นร่างไว้ก่อน'}</button>
        <button type="submit" name="action" value="publish" class="btn btn-primary">{$published ? 'บันทึกการแก้ไข' : 'ยืนยันและเผยแพร่'}</button>
    </form>
</div>
<script src="{$base}/assets/js/quiz-editor.js?v={$assetVer}"></script>
{/block}
