<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{block title}{/block} · {$appName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=Noto+Sans+Thai:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500&display=swap">
    {* ไอคอน Material Symbols เฉพาะชื่อที่ใช้จริง (icon_names ต้องเรียงตามตัวอักษร) — display=block กันชื่อไอคอนโผล่เป็นตัวหนังสือระหว่างโหลด *}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..24,400,0..1,0&icon_names=admin_panel_settings,arrow_back,arrow_forward,article,assignment,attach_file,auto_awesome,calendar_month,casino,celebration,check,chevron_right,class,close,co_present,construction,dark_mode,dashboard,data_usage,database,delete,delete_forever,description,download,edit,edit_note,emoji_events,expand_more,fact_check,flag,folder_open,forum,fullscreen,fullscreen_exit,grade,group,home,image,info,leaderboard,library_books,light_mode,logout,manage_accounts,memory,menu,music_note,notifications,notifications_active,open_in_new,palette,pause,picture_as_pdf,pin,play_arrow,print,qr_code_2,quiz,record_voice_over,report,restart_alt,restore_from_trash,schedule,school,search,send,settings,smart_display,smart_toy,speed,sync,sync_alt,task_alt,timer,trending_up,undo,visibility,volume_up,waving_hand&display=block">
    <link rel="stylesheet" href="{$base}/assets/css/app.css?v={$assetVer ?? 1}">
    {if isset($ui)}
        {* สีหลักที่ผู้ดูแลหรือครูเลือกไว้ — เขียน # ในเทมเพลตเอง เพราะ Latte จะ escape # ใน CSS *}
        <style>
            :root {
                --brand: #{$ui['brand']};
                --brandInk: #{$ui['brandInk']};
                --brandSoft: #{$ui['brandSoft']};
                --brandLine: #{$ui['brandLine']};
                --violet: #{$ui['accent']};
                --bgGradient: linear-gradient(-45deg, #{$ui['bg'][0]}, #{$ui['bg'][1]}, #{$ui['bg'][2]}, #{$ui['bg'][3]});
            }
            :root[data-theme="dark"] {
                --brand: #{$ui['darkBrand']};
                --brandInk: #{$ui['darkInk']};
                --brandSoft: #{$ui['darkSoft']};
                --brandLine: #{$ui['darkLine']};
                --violet: #{$ui['darkAccent']};
                --bgGradient: linear-gradient(-45deg, #{$ui['darkBg'][0]}, #{$ui['darkBg'][1]}, #{$ui['darkBg'][2]}, #{$ui['darkBg'][3]});
            }
        </style>
    {/if}
    <script>
        (function () {
            var saved = null, folded = null;
            try { saved = localStorage.getItem('rvc-theme'); folded = localStorage.getItem('rvc-nav'); } catch (e) {}
            if (saved) { document.documentElement.setAttribute('data-theme', saved); }
            // ย่อเมนูข้างเหลือแต่ไอคอน (จำไว้ข้ามหน้า) — ตั้งก่อนวาดหน้าเพื่อไม่ให้เมนูกระพริบ
            if (folded === 'mini') { document.documentElement.classList.add('nav-mini'); }
        })();
    </script>
</head>
<body>
{var $role = $user['role'] ?? 'student'}
{var $rc = $reviewCount ?? 0}
{* ViewContext บอกมาว่าใช้งานฝั่งครูได้ไหม (รวมผู้ดูแลระบบที่ได้รับแต่งตั้งให้สอนด้วย) *}
{var $teaches = $userTeaches ?? ($role === 'teacher' || $role === 'supervisor')}
{var $oversees = $role === 'admin' || $role === 'supervisor'}
{var $roleName = $roleLabel ?? ($role === 'admin' ? 'ผู้ดูแลระบบ' : ($role === 'teacher' ? 'ครูผู้สอน' : 'นักเรียน'))}
<div class="app">
    {if isset($impersonatedBy) && $impersonatedBy}
        <div class="impersonate-bar">
            <span>กำลังใช้งานในนาม <strong>{$user['full_name'] ?? 'ผู้ใช้'}</strong> ({$roleName}) · สวมสิทธิ์โดย {$impersonatedBy}</span>
            <form method="post" action="{$base}/impersonate/stop">
                <input type="hidden" name="_token" value="{$csrf}">
                <button type="submit">กลับเป็นผู้ดูแล</button>
            </form>
        </div>
    {/if}
    {* ปุ่มลัดบนแถบเครื่องมือ — ชี้ไปหน้าที่มีอยู่แล้วตามบทบาท *}
    {var $bellUrl = $teaches ? '/review' : ($role === 'admin' ? '/admin/users' : '/learn')}
    {var $bellTitle = $teaches ? 'รอตรวจก่อนเผยแพร่' : ($role === 'admin' ? 'ผู้ใช้งานและคำขอสมัคร' : 'วิชาที่เรียน')}
    {var $gearUrl = $teaches ? '/settings/ai' : ($role === 'admin' ? '/admin/settings' : '/settings/appearance')}
    {var $gearTitle = $teaches ? 'ผู้ช่วย AI ของฉัน' : ($role === 'admin' ? 'ตั้งค่าระบบ' : 'สีหลักของหน้าจอ')}

    <div class="shell">
        <div class="nav-scrim" id="navScrim" hidden></div>
        <nav class="sidebar" id="sideNav">
            <a href="{$base}/" class="side-brand" title="{$appName}">
                <div class="brand-mark"><span class="msi">school</span></div>
                <div class="brand-name">{$appName}</div>
            </a>

            {*
                เมนูจัดเป็นกลุ่มยุบ/ขยายได้ — กลุ่มที่มีหน้าปัจจุบันเปิดเสมอ
                กลุ่มอื่นจำสถานะไว้ใน localStorage (rvc-nav-groups) สคริปต์ท้ายเมนูตั้งค่าก่อนวาดหน้า
            *}
            {*
                ผู้ดูแลระบบที่สอนด้วยมีเมนูสองชุด — แยกเป็นโหมด "ครู" กับ "ผู้ดูแลระบบ" แสดงทีละชุด
                โหมดเริ่มต้นตามหน้าที่เปิดอยู่ (หน้า /admin/* = ผู้ดูแลระบบ) ปุ่มสลับเปลี่ยนแค่เมนู ไม่เปลี่ยนหน้า
            *}
            {var $dual = $role === 'admin' && $teaches}
            {var $systemHere = $role === 'admin' && in_array($page, ['admin-overview', 'admin-settings', 'appearance', 'admin-ai', 'admin-rms', 'migrations', 'admin-logs'], true)}
            {var $navMode = $dual && (str_starts_with((string) $page, 'admin') || in_array($page, ['migrations', 'appearance'], true)) ? 'admin' : 'teach'}
            {if $dual}
                <div class="nav-mode-switch" role="tablist" aria-label="ชุดเมนู">
                    <button type="button" role="tab" data-nav-mode="teach" n:class="$navMode === 'teach' ? is-on" aria-selected="{$navMode === 'teach' ? 'true' : 'false'}" title="เมนูครู">
                        <span class="msi">co_present</span><span class="nav-label">ครู</span>
                    </button>
                    <button type="button" role="tab" data-nav-mode="admin" n:class="$navMode === 'admin' ? is-on" aria-selected="{$navMode === 'admin' ? 'true' : 'false'}" title="เมนูผู้ดูแลระบบ">
                        <span class="msi">admin_panel_settings</span><span class="nav-label">ผู้ดูแลระบบ</span>
                    </button>
                </div>
            {/if}
            <div class="side-nav" id="sideNavList" data-mode="{$dual ? $navMode : 'all'}">
                <a href="{$base}/dashboard" n:class="$page === 'dashboard' ? is-active" title="หน้าแรก"><span class="msi">home</span><span class="nav-label">หน้าแรก</span></a>

                <div class="nav-set" data-set="teach">
                {if $teaches}
                    <a href="{$base}/courses" n:class="$page === 'courses' ? is-active" title="รายวิชาของฉัน"><span class="msi">class</span><span class="nav-label">รายวิชาของฉัน</span></a>
                    <a href="{$base}/students" n:class="$page === 'students' ? is-active" title="นักเรียนของฉัน"><span class="msi">group</span><span class="nav-label">นักเรียนของฉัน</span></a>
                    <a href="{$base}/review" n:class="$page === 'review' ? is-active" title="รอตรวจก่อนเผยแพร่">
                        <span class="msi">fact_check</span><span class="nav-label">รอตรวจก่อนเผยแพร่</span>
                        {if $rc > 0}<span class="nav-badge">{$rc}</span>{/if}
                    </a>
                    <a href="{$base}/board" n:class="$page === 'board' ? is-active" title="กระดานสนทนา"><span class="msi">forum</span><span class="nav-label">กระดานสนทนา</span></a>
                    <a href="{$base}/trash" n:class="$page === 'trash' ? is-active" title="ถังขยะ"><span class="msi">delete</span><span class="nav-label">ถังขยะ</span></a>
                    {* หัวหน้างานพัฒนาหลักสูตร (ครูที่ผู้ดูแลระบบแต่งตั้ง) · ผู้ดูแลครู/ผู้ดูแลระบบเห็นลิงก์นี้ในกลุ่มงานกำกับดูแลแทน *}
                    {if ($reviewsPlans ?? false) && !$oversees}
                        <a href="{$base}/plans" n:class="$page === 'plan-review' ? is-active" title="ตรวจแผนการสอน"><span class="msi">assignment</span><span class="nav-label">ตรวจแผนการสอน</span></a>
                    {/if}
                {/if}

                {if $role === 'student'}
                    <a href="{$base}/learn" n:class="$page === 'learn' ? is-active" title="วิชาที่เรียน"><span class="msi">school</span><span class="nav-label">วิชาที่เรียน</span></a>
                {/if}
                {if $teaches}
                {var $here = in_array($page, $role === 'admin' ? ['settings'] : ['settings', 'appearance'], true)}
                <div n:class="nav-group, $here ? is-here" data-group="mine">
                    <button type="button" class="group-label" aria-expanded="true">
                        <span class="grow">ตั้งค่าของฉัน</span><span class="msi">expand_more</span>
                    </button>
                    <div class="nav-group-items">
                        <a href="{$base}/settings/ai" n:class="$page === 'settings' ? is-active" title="ผู้ช่วย AI ของฉัน"><span class="msi">auto_awesome</span><span class="nav-label">ผู้ช่วย AI ของฉัน</span></a>
                        {if $role !== 'admin'}<a href="{$base}/settings/appearance" n:class="$page === 'appearance' ? is-active" title="สีหลักของหน้าจอ"><span class="msi">palette</span><span class="nav-label">สีหลักของหน้าจอ</span></a>{/if}
                    </div>
                </div>
                {/if}
                </div>

                <div class="nav-set" data-set="admin">
                {if $oversees}
                    {var $here = in_array($page, ['admin-users', 'admin-courses', 'plan-review'], true)}
                    <div n:class="nav-group, $here ? is-here" data-group="oversee">
                        <button type="button" class="group-label" aria-expanded="true">
                            <span class="grow">งานกำกับดูแล</span><span class="msi">expand_more</span>
                        </button>
                        <div class="nav-group-items">
                            <a href="{$base}/admin/users" n:class="$page === 'admin-users' ? is-active" title="ผู้ใช้งาน"><span class="msi">manage_accounts</span><span class="nav-label">ผู้ใช้งาน</span></a>
                            <a href="{$base}/admin/courses" n:class="$page === 'admin-courses' ? is-active" title="รายวิชาทั้งระบบ"><span class="msi">library_books</span><span class="nav-label">รายวิชาทั้งระบบ</span></a>
                            <a href="{$base}/plans" n:class="$page === 'plan-review' ? is-active" title="ตรวจแผนการสอน"><span class="msi">assignment</span><span class="nav-label">ตรวจแผนการสอน</span></a>
                        </div>
                    </div>
                {/if}

                {if $role === 'admin'}
                    {* ทุกหน้าของผู้ดูแลระบบรวมอยู่ใต้ "ตั้งค่าระบบ" แยกเป็นแท็บใน _partials/system-tabs.latte
                       data-keywords ให้ช่องค้นหาเมนูยังหาแท็บย่อยเจอ *}
                    <a href="{$base}/admin/settings" n:class="$systemHere ? is-active" title="ตั้งค่าระบบ"
                       data-keywords="ภาพรวมระบบ สีของระบบ สีหลักของหน้าจอ เครื่อง AI โควตา โอนข้อมูล RMS ฐานข้อมูล migration บันทึกข้อขัดข้อง log วิธีเข้าสู่ระบบ SSO RVC-ONE"><span class="msi">settings</span><span class="nav-label">ตั้งค่าระบบ</span></a>
                {/if}
                </div>
            </div>
            <script n:syntax="off">
                /* ตั้งสถานะยุบ/ขยายของกลุ่มเมนูก่อนวาดหน้า — ค่าเริ่มต้นคือยุบ ยกเว้นกลุ่มที่มีหน้าปัจจุบัน */
                (function () {
                    var saved = {};
                    try { saved = JSON.parse(localStorage.getItem('rvc-nav-groups') || '{}') || {}; } catch (e) {}
                    document.querySelectorAll('#sideNavList .nav-group').forEach(function (g) {
                        var open = g.classList.contains('is-here') || saved[g.dataset.group] === true;
                        g.classList.toggle('is-collapsed', !open);
                        g.querySelector('.group-label').setAttribute('aria-expanded', open ? 'true' : 'false');
                    });
                })();
            </script>

            <div class="spacer"></div>

            {* การ์ดบัญชีผู้ใช้ท้ายเมนู *}
            <div class="side-profile">
                <div class="side-profile-top">
                    <div class="avatar">{mb_substr($user['full_name'] ?? '?', 0, 1)}</div>
                    <div class="side-profile-who">
                        <div class="profile-name">{$user['full_name'] ?? 'ผู้ใช้'}</div>
                        <div class="profile-role">{$roleName}</div>
                    </div>
                </div>
                <div class="side-profile-meta">{$college}{if ($term ?? '') !== ''} · {$term}{/if}</div>
                <div class="side-profile-btns">
                    <form method="post" action="{$base}/{isset($impersonatedBy) && $impersonatedBy ? 'impersonate/stop' : 'logout'}">
                        <input type="hidden" name="_token" value="{$csrf}">
                        <button type="submit" class="btn btn-sm"><span class="msi">logout</span>{isset($impersonatedBy) && $impersonatedBy ? 'กลับเป็นผู้ดูแล' : 'ออกจากระบบ'}</button>
                    </form>
                </div>
            </div>
        </nav>

        <div class="main">
            <header class="topbar">
                <button type="button" class="tool-btn nav-toggle" id="navToggle" aria-label="เปิด/ย่อเมนู" aria-controls="sideNav">
                    <span class="msi">menu</span>
                </button>
                <nav class="crumbs" aria-label="ตำแหน่งปัจจุบัน">
                    <a href="{$base}/dashboard" title="หน้าแรก"><span class="msi">home</span></a>
                    <span class="msi crumb-sep">chevron_right</span>
                    <span class="crumb-here">{include title}</span>
                </nav>
                <div class="topbar-spacer"></div>
                {* ค้นหาเมนู — พิมพ์แล้วกรองเมนูข้าง กด Enter เพื่อไปหน้าแรกที่ตรง *}
                <label class="tool-search">
                    <span class="msi">search</span>
                    <input type="search" id="navSearch" placeholder="ค้นหาเมนู…" autocomplete="off" aria-label="ค้นหาเมนู">
                </label>
                <a class="tool-btn" href="{$base}{$bellUrl}" title="{$bellTitle}">
                    <span class="msi">notifications</span>
                    {if $teaches && $rc > 0}<span class="tool-badge">{$rc}</span>{/if}
                </a>
                <a class="tool-btn" href="{$base}{$gearUrl}" title="{$gearTitle}"><span class="msi">settings</span></a>
                <button type="button" class="tool-btn" onclick="rvcToggleTheme()" title="สลับโหมดมืด/สว่าง" aria-label="สลับโหมดมืด/สว่าง">
                    <span class="msi" id="themeIcon">dark_mode</span>
                </button>
            </header>

            <main class="content">
                {foreach $flash as $message}
                    <div class="alert alert-{$message['type']}">{$message['message']}</div>
                {/foreach}

                {include content}
            </main>
        </div>
    </div>

    <nav class="mobile-nav">
        <a href="{$base}/dashboard" n:class="$page === 'dashboard' ? is-active"><span class="msi">home</span>หน้าแรก</a>
        {if $teaches}
            <a href="{$base}/courses" n:class="$page === 'courses' ? is-active"><span class="msi">class</span>รายวิชา</a>
            <a href="{$base}/review" n:class="$page === 'review' ? is-active">
                <span class="msi">fact_check{if $rc > 0}<i class="mobile-badge">{$rc}</i>{/if}</span>รอตรวจ
            </a>
            {if $oversees}
                <a href="{$base}/admin/courses" n:class="$page === 'admin-courses' ? is-active"><span class="msi">library_books</span>ทั้งระบบ</a>
            {else}
                <a href="{$base}/board" n:class="$page === 'board' ? is-active"><span class="msi">forum</span>สนทนา</a>
            {/if}
        {elseif $role === 'student'}
            <a href="{$base}/learn" n:class="$page === 'learn' ? is-active"><span class="msi">school</span>วิชาที่เรียน</a>
        {else}
            <a href="{$base}/admin/settings" n:class="$systemHere ? is-active"><span class="msi">settings</span>ตั้งค่าระบบ</a>
            <a href="{$base}/admin/users" n:class="$page === 'admin-users' ? is-active"><span class="msi">manage_accounts</span>ผู้ใช้</a>
        {/if}
    </nav>
</div>

{include '_partials/confirm.latte'}
<script src="{$base}/assets/js/ui.js?v={$assetVer ?? 1}" defer></script>
<script src="{$base}/assets/js/combo.js" defer></script>

{if $role !== 'student'}
    {include '_partials/ai-chat.latte'}
{/if}

{if isset($toast) && $toast}
    <div class="toast" id="rvcToast">{$toast}</div>
{/if}

<script>
    function rvcThemeLabels() {
        var dark = document.documentElement.getAttribute('data-theme') === 'dark';
        document.getElementById('themeIcon').textContent = dark ? 'light_mode' : 'dark_mode';
    }
    function rvcToggleTheme() {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'dark' ? '' : 'dark';
        if (next) { root.setAttribute('data-theme', next); } else { root.removeAttribute('data-theme'); }
        try { localStorage.setItem('rvc-theme', next); } catch (e) {}
        rvcThemeLabels();
    }
    rvcThemeLabels();

    /* เมนูแฮมเบอร์เกอร์: จอกว้างย่อ/ขยายเมนูข้าง (จำไว้) · จอมือถือเปิดเป็นลิ้นชักทับหน้า */
    (function () {
        var root = document.documentElement;
        var scrim = document.getElementById('navScrim');
        var mobile = window.matchMedia('(max-width: 860px)');

        function setDrawer(on) {
            root.classList.toggle('nav-open', on);
            scrim.hidden = !on;
        }

        document.getElementById('navToggle').addEventListener('click', function () {
            if (mobile.matches) { setDrawer(!root.classList.contains('nav-open')); return; }
            var mini = root.classList.toggle('nav-mini');
            try { localStorage.setItem('rvc-nav', mini ? 'mini' : ''); } catch (e) {}
        });
        scrim.addEventListener('click', function () { setDrawer(false); });
        mobile.addEventListener('change', function () { setDrawer(false); });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { setDrawer(false); }
        });

        /* ค้นหาเมนู: กรองลิงก์ในเมนูข้างตามคำที่พิมพ์ · Enter = ไปหน้าแรกที่ตรง */
        var search = document.getElementById('navSearch');
        var links = Array.prototype.slice.call(document.querySelectorAll('#sideNav .side-nav a'));
        var extras = document.querySelectorAll('#sideNav .side-nav .group-label, #sideNav .side-nav .divider');
        var navList = document.getElementById('sideNavList');

        /* ผู้ดูแลระบบที่สอนด้วย: สลับระหว่างเมนูครูกับเมนูผู้ดูแลระบบ (เปลี่ยนแค่เมนู ไม่เปลี่ยนหน้า) */
        Array.prototype.forEach.call(document.querySelectorAll('.nav-mode-switch [data-nav-mode]'), function (btn) {
            btn.addEventListener('click', function () {
                navList.dataset.mode = btn.dataset.navMode;
                Array.prototype.forEach.call(btn.parentNode.children, function (b) {
                    b.classList.toggle('is-on', b === btn);
                    b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
                });
            });
        });

        /* ยุบ/ขยายกลุ่มเมนู แล้วจำไว้ข้ามหน้า */
        navList.addEventListener('click', function (e) {
            var head = e.target.closest('.group-label');
            if (!head) { return; }
            var group = head.parentNode;
            var open = group.classList.toggle('is-collapsed') === false;
            head.setAttribute('aria-expanded', open ? 'true' : 'false');
            var saved = new Object();   // ไม่ใช้วงเล็บปีกกาเปล่า เพราะ Latte อาจตีความเป็นแท็ก
            try { saved = JSON.parse(localStorage.getItem('rvc-nav-groups') || 'null') || saved; } catch (err) {}
            saved[group.dataset.group] = open;
            try { localStorage.setItem('rvc-nav-groups', JSON.stringify(saved)); } catch (err) {}
        });

        function matches() {
            var q = search.value.trim().toLowerCase();
            return links.filter(function (a) {
                var label = a.querySelector('.nav-label');
                var text = (label ? label.textContent : '') + ' ' + (a.dataset.keywords || '');
                return q === '' || text.toLowerCase().indexOf(q) !== -1;
            });
        }
        search.addEventListener('input', function () {
            var hit = matches(), q = search.value.trim();
            links.forEach(function (a) { a.hidden = hit.indexOf(a) === -1; });
            Array.prototype.forEach.call(extras, function (el) { el.hidden = q !== ''; });
            // ระหว่างค้นหา แสดงผลจากทุกกลุ่มแม้กลุ่มนั้นยุบอยู่
            navList.classList.toggle('is-searching', q !== '');
            if (q !== '' && mobile.matches) { setDrawer(true); }
        });
        search.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                var hit = matches();
                if (hit.length) { e.preventDefault(); window.location.href = hit[0].href; }
            } else if (e.key === 'Escape') {
                search.value = '';
                search.dispatchEvent(new Event('input'));
            }
        });
    })();
    (function () {
        var t = document.getElementById('rvcToast');
        if (t) { setTimeout(function () { t.classList.add('is-out'); }, 2600); }
    })();
</script>
</body>
</html>
