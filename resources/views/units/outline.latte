{layout '../layout.latte'}

{block title}ออกแบบหน่วยการเรียนด้วย AI{/block}

{block content}
<div class="form-page">
    <a class="back-link" href="{$base}/courses/{$course['id']}?tab=units">← กลับไปที่ {$course['name']}</a>
    <h1>ออกแบบหน่วยการเรียนด้วย AI</h1>
    <div class="sub">
        ผู้ช่วยจะร่างรายชื่อหน่วยการเรียนให้ครอบคลุมคำอธิบายรายวิชา · ครูเลือกเฉพาะหน่วยที่ต้องการแล้วค่อยบันทึก
    </div>

    <div class="card" style="margin-top:20px">
        <div class="card-sub" style="margin:0">คำอธิบายรายวิชาที่ผู้ช่วยจะใช้เป็นโจทย์</div>
        <div style="margin-top:8px;line-height:1.8">
            {if $course['description']}
                {$course['description']}
            {else}
                <span class="text-muted">ยังไม่ได้กรอกคำอธิบายรายวิชา — ผู้ช่วยจะอนุมานจากชื่อวิชาแทน
                <a href="{$base}/courses/{$course['id']}/edit">เพิ่มคำอธิบายรายวิชา</a> จะได้ผลตรงกว่า</span>
            {/if}
        </div>
        {if $existing}
            <div class="hint" style="margin-top:12px">
                มีหน่วยการเรียนอยู่แล้ว {count($existing)} หน่วย — ผู้ช่วยจะเลี่ยงไม่ให้ซ้ำของเดิม
            </div>
        {/if}
    </div>

    <form method="post" action="{$base}/courses/{$course['id']}/units/design" class="card"
          data-busy="กำลังร่างรายชื่อหน่วย…">
        <input type="hidden" name="_token" value="{$csrf}">

        {* ตารางภาคเรียน: ระบบวางสัปดาห์ของแต่ละหน่วยและสัปดาห์สอบเอง (App\Support\Semester · ตัวอย่างสดใน semester-plan.js) *}
        <div class="semester-box" id="semesterBox"
             data-teaching="{$level['teaching']}" data-included="{$level['examsIncluded'] ? 1 : 0}"
             data-existing="{$existingLessons}" data-weekly="{$weekly}" data-auto="{$weeksSaved ? 0 : 1}">
            <div class="step-label">ตารางภาคเรียน</div>
            <div class="semester-grid">
                <div class="field">
                    <label for="weeks">สัปดาห์เรียนรวมวัดผล</label>
                    <input class="input mono" type="number" id="weeks" name="weeks" min="1" max="30" value="{$weeks}">
                </div>
                <div class="field">
                    <label for="count">จำนวนหน่วยการเรียน{if $existingLessons} (ใหม่){/if}</label>
                    <input class="input mono" type="number" id="count" name="count" min="1" max="20" value="{$count}">
                </div>
                <div class="field semester-exams">
                    <span class="label">การสอบ</span>
                    <label><input type="checkbox" name="midterm" value="1" id="midterm" n:attr="checked: $midterm"> สอบกลางภาค</label>
                    <label><input type="checkbox" name="final" value="1" id="final" n:attr="checked: $final"> สอบปลายภาค</label>
                </div>
            </div>
            <div class="hint">
                {if $level['label']}{$level['label']} · {/if}
                {if $level['examsIncluded']}
                    เรียน {$level['teaching']} สัปดาห์รวมวัดผล สอบปลายภาคสัปดาห์สุดท้าย
                {else}
                    เรียน {$level['teaching']} สัปดาห์ไม่รวมวัดผล สัปดาห์สอบต่อท้าย (สอบปลายภาค = สัปดาห์ที่ {$level['teaching'] + 1})
                {/if}
                · สัปดาห์ละ {$weekly} ชั่วโมง (ท + ป) · มีสอบกลางภาคต้องมีสอบปลายภาคด้วย
                · ระบบวางสอบกลางภาคให้ใกล้กลางภาคเรียนที่สุดตรงรอยต่อของหน่วย
            </div>
            <div class="semester-strip" id="semesterStrip" aria-hidden="true"></div>
            <div class="hint" id="semesterSummary"></div>
        </div>

        <div class="field">
            <label for="note">สั่งเพิ่มเติม (ไม่บังคับ)</label>
            <textarea class="input note-input" id="note" name="note" maxlength="2000" rows="3"
                      placeholder="เช่น เน้นการฝึกปฏิบัติในร้านจำลอง หรือแบ่งตามลำดับงานจริงหน้าร้าน · พิมพ์ได้หลายบรรทัด">{$note}</textarea>
        </div>

        {include '../_partials/ai-picker.latte', options: $ai['options'], chosen: $ai['chosen'], id: 'outlineAi'}

        <button type="submit" class="btn btn-primary">ให้ AI ร่างรายชื่อหน่วย</button>
        <span class="hint" style="margin-left:10px">ปกติใช้เวลา 15–60 วินาที</span>

        <div class="busy-note" data-busy-note hidden>
            <span class="spinner"></span>
            <span>
                ผู้ช่วยกำลังอ่านคำอธิบายรายวิชาแล้วร่างรายชื่อหน่วยให้<span class="busy-dots"></span><br>
                <span class="hint">อย่าปิดหน้านี้ · ผลลัพธ์จะขึ้นให้เลือกด้านล่างเมื่อร่างเสร็จ</span>
            </span>
        </div>
    </form>

    {if $proposed}
        <form method="post" action="{$base}/courses/{$course['id']}/units/design/save" class="card">
            <input type="hidden" name="_token" value="{$csrf}">

            <h2 style="font:600 15px/1.4 var(--sans)">ผู้ช่วยร่างมา {count($proposed)} หน่วย</h2>
            <div class="card-sub">
                ติ๊กหน่วยที่ต้องการ แล้วกดบันทึก · บันทึกเป็นฉบับร่างให้แก้เนื้อหาต่อได้
                · ตาราง {$plan['weeks']} สัปดาห์{if $plan['midterm'] || $plan['final']} ระบบสร้าง/จัดวางหน่วยสอบให้ตอนบันทึก{/if}
                (สัปดาห์ของแต่ละหน่วยแก้ได้ที่หน้าแก้ไขหน่วย)
            </div>

            <div class="list" style="margin-top:6px">
                {var $after = $plan['midtermAfter']}
                {foreach $proposed as $i => $u}
                    {var $g = $existingLessons + $i}
                    {var $slot = $plan['units'][$g] ?? null}
                    {if $after !== null && ($g === $after || ($i === 0 && $after < $existingLessons))}
                        <div class="outline-exam"><span class="msi">fact_check</span> สอบกลางภาค · สัปดาห์ที่ {$plan['midtermWeek']}</div>
                    {/if}
                    <label class="outline-row">
                        <input type="checkbox" name="pick[]" value="{$i}" checked>
                        <span class="outline-no mono">{sprintf('%02d', $g + 1)}</span>
                        <span class="outline-main">
                            <span class="outline-title">{$u['title']}</span>
                            {if $u['key_content']}<span class="outline-sub">{$u['key_content']}</span>{/if}
                            {if $u['objectives']}<span class="outline-sub">จุดประสงค์: {$u['objectives']}</span>{/if}
                            {if $u['competencies']}<span class="outline-sub">สมรรถนะ: {$u['competencies']}</span>{/if}
                        </span>
                        {if $slot}
                            <span class="tag" title="{$slot['weeks']} สัปดาห์ · {$u['hours']} ชั่วโมง">
                                สัปดาห์ {$slot['from']}{if $slot['to'] > $slot['from']}–{$slot['to']}{/if} · {$u['hours']} ชม.
                            </span>
                        {/if}
                    </label>
                {/foreach}
                {if $plan['finalWeek']}
                    <div class="outline-exam"><span class="msi">fact_check</span> สอบปลายภาค · สัปดาห์ที่ {$plan['finalWeek']}</div>
                {/if}
            </div>

            <div class="form-actions" style="margin-top:16px">
                <button type="button" class="btn btn-sm" data-pick="all">เลือกทั้งหมด</button>
                <button type="button" class="btn btn-sm" data-pick="none">ไม่เลือกเลย</button>
                <div class="spacer"></div>
                <button type="submit" class="btn btn-primary">บันทึกเป็นหน่วยฉบับร่าง</button>
            </div>
        </form>

        {* เว้นวรรคหลัง { ทุกจุด เพราะ Latte อ่าน { ที่ติดตัวอักษรเป็นแท็กของตัวเอง *}
        <script>
            document.querySelectorAll('[data-pick]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var on = btn.dataset.pick === 'all';
                    btn.closest('form').querySelectorAll('input[type="checkbox"]').forEach(function (box) {
                        box.checked = on;
                    });
                });
            });
        </script>
    {/if}
</div>
<script src="{$base}/assets/js/semester-plan.js"></script>
{/block}
