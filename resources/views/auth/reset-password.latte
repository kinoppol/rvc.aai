{layout '../public-layout.latte'}

{block title}ตั้งรหัสผ่านใหม่ · {$appName}{/block}

{block content}
<section class="lp-hero lp-auth">
        <svg class="lp-hero-deco d1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="220" height="220"><path d="m12 4 9 4-9 4-9-4 9-4Z"/><path d="M6 11v4c0 1.5 3 3 6 3s6-1.5 6-3v-4"/></svg>
        <svg class="lp-hero-deco d2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="260" height="260"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5Z"/><path d="M4 19a2 2 0 0 1 2-2h13"/></svg>

    <div class="lp-wrap lp-auth-inner lp-auth-single">
        <form class="lp-auth-card" method="post" action="{$base}/reset-password/{$token}">
            <div class="lp-auth-head">
                <span class="lp-logo-mark">RV</span>
                <h2>ตั้งรหัสผ่านใหม่</h2>
                <p>สำหรับ {$fullName}</p>
            </div>

            {foreach $flash as $message}
                <div class="lp-alert lp-alert-{$message['type']}">{$message['message']}</div>
            {/foreach}

            <input type="hidden" name="_token" value="{$csrf}">

            <div class="lp-field">
                <label for="password">รหัสผ่านใหม่</label>
                <input class="lp-input" type="password" id="password" name="password" autocomplete="new-password" minlength="8" required autofocus>
                <div class="lp-hint">อย่างน้อย 8 ตัวอักษร</div>
            </div>

            <div class="lp-field">
                <label for="password_confirm">ยืนยันรหัสผ่านใหม่</label>
                <input class="lp-input" type="password" id="password_confirm" name="password_confirm" autocomplete="new-password" minlength="8" required>
            </div>

            <button type="submit" class="lp-btn lp-btn-solid lp-btn-block">บันทึกรหัสผ่านใหม่</button>
        </form>
    </div>
</section>
{/block}
