{layout '../public-layout.latte'}

{block title}เข้าสู่ระบบ · {$appName}{/block}
{block description}เข้าสู่ระบบ {$appName} ของ{$college}{/block}

{block content}
<section class="lp-hero lp-auth">
        <svg class="lp-hero-deco d1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="220" height="220"><path d="m12 4 9 4-9 4-9-4 9-4Z"/><path d="M6 11v4c0 1.5 3 3 6 3s6-1.5 6-3v-4"/></svg>
        <svg class="lp-hero-deco d2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="260" height="260"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5Z"/><path d="M4 19a2 2 0 0 1 2-2h13"/></svg>

    <div class="lp-wrap lp-auth-inner">
        <div class="lp-auth-copy">
            <div class="lp-eyebrow">{$college}</div>
            <h1>ยินดีต้อนรับสู่<br><span class="lp-accent-text">{$appName}</span></h1>
            <p class="lp-hero-lead">เข้าสู่ระบบเพื่อเรียนบทเรียน ทำใบงานและแบบทดสอบ หรือจัดการรายวิชาของคุณ พร้อมผู้ช่วย AI สนับสนุนการเรียนการสอน</p>
        </div>

        <form class="lp-auth-card" method="post" action="{$base}/login">
            <div class="lp-auth-head">
                <span class="lp-logo-mark">RV</span>
                <h2>เข้าสู่ระบบ</h2>
            </div>

            {foreach $flash as $message}
                <div class="lp-alert lp-alert-{$message['type']}">{$message['message']}</div>
            {/foreach}

            <input type="hidden" name="_token" value="{$csrf}">

            <div class="lp-auth-tabs" role="tablist">
                <label class="lp-auth-tab">
                    <input type="radio" name="as" value="staff" n:attr="checked: $as !== 'student'"
                           onchange="document.getElementById('loginInstitutionField').hidden = true; document.getElementById('username').placeholder = '';">
                    <span>🧑‍🏫</span>ครู / ผู้ดูแลระบบ
                </label>
                <label class="lp-auth-tab">
                    <input type="radio" name="as" value="student" n:attr="checked: $as === 'student'"
                           onchange="document.getElementById('loginInstitutionField').hidden = false; document.getElementById('username').placeholder = 'รหัสนักศึกษา';">
                    <span>🎓</span>นักเรียน
                </label>
            </div>

            <div class="lp-field" id="loginInstitutionField" n:attr="hidden: $as !== 'student'">
                <label for="institution_id">สถานศึกษา</label>
                <select class="lp-input" id="institution_id" name="institution_id">
                    <option value="">— เลือกสถานศึกษา —</option>
                    {foreach $institutions as $inst}
                        <option value="{$inst['id']}" n:attr="selected: (string) $inst['id'] === $institution_id">{$inst['name']}</option>
                    {/foreach}
                </select>
            </div>

            <div class="lp-field">
                <label for="username">ชื่อผู้ใช้</label>
                <input class="lp-input" type="text" id="username" name="username" value="{$username}"
                       placeholder="{$as === 'student' ? 'รหัสนักศึกษา' : ''}" autocomplete="username" autofocus required>
            </div>

            <div class="lp-field">
                <label for="password">รหัสผ่าน</label>
                <input class="lp-input" type="password" id="password" name="password" autocomplete="current-password" required>
                {if $as === 'student'}<div class="lp-hint">สำหรับนักเรียน รหัสผ่านคือเลขประจำตัวประชาชน 13 หลัก</div>{/if}
            </div>

            <button type="submit" class="lp-btn lp-btn-solid lp-btn-block">เข้าสู่ระบบ</button>

            <p class="lp-auth-note">ลืมรหัสผ่าน กรุณาติดต่อครูผู้สอนหรือผู้ดูแลระบบของวิทยาลัย</p>
            <p class="lp-auth-note">เป็นครูและยังไม่มีบัญชี? <a href="{$base}/register">สมัครเข้าใช้ระบบ</a></p>
        </form>
    </div>
</section>
{/block}
