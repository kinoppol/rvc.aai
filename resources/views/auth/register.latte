{layout '../public-layout.latte'}

{block title}สมัครเข้าใช้ระบบสำหรับครู · {$appName}{/block}
{block description}สมัครบัญชีครูผู้สอนของ {$appName} {$college}{/block}

{block content}
<section class="lp-hero lp-auth">
        <svg class="lp-hero-deco d1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="220" height="220"><path d="m12 4 9 4-9 4-9-4 9-4Z"/><path d="M6 11v4c0 1.5 3 3 6 3s6-1.5 6-3v-4"/></svg>
        <svg class="lp-hero-deco d2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="260" height="260"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5Z"/><path d="M4 19a2 2 0 0 1 2-2h13"/></svg>

    <div class="lp-wrap lp-auth-inner lp-auth-single">
        <form class="lp-auth-card lp-auth-wide" method="post" action="{$base}/register" autocomplete="off">
            <div class="lp-auth-head">
                <span class="lp-logo-mark">RV</span>
                <h2>สมัครเข้าใช้ระบบสำหรับครู</h2>
                <p>{$college} · บัญชีจะใช้งานได้หลังผู้ดูแลระบบอนุมัติ</p>
            </div>

            {foreach $flash as $message}
                <div class="lp-alert lp-alert-{$message['type']}">{$message['message']}</div>
            {/foreach}

            <input type="hidden" name="_token" value="{$csrf}">

            <div class="lp-auth-grid">
                <div class="lp-field">
                    <label for="username">ชื่อผู้ใช้</label>
                    <input class="lp-input" type="text" id="username" name="username" value="{$username}"
                           autocomplete="username" placeholder="a-z 0-9 . _ -" required>
                </div>
                <div class="lp-field">
                    <label for="full_name">ชื่อ-สกุล</label>
                    <input class="lp-input" type="text" id="full_name" name="full_name" value="{$full_name}" required>
                </div>

                <div class="lp-field">
                    <label for="email">อีเมล</label>
                    <input class="lp-input" type="email" id="email" name="email" value="{$email}"
                           autocomplete="email" required>
                </div>
                <div class="lp-field">
                    <label for="phone">เบอร์โทรศัพท์ (ถ้ามี)</label>
                    <input class="lp-input" type="tel" id="phone" name="phone" value="{$phone}" autocomplete="tel">
                </div>

                <div class="lp-field">
                    <label for="subject_area">สาขาวิชาที่สอน</label>
                    <input class="lp-input" type="text" id="subject_area" name="subject_area" value="{$subject_area}"
                           placeholder="เช่น ช่างยนต์, การตลาด" required>
                </div>
                <div class="lp-field">
                    <label for="institution_id">สถานศึกษาที่สังกัด</label>
                    <select class="lp-input" id="institution_id" name="institution_id" required
                            onchange="document.getElementById('institution_new_field').hidden = this.value !== '__new__'">
                        <option value="">— เลือกสถานศึกษา —</option>
                        {foreach $institutions as $inst}
                            <option value="{$inst['id']}" n:attr="selected: (string) $inst['id'] === $institution_id">{$inst['name']}</option>
                        {/foreach}
                        <option value="__new__" n:attr="selected: $institution_id === '__new__'">อื่นๆ (ระบุชื่อสถานศึกษาใหม่)</option>
                    </select>
                </div>
                <div class="lp-field" id="institution_new_field" n:attr="hidden: $institution_id !== '__new__'">
                    <label for="institution_new">ชื่อสถานศึกษาใหม่</label>
                    <input class="lp-input" type="text" id="institution_new" name="institution_new" value="{$institution_new}"
                           placeholder="เช่น วิทยาลัยเทคนิคร้อยเอ็ด">
                </div>

                <div class="lp-field">
                    <label for="password">รหัสผ่าน</label>
                    <input class="lp-input" type="password" id="password" name="password"
                           autocomplete="new-password" minlength="8" required>
                    <div class="lp-hint">อย่างน้อย 8 ตัวอักษร มีทั้งตัวอักษรและตัวเลข</div>
                </div>
                <div class="lp-field">
                    <label for="password_confirm">ยืนยันรหัสผ่าน</label>
                    <input class="lp-input" type="password" id="password_confirm" name="password_confirm"
                           autocomplete="new-password" minlength="8" required>
                </div>
            </div>

            <button type="submit" class="lp-btn lp-btn-solid lp-btn-block">ส่งคำขอสมัครสมาชิก</button>

            <p class="lp-auth-note">มีบัญชีอยู่แล้ว? <a href="{$base}/login">เข้าสู่ระบบ</a></p>
        </form>
    </div>
</section>
{/block}
