{layout '../layout.latte'}

{block title}{$assignment ? 'แก้ไข' : 'เพิ่ม'}{$noun}{/block}

{block content}
{* ใช้ร่วมกันสองแบบ: ใบงานของหน่วย ($isTask = false) และงานที่มอบหมายเพิ่มเติม ($isTask = true) *}
<div class="form-page form-page-wide">
    <a class="back-link" href="{$backUrl}">← กลับไปที่ {$isTask ? 'งานที่มอบหมาย' : $unit['title']}</a>
    <h1>{$assignment ? 'แก้ไข' : 'เพิ่ม'}{$noun}</h1>
    <div class="sub">
        <span class="mono">{$course['code']}</span> ·
        {if $isTask}{$course['name']} · งานที่มอบหมายเพิ่มเติมนอกเหนือจากใบงานของหน่วย{else}{$unit['title']}{/if}
    </div>

    {if $aiEnabled}
        <form method="post" action="{$formUrl}/{if $assignment}{$assignment['id']}/draft{else}draft{/if}"
              class="card" style="margin-top:20px" data-busy="กำลังร่าง{$noun}…">
            <input type="hidden" name="_token" value="{$csrf}">
            <input type="hidden" name="max_score" value="{$form['max_score']}">
            {if $isTask}<input type="hidden" name="unit_id" value="{$form['unit_id']}" data-unit-mirror>{/if}

            <div class="step-label">ให้ผู้ช่วย AI ร่างให้ก่อน</div>
            <div class="hint" style="margin-top:6px">
                {if $isTask}
                    ผู้ช่วยจะใช้หน่วยที่เลือกไว้ (หรือคำอธิบายรายวิชา ถ้าไม่ผูกหน่วย) ร่างจุดประสงค์ ขั้นตอน สิ่งที่ต้องส่ง และเกณฑ์การให้คะแนนมาให้
                {else}
                    ผู้ช่วยจะใช้สาระสำคัญของหน่วยนี้ร่างจุดประสงค์ ขั้นตอนการทำงาน สิ่งที่ต้องส่ง และเกณฑ์การให้คะแนนมาให้
                {/if}
                แล้วครูแก้ต่อได้ทั้งหมดก่อนบันทึก
            </div>
            <textarea name="note" class="input note-input" style="margin-top:12px" maxlength="2000" rows="3"
                      aria-label="สั่งเพิ่มเติม"
                      placeholder="{$isTask ? 'สั่งเพิ่มเติม เช่น ให้ทำรายงานสำรวจร้านค้าในชุมชน (ไม่บังคับ) · พิมพ์ได้หลายบรรทัด' : 'สั่งเพิ่มเติม เช่น ให้ทำเป็นงานกลุ่มหน้าร้านจำลอง (ไม่บังคับ) · พิมพ์ได้หลายบรรทัด'}"></textarea>
            <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:10px">
                <button type="submit" class="btn btn-primary btn-ai-draft"><span class="msi">auto_awesome</span> ให้ AI ร่าง{$noun}</button>
            </div>
            <div style="margin-top:12px;max-width:520px">
                {include '../_partials/ai-picker.latte', options: $ai['options'], chosen: $ai['chosen'], id: 'assignAi'}
            </div>
            <div class="busy-note" data-busy-note hidden>
                <span class="spinner"></span>
                <span>ผู้ช่วยกำลังร่าง{$noun}ให้<span class="busy-dots"></span> อย่าปิดหน้านี้</span>
            </div>
        </form>
    {/if}

    <form method="post" action="{$formUrl}{if $assignment}/{$assignment['id']}{/if}" class="card">
        <input type="hidden" name="_token" value="{$csrf}">

        <div class="field">
            <label for="title">ชื่อ{$noun}</label>
            <input class="input" type="text" id="title" name="title" maxlength="191" required value="{$form['title']}">
        </div>

        {if $isTask}
            <div class="field">
                <label for="unit_id">เกี่ยวกับหน่วยการเรียน (ไม่บังคับ)</label>
                <select class="input" id="unit_id" name="unit_id">
                    <option value="">— ทั้งรายวิชา ไม่ผูกกับหน่วยใด —</option>
                    {foreach $units as $u}
                        <option value="{$u['id']}" selected="{(string) $u['id'] === $form['unit_id']}">หน่วยที่ {$iterator->counter} · {$u['title']}</option>
                    {/foreach}
                </select>
            </div>
        {/if}

        <div class="field">
            <label for="description">รายละเอียด{$noun}</label>
            <textarea class="input" id="description" name="description" rows="20"
                      placeholder="จุดประสงค์ ขั้นตอนการทำงาน สิ่งที่ต้องส่ง และเกณฑ์การให้คะแนน">{$form['description']}</textarea>
        </div>

        <div class="register-form-grid">
            <div class="field">
                <label for="max_score">คะแนนเต็ม</label>
                <input class="input" type="number" id="max_score" name="max_score" min="0" max="999" step="0.5" value="{$form['max_score']}">
            </div>
            <div class="field">
                <label for="due_at">กำหนดส่ง (ไม่บังคับ)</label>
                <input class="input" type="datetime-local" id="due_at" name="due_at" value="{$form['due_at']}">
            </div>
        </div>

        <label class="check-row">
            <input type="checkbox" name="allow_late" value="1" n:attr="checked: $form['allow_late']">
            <span>ให้ส่งช้าหลังกำหนดได้</span>
        </label>

        <div class="form-actions" style="margin-top:18px">
            {* ปุ่มลบอยู่ในฟอร์มแยกด้านล่าง เพราะ HTML ซ้อนฟอร์มในฟอร์มไม่ได้ *}
            {if $assignment}
                <button type="submit" form="deleteAssignment" class="btn btn-ghost-danger">ลบ{$noun}</button>
            {/if}
            <div class="spacer"></div>
            <a class="btn" href="{$backUrl}">ยกเลิก</a>
            <button type="submit" class="btn btn-primary">{$assignment ? 'บันทึก' : 'เพิ่ม'}{$noun}</button>
        </div>
    </form>

    {if $assignment}
        <form method="post" id="deleteAssignment" action="{$formUrl}/{$assignment['id']}/delete" hidden
              data-confirm-title="ลบ{$noun}" data-confirm-ok="ลบ{$noun}" data-confirm-danger
              data-confirm="ลบ{$noun} {$assignment['title']} ใช่หรือไม่ · ลบได้เฉพาะงานที่ยังไม่มีนักเรียนส่ง">
            <input type="hidden" name="_token" value="{$csrf}">
        </form>
    {/if}
</div>

{if $isTask}
<script>
    // ให้ผู้ช่วย AI ร่างจากหน่วยที่เลือกในฟอร์มด้านล่าง
    (function () {
        var pick = document.getElementById('unit_id');
        var mirror = document.querySelector('[data-unit-mirror]');
        if (pick && mirror) pick.addEventListener('change', function () { mirror.value = pick.value; });
    })();
</script>
{/if}
{/block}
