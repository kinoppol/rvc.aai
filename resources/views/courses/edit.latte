{layout '../layout.latte'}

{block title}{$course ? 'แก้ไขรายวิชา' : 'เพิ่มรายวิชา'}{/block}

{block content}
{var $isNew = $course === null}
<div class="wizard-page" style="max-width:820px">
    <a href="{$base}/courses{if !$isNew}/{$course['id']}{/if}" class="hint">← กลับไป{$isNew ? 'รายวิชาของฉัน' : $course['name']}</a>
    <h1 style="margin-top:10px">{$isNew ? 'เพิ่มรายวิชา' : 'แก้ไขรายวิชา'}</h1>
    <div class="sub">
        {if $isNew}
            กรอกข้อมูลรายวิชาที่สอนในภาคเรียนนี้ · เพิ่มบทเรียนและแบบทดสอบได้หลังบันทึก
        {else}
            แก้ได้ทุกเมื่อ · การแก้ไขไม่กระทบบทเรียน แบบทดสอบ หรือคะแนนที่บันทึกไว้แล้ว
        {/if}
    </div>

    {* แท็บสลับฝั่งเบราว์เซอร์ (form-tabs.js) — ทุกช่องยังอยู่ในฟอร์มเดียว กดบันทึกครั้งเดียวได้ครบทุกแท็บ *}
    {var $formTabs = [
        'general' => ['ข้อมูลรายวิชา', 'info'],
        'about' => ['คำอธิบายและจุดประสงค์', 'description'],
        'plan' => ['แผนการสอน', 'print'],
        'cover' => ['หน้าปก', 'palette'],
    ]}
    {if $occupation !== null}
        {do $formTabs = array_slice($formTabs, 0, 3, true) + ['occupation' => ['มาตรฐานอาชีพ', 'construction']] + array_slice($formTabs, 3, null, true)}
    {/if}
    {if !$isNew}{do $formTabs['archive'] = ['เก็บเข้าคลัง', 'folder_open']}{/if}
    <div class="tabs form-tabs" role="tablist" data-form-tabs>
        {foreach $formTabs as $key => [$label, $icon]}
            <button type="button" role="tab" n:class="tab, $iterator->first ? is-active" data-tab="{$key}"
                    aria-selected="{$iterator->first ? 'true' : 'false'}"><span class="msi" aria-hidden="true">{$icon}</span>{$label}</button>
        {/foreach}
    </div>

    <form method="post" action="{$base}/courses{if !$isNew}/{$course['id']}{/if}" class="card form-tabs-card"
          enctype="multipart/form-data" data-tabs-hide="archive">
        <input type="hidden" name="_token" value="{$csrf}">

        <div class="course-form-grid tab-panel" data-panel="general" role="tabpanel">
            <div class="field">
                <label for="cCode">รหัสวิชา</label>
                <input class="input mono" id="cCode" name="code" required maxlength="32"
                       value="{$course['code'] ?? ''}" placeholder="20127-2002" autocomplete="off"
                       list="cCodeList" data-subject-lookup="{$base}/courses/subjects">
                <datalist id="cCodeList"></datalist>
                <div class="hint" id="cCodeStatus" aria-live="polite">พิมพ์รหัสหรือชื่อวิชา ระบบเติมข้อมูลจากคลังรายวิชา สอศ. ให้</div>
            </div>
            <div class="field" style="grid-column:span 2">
                <label for="cName">ชื่อวิชา</label>
                <input class="input" id="cName" name="name" required maxlength="191"
                       value="{$course['name'] ?? ''}" placeholder="เมคคาทรอนิกส์เบื้องต้น">
            </div>

            <div class="field">
                <label for="cCredits">หน่วยกิต</label>
                <input class="input mono" id="cCredits" name="credits" type="number" step="0.5" min="0" max="9.9"
                       value="{$course['credits'] ?? '3.0'}">
            </div>
            <div class="field">
                <label for="cTheory">ชั่วโมงทฤษฎี / สัปดาห์</label>
                <input class="input mono" id="cTheory" name="theory_hours" type="number" min="0" max="255"
                       value="{$course['theory_hours'] ?? 1}">
            </div>
            <div class="field">
                <label for="cPractice">ชั่วโมงปฏิบัติ / สัปดาห์</label>
                <input class="input mono" id="cPractice" name="practice_hours" type="number" min="0" max="255"
                       value="{$course['practice_hours'] ?? 2}">
            </div>

            <div class="field" style="grid-column:span 2">
                <label for="cTerm">ภาคเรียน</label>
                <select class="input" id="cTerm" name="term_id">
                    <option value="0">ยังไม่ระบุ</option>
                    {foreach $terms as $t}
                        <option value="{$t['id']}" selected="{($course['term_id'] ?? $currentTermId) == $t['id']}">
                            {$t['name']}{if $t['is_current']} · ภาคเรียนปัจจุบัน{/if}
                        </option>
                    {/foreach}
                </select>
            </div>
            <div class="field">
                <label for="cRoom">กลุ่มเรียน</label>
                <select class="input" id="cRoom" name="classroom_id" data-combo>
                    <option value="0">ยังไม่ระบุ</option>
                    {foreach $classrooms as $r}
                        <option value="{$r['id']}" selected="{($course['classroom_id'] ?? 0) == $r['id']}">
                            {$r['name']}{if $r['department_name']} · {$r['department_name']}{/if}
                        </option>
                    {/foreach}
                </select>
            </div>

            <div class="field">
                <label for="cWeeks">สัปดาห์เรียนรวมวัดผล</label>
                <input class="input mono" id="cWeeks" name="weeks" type="number" min="1" max="30"
                       value="{$course['weeks'] ?? ''}" placeholder="ตามระดับชั้น">
            </div>
            <div class="field" style="grid-column:span 2;align-self:end">
                <div class="hint">
                    ชั่วโมงต่อสัปดาห์ = ท + ป · เว้นว่างไว้ให้ใช้ค่าปกติ: ปวช. (รหัส 2) 18 สัปดาห์รวมวัดผล ·
                    ปวส. (รหัส 3) เรียน 15 สัปดาห์ บวกสัปดาห์สอบต่อท้าย · ทล.บ. (รหัส 26-4) 18 สัปดาห์รวมวัดผล
                </div>
            </div>
        </div>

        <div class="course-form-grid tab-panel" data-panel="about" role="tabpanel" hidden>
            <div class="field" style="grid-column:1 / -1">
                <label for="cDesc">คำอธิบายรายวิชา</label>
                <textarea class="input" id="cDesc" name="description" rows="4"
                          placeholder="ศึกษาและปฏิบัติเกี่ยวกับ…">{$course['description'] ?? ''}</textarea>
                <div class="hint">ข้อความนี้จะแสดงในหน้าแรกสาธารณะด้วย ถ้าเปิดให้แสดงรายวิชาไว้</div>
            </div>
            <div class="field" style="grid-column:1 / -1">
                <label for="cObj">จุดประสงค์รายวิชา</label>
                <textarea class="input" id="cObj" name="objectives" rows="4"
                          placeholder="ข้อละบรรทัด เช่น&#10;เข้าใจหลักการ…&#10;มีทักษะในการ…">{$course['objectives'] ?? ''}</textarea>
            </div>
            <div class="field" style="grid-column:1 / -1">
                <label for="cComp">สมรรถนะรายวิชา</label>
                <textarea class="input" id="cComp" name="competencies" rows="4"
                          placeholder="ข้อละบรรทัด เช่น&#10;ประมวลความรู้เกี่ยวกับ…&#10;ปฏิบัติงาน…ตามหลักการ">{$course['competencies'] ?? ''}</textarea>
                <div class="hint">จุดประสงค์และสมรรถนะรายวิชาใช้ในหน้า “ลักษณะรายวิชา” ของแผนการสอนที่สั่งพิมพ์</div>
            </div>
        </div>

        {* ข้อมูลสำหรับแผนการจัดการเรียนรู้ (สอศ. 2567) ที่สั่งพิมพ์ *}
        <div class="course-form-grid tab-panel" data-panel="plan" role="tabpanel" hidden>
            {* ความสมบูรณ์ของแผนการสอน (PlanCompleteness) — คำนวณจากข้อมูลที่บันทึกแล้ว *}
            {if $completeness}
                {var $pct = $completeness['percent']}
                <div class="plan-score" style="grid-column:1 / -1">
                    <div class="plan-score-top">
                        <div class="plan-ring" style="--p:{$pct}">
                            <span>{$pct}<small>%</small></span>
                        </div>
                        <div class="plan-score-text">
                            <b>ความสมบูรณ์ของแผนการสอน</b>
                            <span>{if $pct >= 100}ครบถ้วนแล้ว พร้อมพิมพ์และส่งตรวจ{elseif $pct >= 80}ใกล้ครบแล้ว เติมอีกไม่กี่ส่วน{elseif $pct >= 50}มาได้ครึ่งทาง ดูคำแนะนำด้านล่าง{else}ยังขาดข้อมูลหลายส่วน เริ่มจากคำแนะนำด้านล่าง{/if}
                                · คิดจากข้อมูลที่บันทึกแล้ว</span>
                            <div class="plan-bar"><i style="width:{$pct}%"></i></div>
                        </div>
                        <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/plan-print" target="_blank" rel="noopener">ดูแผนการสอน</a>
                    </div>
                    {var $todo = $completeness['todo']}
                    {if $todo}
                        <ul class="plan-todo">
                            {foreach $todo as $i}
                                <li>
                                    <span class="plan-todo-pts">+{$i['gain']}%</span>
                                    <div><b>{$i['label']}</b>{if $i['tip']} — {$i['tip']}{/if}</div>
                                    {if $i['link']}<a href="{$i['link']}" class="plan-todo-go">ไปเติม</a>{/if}
                                </li>
                            {/foreach}
                        </ul>
                    {/if}
                    <details class="plan-done">
                        <summary>รายการที่ตรวจทั้งหมด ({$completeness['done']}/{count($completeness['items'])} ครบ)</summary>
                        <ul>
                            {foreach $completeness['items'] as $i}
                                <li n:class="$i['done'] ? is-done">{$i['done'] ? '✓' : '○'} {$i['label']} <small>({$i['weight']}%)</small></li>
                            {/foreach}
                        </ul>
                    </details>
                </div>
            {/if}
            <div class="field" style="grid-column:1 / -1;margin-bottom:0">
                <div class="hint">ใช้ในแผนการจัดการเรียนรู้ (สอศ. 2567) ที่สั่งพิมพ์จากปุ่ม “พิมพ์แผนการสอน” ในหน้ารายวิชา</div>
            </div>
            {if $planFormats !== null}
                <div class="field" style="grid-column:1 / -1">
                    <label for="cPlanFormat">แบบฟอร์มแผนการจัดการเรียนรู้</label>
                    <select class="input" id="cPlanFormat" name="plan_format">
                        {foreach $planFormats as $key => $label}
                            <option value="{$key}" selected="{$key === $planFormat}">{$label}</option>
                        {/foreach}
                    </select>
                    <div class="hint">แบบที่ใช้เมื่อเปิด “พิมพ์แผนการสอน” และในลิงก์แชร์ · ในหน้าพิมพ์สลับดูอีกแบบได้จากแถบเครื่องมือ</div>
                </div>
            {/if}
            <div class="field">
                <label for="cProgram">ประเภทวิชา</label>
                <input class="input" id="cProgram" name="program_type" maxlength="191" list="programTypes"
                       value="{$course['program_type'] ?? ''}" placeholder="เช่น อุตสาหกรรม">
                <datalist id="programTypes">
                    {foreach $programTypes as $p}
                        <option value="{$p}"></option>
                    {/foreach}
                </datalist>
            </div>
            {if $careerGroups !== null}
                <div class="field">
                    <label for="cCareer">กลุ่มอาชีพ</label>
                    <input class="input" id="cCareer" name="career_group" maxlength="191" list="careerGroups" autocomplete="off"
                           value="{$course['career_group'] ?? ''}" placeholder="เช่น ซอฟต์แวร์และการประยุกต์">
                    <datalist id="careerGroups">
                        {foreach $careerGroups as $program => $groups}
                            {foreach $groups as $g}
                                <option value="{$g}" label="{$program}" data-program="{$program}"></option>
                            {/foreach}
                        {/foreach}
                        {foreach $myCareerGroups as $g}
                            <option value="{$g}" label="ที่คุณเพิ่มเอง" data-mine="1"></option>
                        {/foreach}
                    </datalist>
                    <div class="hint">เลือกจากกลุ่มอาชีพ ปวช. 2567 หรือพิมพ์ชื่อใหม่เองได้ · ชื่อที่พิมพ์เองแสดงเป็นตัวเลือกให้คุณคนเดียว</div>
                </div>
                <script n:syntax="off">
                (function () {
                    var program = document.getElementById('cProgram');
                    var career = document.getElementById('cCareer');
                    var list = document.getElementById('careerGroups');
                    if (!program || !career || !list) return;
                    var norm = function (s) { return (s || '').replace(/^ประเภทวิชา/, '').replace(/\s+/g, ''); };
                    var options = Array.prototype.slice.call(list.options);
                    // กลุ่มอาชีพของประเภทวิชาที่เลือกขึ้นก่อน ตามด้วยชื่อที่ครูเพิ่มเอง แล้วจึงที่เหลือ
                    var reorder = function () {
                        var p = norm(program.value);
                        var rank = function (o) {
                            if (p && norm(o.dataset.program) === p) return 0;
                            return o.dataset.mine ? 1 : 2;
                        };
                        options.slice().sort(function (a, b) {
                            return rank(a) - rank(b) || options.indexOf(a) - options.indexOf(b);
                        }).forEach(function (o) { list.appendChild(o); });
                    };
                    // เลือกกลุ่มอาชีพมาตรฐานโดยยังไม่ได้กรอกประเภทวิชา → เติมประเภทวิชาให้
                    career.addEventListener('change', function () {
                        if (program.value.trim() !== '') return;
                        var hit = options.filter(function (o) { return o.value === career.value.trim() && o.dataset.program; })[0];
                        if (hit) { program.value = hit.dataset.program; reorder(); }
                    });
                    program.addEventListener('input', reorder);
                    reorder();
                })();
                </script>
            {/if}
            <div class="field">
                <label for="cMajor">สาขาวิชา</label>
                <input class="input" id="cMajor" name="major" maxlength="191"
                       value="{$course['major'] ?? ''}" placeholder="เช่น เทคโนโลยีสารสนเทศ">
            </div>
            <div class="field">
                <label for="cPlanDate">วันที่จัดทำแผน</label>
                <input class="input" id="cPlanDate" name="plan_date" type="date" value="{$course['plan_date'] ?? ''}">
                <div class="hint">พิมพ์ใต้ลายมือชื่อครูในหน้าลักษณะรายวิชา · ท้ายแผนแต่ละหน่วยใช้วันที่บันทึกหลังสอน</div>
            </div>
            {if $staff !== null}
                <div class="field">
                    <label for="cDeptHead">หัวหน้าแผนกวิชา (ผู้ลงนาม)</label>
                    <select class="input" id="cDeptHead" name="dept_head_id" data-combo>
                        <option value="0">ยังไม่ระบุ</option>
                        {foreach $staff as $s}
                            <option value="{$s['id']}" selected="{$s['id'] === $deptHeadId}">{$s['full_name']}</option>
                        {/foreach}
                    </select>
                    <div class="hint">พิมพ์ชื่อใต้ช่องลงนามหัวหน้าแผนกวิชาในหน้าลักษณะรายวิชา · ผู้ลงนามตำแหน่งอื่นผู้ดูแลระบบกำหนดให้</div>
                </div>
            {/if}
            <div class="field" style="grid-column:1 / -1">
                <label for="cClo">ผลลัพธ์การเรียนรู้ระดับรายวิชา</label>
                <textarea class="input" id="cClo" name="learning_outcomes" rows="4"
                          placeholder="ข้อละบรรทัด เช่น&#10;อธิบายหลักการ… ได้ถูกต้อง&#10;ปฏิบัติงาน… ได้ตามมาตรฐาน">{$course['learning_outcomes'] ?? ''}</textarea>
                <div class="clo-ai">
                    <button type="button" n:class="btn, btn-sm, btn-ai, trim($course['learning_outcomes'] ?? '') === '' ? is-needed" id="cloDraft"
                            data-url="{$base}/courses/draft-outcomes" data-token="{$csrf}">✦ ให้ AI สรุปจากคำอธิบาย จุดประสงค์ และสมรรถนะ</button>
                    <span class="hint" id="cloStatus">ผู้ช่วยร่างให้ แล้วครูแก้ไขต่อได้ก่อนบันทึก</span>
                </div>
            </div>

            {* ตารางวิเคราะห์พฤติกรรมการเรียนรู้ (แบบที่ 2) — พิมพ์ในแผนหลักสูตร 2567 · BehaviorAnalysis *}
            {if $behavior !== null}
                <div class="field bh-editor" style="grid-column:1 / -1" id="behavior">
                    <input type="hidden" name="bh_present" value="1">
                    <div class="bh-head">
                        <div>
                            <label>ตารางวิเคราะห์พฤติกรรมการเรียนรู้</label>
                            <div class="hint">ระดับความสามารถที่คาดหวังและร้อยละประเมินผลของแต่ละหน่วย · ร้อยละรวมกันต้องได้ 100</div>
                        </div>
                        {if $aiPlanEnabled && $behaviorUnits}
                            <button type="button" class="btn btn-sm btn-ai" id="bhDraft"
                                    data-url="{$base}/courses/{$course['id']}/draft-behavior" data-token="{$csrf}">✦ ให้ AI วิเคราะห์</button>
                        {/if}
                    </div>
                    {if $behaviorUnits}
                        <div class="bh-wrap">
                            <table class="bh-table">
                                <thead>
                                    <tr><th>หน่วยการเรียนรู้</th><th>พุทธิพิสัย (K)</th><th>ทักษะพิสัย (S)</th><th>จิตพิสัย (A)</th><th>ประยุกต์ใช้ (Ap)</th><th>ร้อยละ</th></tr>
                                </thead>
                                <tbody>
                                    {foreach $behaviorUnits as $u}
                                        {var $row = $behavior['units'][$u['id']] ?? null}
                                        <tr data-unit="{$u['id']}">
                                            <td class="bh-unit">{$iterator->counter}. {$u['title']}</td>
                                            <td class="bh-k">
                                                {foreach $behaviorLevels['K'] as $code => $label}
                                                    <label class="bh-chip" title="{$label}"><input type="checkbox" name="bh[{$u['id']}][k][]" value="{$code}"
                                                        checked="{$row && in_array($code, $row['k'], true)}"><span>{$code}</span></label>
                                                {/foreach}
                                            </td>
                                            {foreach ['s' => 'S', 'a' => 'A', 'ap' => 'Ap'] as $field => $set}
                                                <td>
                                                    <select class="input" name="bh[{$u['id']}][{$field}]" aria-label="{$set}">
                                                        <option value="">–</option>
                                                        {foreach $behaviorLevels[$set] as $code => $label}
                                                            <option value="{$code}" title="{$label}" selected="{$row && $row[$field] === $code}">{$code}</option>
                                                        {/foreach}
                                                    </select>
                                                </td>
                                            {/foreach}
                                            <td><input class="input bh-weight" type="number" min="0" max="100" step="1" name="bh[{$u['id']}][weight]"
                                                       value="{$row ? $row['weight'] : ''}" aria-label="ร้อยละประเมินผล"></td>
                                        </tr>
                                    {/foreach}
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="5" class="bh-unit">ประเมินผลลัพธ์การเรียนรู้ระดับรายวิชา</td>
                                        <td><input class="input bh-weight" type="number" min="0" max="100" step="1" name="bh_outcome_weight"
                                                   value="{$behavior['outcome_weight'] ?? ''}" aria-label="ร้อยละประเมินผลลัพธ์ระดับรายวิชา"></td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" class="bh-unit" style="text-align:right">รวม</td>
                                        <td><b id="bhTotal">0</b></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <details class="bh-legend">
                            <summary>ความหมายของระดับ K / S / A / Ap</summary>
                            <dl>
                                {foreach ['K' => 'พุทธิพิสัย (ใส่ได้หลายระดับ)', 'S' => 'ทักษะพิสัย', 'A' => 'จิตพิสัย', 'Ap' => 'ประยุกต์ใช้และรับผิดชอบ'] as $set => $title}
                                    <div><dt>{$title}</dt>
                                        {foreach $behaviorLevels[$set] as $code => $label}<dd>{$code} = {$label}</dd>{/foreach}
                                    </div>
                                {/foreach}
                            </dl>
                        </details>
                        <span class="hint" id="bhStatus">K ใส่ได้หลายระดับ · S, A และ Ap เลือกระดับเดียว · ผลจาก AI เป็นร่าง ตรวจแก้ได้แล้วกดบันทึก</span>
                    {else}
                        <div class="hint">ยังไม่มีหน่วยการเรียนรู้ — <a href="{$base}/courses/{$course['id']}/units/design">ออกแบบหน่วยการเรียนรู้</a> ก่อน แล้วจึงวิเคราะห์พฤติกรรมได้</div>
                    {/if}
                </div>
                <script src="{$base}/assets/js/behavior-analysis.js?v={$assetVer ?? 1}" defer></script>
            {/if}
        </div>

        {* มาตรฐานอาชีพที่รายวิชาอ้างอิง — ไม่มีข้อมูล = หน้าพิมพ์ข้ามหน้า "มาตรฐานอาชีพ" (OccupationStandard) *}
        {if $occupation !== null}
            <div class="tab-panel occ-editor" data-panel="occupation" role="tabpanel" hidden>
                <input type="hidden" name="os_present" value="1">
                <div class="hint" style="margin-bottom:12px">ใช้ในหน้า “มาตรฐานอาชีพ” ของแผนการจัดการเรียนรู้หลักสูตร 2567 · มักมาพร้อมคำอธิบายรายวิชา
                    · รายวิชาที่ไม่มีมาตรฐานอาชีพอ้างอิงเว้นว่างไว้ทั้งหมด ระบบจะข้ามหน้านี้ตอนพิมพ์</div>
                <div class="course-form-grid">
                    <div class="field">
                        <label for="osAgency">หน่วยงานรับรองมาตรฐานอาชีพ</label>
                        <input class="input" id="osAgency" name="os_agency" maxlength="255" value="{$occupation['agency']}"
                               placeholder="เช่น สถาบันคุณวุฒิวิชาชีพ (องค์การมหาชน)">
                    </div>
                    <div class="field">
                        <label for="osStandard">มาตรฐานอาชีพ</label>
                        <input class="input" id="osStandard" name="os_standard" maxlength="255" value="{$occupation['standard']}"
                               placeholder="ชื่อมาตรฐานอาชีพ">
                    </div>
                    <div class="field">
                        <label for="osOccupation">อาชีพ</label>
                        <input class="input" id="osOccupation" name="os_occupation" maxlength="255" value="{$occupation['occupation']}"
                               placeholder="เช่น นักพัฒนาซอฟต์แวร์ ชั้น 4">
                    </div>
                </div>

                <div class="occ-table-wrap">
                    <table class="occ-table">
                        <thead>
                            <tr><th colspan="2">หน่วยสมรรถนะ (UoC)</th><th colspan="2">สมรรถนะย่อย (EoC)</th>
                                <th rowspan="2">เกณฑ์การปฏิบัติงาน (PC)</th><th rowspan="2">วิธีประเมิน</th><th rowspan="2"></th></tr>
                            <tr><th>รหัส</th><th>คำอธิบาย</th><th>รหัส</th><th>คำอธิบาย</th></tr>
                        </thead>
                        <tbody id="occRows">
                            {foreach $occupation['rows'] as $r}
                                {include occRow, r: $r}
                            {/foreach}
                        </tbody>
                    </table>
                    <template id="occRowTpl">{include occRow, r: []}</template>
                </div>
                <p class="hint occ-empty" id="occEmpty" n:attr="hidden: $occupation['rows'] !== []">ยังไม่มีแถว — กด “เพิ่มแถว” หรือวางตารางที่คัดลอกมา</p>
                <div class="occ-actions">
                    <button type="button" class="btn btn-sm" id="occAdd"><span class="msi" aria-hidden="true">add</span>เพิ่มแถว</button>
                    <button type="button" class="btn btn-sm" data-reveal-occ>วางตารางจาก Word / Excel</button>
                    <button type="button" class="btn btn-sm btn-ghost-danger" id="occClear">ล้างทั้งหมด</button>
                </div>
                <div class="occ-paste" id="occPaste" hidden>
                    <label for="occPasteText">คัดลอกแถวของตาราง (6 คอลัมน์: รหัส UoC · คำอธิบาย UoC · รหัส EoC · คำอธิบาย EoC · เกณฑ์ PC · วิธีประเมิน) แล้ววางที่นี่</label>
                    <textarea class="input" id="occPasteText" rows="5" placeholder="วางตารางที่นี่"></textarea>
                    <div class="occ-actions">
                        <button type="button" class="btn btn-sm btn-primary" id="occPasteApply">เพิ่มเป็นแถว</button>
                        <span class="hint">ช่องที่ว่าง (เช่นรหัส UoC ที่รวมเซลล์ไว้) ระบบใช้ค่าจากแถวก่อนหน้า · กด “บันทึก” ด้านล่างเพื่อบันทึก</span>
                    </div>
                </div>
            </div>
            <script src="{$base}/assets/js/occupation-rows.js?v={$assetVer ?? 1}" defer></script>
        {/if}

        {* หน้าปกรายวิชา: สีจากชุดสี / สีเอง / สุ่ม หรืออัปโหลดรูปแล้วให้ระบบเลือกสีที่เข้ากับรูป *}
        {var $coverColor = $course['cover_color'] ?? ''}
        {var $shown = $coverColor ?: $coverAuto}
        <div class="cover-editor tab-panel" id="coverEditor" data-panel="cover" role="tabpanel" hidden
             data-palette="{json_encode(array_column($coverPalette, 0))}" data-auto="{$coverAuto}">
            <div class="hint">สีและรูปนี้ใช้กับการ์ดรายวิชา แบนเนอร์หน้ารายวิชา และหน้าเรียนของนักเรียน</div>
            <div class="cover-layout">
                <div class="course-card-head cover-preview" id="coverPreview" style="--cc:#{$shown}">
                    <img class="cover-img" id="coverPreviewImg" alt="" src="{$course['cover_url'] ?? ''}" n:attr="hidden: empty($course['cover_url'])">
                    <div class="name">{$course['name'] ?? 'ชื่อรายวิชา'}</div>
                    <div class="code">{$course['code'] ?? 'รหัสวิชา'}</div>
                </div>

                <div class="cover-controls">
                    <input type="hidden" name="cover_color" id="coverColor" value="{$coverColor}">
                    <div class="hint">สีหน้าปก</div>
                    <div class="cover-swatches">
                        <button type="button" n:class="cover-swatch, cover-swatch-auto, $coverColor === '' ? is-on" data-hex=""
                                style="--sw:#{$coverAuto}" title="ให้ระบบสุ่มสีประจำวิชาให้">สุ่ม</button>
                        {foreach $coverPalette as [$hex, $label]}
                            <button type="button" n:class="cover-swatch, $coverColor === $hex ? is-on" data-hex="{$hex}"
                                    style="--sw:#{$hex}" title="{$label}"></button>
                        {/foreach}
                    </div>
                    <div class="cover-row">
                        <input type="color" id="coverPicker" class="color-input" value="#{$shown}" title="เลือกสีเอง">
                        <button type="button" class="btn btn-sm" id="coverRandom">สุ่มสีใหม่</button>
                    </div>

                    <div class="hint" style="margin-top:12px">รูปหน้าปก (ไม่บังคับ) · JPG, PNG หรือ WEBP ไม่เกิน 3 MB</div>
                    <input type="file" name="cover" id="coverFile" class="input" accept="image/jpeg,image/png,image/webp">
                    {if !empty($course['cover_url'])}
                        <label class="hint" style="display:flex;gap:7px;align-items:center;margin-top:7px">
                            <input type="checkbox" name="remove_cover" value="1" id="coverRemove"> ลบรูปหน้าปก
                        </label>
                    {/if}
                    <div id="coverSuggest" hidden style="margin-top:12px">
                        <div class="hint">สีที่เข้ากับรูป · ระบบวิเคราะห์สีในรูปแล้วเลือกสีที่เด่นที่สุดให้ กดเปลี่ยนได้</div>
                        <div class="cover-swatches" id="coverSuggestList"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-tabs-actions">
            <button type="submit" class="btn btn-primary">{$isNew ? 'เพิ่มรายวิชา' : 'บันทึกการแก้ไข'}</button>
            <a class="btn" href="{$base}/courses{if !$isNew}/{$course['id']}{/if}">ยกเลิก</a>
            <span class="hint">บันทึกข้อมูลของทุกแท็บพร้อมกัน</span>
        </div>
    </form>

    {if !$isNew}
        <div class="card form-tabs-card tab-panel" data-panel="archive" role="tabpanel" hidden>
            <strong>เก็บรายวิชาเข้าคลัง</strong>
            <div class="hint" style="margin-top:6px">
                รายวิชาจะหายจากหน้ารายวิชาของฉันและหน้าแรกสาธารณะ แต่บทเรียน แบบทดสอบ และคะแนนของนักเรียนยังอยู่ครบ
            </div>
            <form method="post" action="{$base}/courses/{$course['id']}/archive" style="margin-top:12px"
                  data-confirm-title="เก็บรายวิชาเข้าคลัง" data-confirm-ok="เก็บเข้าคลัง"
                  data-confirm="เก็บรายวิชา {$course['name']} เข้าคลังใช่หรือไม่ · บทเรียนและแบบทดสอบยังอยู่ครบ แต่จะไม่แสดงในรายวิชาที่เปิดสอน">
                <input type="hidden" name="_token" value="{$csrf}">
                <button type="submit" class="btn btn-ghost-danger">เก็บเข้าคลัง</button>
            </form>
        </div>
    {/if}
</div>
<script src="{$base}/assets/js/form-tabs.js"></script>
<script src="{$base}/assets/js/cover-picker.js"></script>
<script src="{$base}/assets/js/outcomes-draft.js"></script>
<script src="{$base}/assets/js/subject-lookup.js?v={$assetVer ?? 1}"></script>
{/block}

{* แถวตารางมาตรฐานอาชีพในแท็บ "มาตรฐานอาชีพ" — ใช้ทั้งแถวที่บันทึกไว้และแม่แบบแถวใหม่ (r = []) *}
{define occRow}
    <tr class="occ-row">
        <td><input class="input" name="os_uoc_code[]" maxlength="50" value="{$r['uoc_code'] ?? ''}" aria-label="รหัสหน่วยสมรรถนะ"></td>
        <td><textarea class="input" name="os_uoc[]" rows="2" aria-label="คำอธิบายหน่วยสมรรถนะ">{$r['uoc'] ?? ''}</textarea></td>
        <td><input class="input" name="os_eoc_code[]" maxlength="50" value="{$r['eoc_code'] ?? ''}" aria-label="รหัสสมรรถนะย่อย"></td>
        <td><textarea class="input" name="os_eoc[]" rows="2" aria-label="คำอธิบายสมรรถนะย่อย">{$r['eoc'] ?? ''}</textarea></td>
        <td><textarea class="input" name="os_pc[]" rows="2" aria-label="เกณฑ์การปฏิบัติงาน">{$r['pc'] ?? ''}</textarea></td>
        <td><textarea class="input" name="os_method[]" rows="2" aria-label="วิธีประเมิน">{$r['method'] ?? ''}</textarea></td>
        <td><button type="button" class="icon-btn occ-del" title="ลบแถว" aria-label="ลบแถว"><span class="msi" aria-hidden="true">delete</span></button></td>
    </tr>
{/define}
