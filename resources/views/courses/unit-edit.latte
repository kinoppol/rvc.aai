{layout '../layout.latte'}

{block title}{if $unit}แก้ไข{else}เพิ่ม{/if}{$isExam ? 'หน่วยสอบ' : 'หน่วยการเรียน'} · {$course['name']}{/block}

{block content}
<div class="page-head">
    <div>
        <div class="sub"><a href="{$base}/courses/{$course['id']}?tab=units">{$course['name']}</a></div>
        <h1>{if $unit}{$unit['title']}{elseif $isExam}{$kinds[$kind]}{else}หน่วยการเรียนใหม่{/if}</h1>
    </div>
    {if $unit}
        <div class="actions">
            {* เนื้อหาทั้งหน่วยรวมใบงานเป็นไฟล์ .md สำหรับนำไปสร้างงานนำเสนอต่อ (ส่งออกตามที่บันทึกไว้แล้ว) *}
            <a class="btn" href="{$base}/courses/{$course['id']}/units/{$unit['id']}/export.md"
               title="บทนำ ส่วนเนื้อหา และใบงานของหน่วยนี้ · คั่นหัวข้อด้วย --- เพื่อนำไปสร้างสไลด์ต่อ">
                <span class="msi">download</span> ส่งออก Markdown (.md)
            </a>
        </div>
    {/if}
</div>

{* ── ฟอร์มข้อมูลหน่วย ── *}
<div class="card" style="margin-bottom:16px">
    <div class="card-head">{$isExam ? 'ข้อมูลหน่วยสอบ' : 'บทนำหน่วยการเรียน'}</div>
    <form method="post" action="{$base}/courses/{$course['id']}/units{if $unit}/{$unit['id']}{/if}" id="unitForm">
        <input type="hidden" name="_token" value="{$csrf}">

        <div class="unit-kind-row">
            <div class="field">
                <label for="title">ชื่อหน่วย <span class="required">*</span></label>
                <input class="input" type="text" id="title" name="title"
                       value="{$unit['title'] ?? ($isExam ? $kinds[$kind] : '')}" required autofocus>
            </div>
            <div class="field">
                <label for="kind">ประเภทหน่วย</label>
                <select class="input" id="kind" name="kind">
                    {foreach $kinds as $k => $label}
                        <option value="{$k}" selected="{$k === $kind}">{$label}</option>
                    {/foreach}
                </select>
            </div>
            <div class="field unit-weeks" data-lesson-only n:attr="hidden: $isExam">
                <label for="weeks">จำนวนสัปดาห์</label>
                <input class="input mono" type="number" id="weeks" name="weeks" min="1" max="30"
                       value="{$unit['weeks'] ?? ''}" placeholder="แบ่งอัตโนมัติ" title="เว้นว่าง = แผนการสอนแบ่งสัปดาห์ที่เหลือให้เท่า ๆ กัน">
            </div>
        </div>

        <div class="field">
            <label for="key_content" data-label-lesson="สาระสำคัญ" data-label-exam="คำชี้แจงการสอบ">{$isExam ? 'คำชี้แจงการสอบ' : 'สาระสำคัญ'}</label>
            <textarea class="input" id="key_content" name="key_content" rows="3"
                      data-ph-lesson="ระบุสาระสำคัญของหน่วยการเรียนนี้..."
                      data-ph-exam="เช่น สอบครอบคลุมหน่วยที่ 1–4 · ใช้เวลา 60 นาที · ห้ามเปิดตำรา"
                      placeholder="{$isExam ? 'เช่น สอบครอบคลุมหน่วยที่ 1–4 · ใช้เวลา 60 นาที · ห้ามเปิดตำรา' : 'ระบุสาระสำคัญของหน่วยการเรียนนี้...'}">{$unit['key_content'] ?? ''}</textarea>
        </div>

        <div class="field" data-lesson-only n:attr="hidden: $isExam">
            <label for="objectives">วัตถุประสงค์การเรียนรู้</label>
            <textarea class="input" id="objectives" name="objectives" rows="4"
                      placeholder="เมื่อเรียนจบหน่วยนี้แล้ว นักเรียนจะสามารถ...&#10;1. ...&#10;2. ...">{$unit['objectives'] ?? ''}</textarea>
        </div>

        <div class="field" data-lesson-only n:attr="hidden: $isExam">
            <label for="competencies">สมรรถนะประจำหน่วย</label>
            <textarea class="input" id="competencies" name="competencies" rows="3"
                      placeholder="ระบุสมรรถนะที่คาดหวังให้ผู้เรียนมีหลังเรียนจบหน่วยนี้...">{$unit['competencies'] ?? ''}</textarea>
        </div>

        <div class="hint" data-exam-only n:attr="hidden: !$isExam">หน่วยสอบไม่มีเนื้อหา · บันทึกแล้วสร้างแบบทดสอบของหน่วยนี้ได้ด้านล่าง</div>

        <div style="display:flex;gap:8px;margin-top:8px">
            <button type="submit" name="action" value="save" class="btn btn-primary">บันทึกฉบับร่าง</button>
            <button type="submit" name="action" value="publish" class="btn">เผยแพร่</button>
            <a href="{$base}/courses/{$course['id']}?tab=units" class="btn btn-ghost">ยกเลิก</a>
        </div>
    </form>
</div>

{if $unit}
{if !$isExam}
{* ── ส่วนเนื้อหา ── *}
<div class="card" style="margin-bottom:16px">
    <div class="card-head">เนื้อหา</div>

    {if $sections}
        <div class="list" style="margin-bottom:0">
            {foreach $sections as $s}
                {* ประเภท / แก้ไข / ลบ เป็นไอคอน · ชี้เมาส์แล้วมีป้ายบอก (data-tip) *}
                {var $typeTip = $s['type'] === 'video' ? 'วีดิโอ' : ($s['type'] === 'pdf' ? 'เอกสาร PDF' : 'เนื้อหาข้อความ')}
                <div class="list-row">
                    <span class="icon-act is-type section-type-{$s['type']}" data-tip="{$typeTip}" aria-label="{$typeTip}" role="img">
                        <span class="msi" aria-hidden="true">{$s['type'] === 'video' ? 'smart_display' : ($s['type'] === 'pdf' ? 'description' : 'article')}</span>
                    </span>
                    {* เปิดดูเนื้อหาแบบที่นักเรียนเห็น (ร่างก็เปิดได้) ในแท็บใหม่ — หน้าแก้ไขยังเปิดค้างไว้ *}
                    {var $viewUrl = $base . '/courses/' . $course['id'] . '/units/' . $unit['id'] . '/preview/section/' . $s['id']}
                    <div class="list-main">
                        <div class="list-title"><a href="{$viewUrl}" target="_blank" rel="noopener">{$s['title']}</a></div>
                        {if $s['type'] !== 'text'}
                            <div class="list-meta mono" style="font-size:12px">
                                {$s['type'] === 'video' ? ($s['video_url']|truncate:60) : ($s['file_name'] ?? $s['file_path'])}
                            </div>
                        {/if}
                    </div>
                    <a class="icon-act" href="{$viewUrl}" target="_blank" rel="noopener" data-tip="เปิดดูเนื้อหา" aria-label="เปิดดู {$s['title']}">
                        <span class="msi" aria-hidden="true">visibility</span>
                    </a>
                    <button type="button" class="icon-act" data-tip="แก้ไขส่วนนี้" aria-label="แก้ไข {$s['title']}"
                            data-reveal="editSection{$s['id']}" aria-expanded="false" aria-controls="editSection{$s['id']}">
                        <span class="msi" aria-hidden="true">edit</span>
                    </button>
                    <form method="post" action="{$base}/courses/{$course['id']}/units/{$unit['id']}/sections/{$s['id']}/delete"
                          data-confirm-title="ลบส่วนนี้" data-confirm-ok="ลบส่วนนี้" data-confirm-danger
                          data-confirm="ลบส่วนนี้ออกจากหน่วยการเรียนใช่หรือไม่" style="display:inline">
                        <input type="hidden" name="_token" value="{$csrf}">
                        <button type="submit" class="icon-act is-danger" data-tip="ลบส่วนนี้" aria-label="ลบ {$s['title']}">
                            <span class="msi" aria-hidden="true">delete</span>
                        </button>
                    </form>
                </div>
                {* แก้ไขส่วนนี้ (เปิดจากปุ่ม "แก้ไข" · เปิดได้ทีละฟอร์ม) *}
                <form method="post" action="{$base}/courses/{$course['id']}/units/{$unit['id']}/sections/{$s['id']}"
                      id="editSection{$s['id']}" class="ai-draft-form section-edit reveal-panel" hidden>
                    <input type="hidden" name="_token" value="{$csrf}">
                    <div class="ai-draft-form-head" style="margin-bottom:12px">
                        <div class="step-label">แก้ไขส่วนเนื้อหา</div>
                        <button type="button" class="btn btn-sm btn-ghost" data-reveal="editSection{$s['id']}">ปิด</button>
                    </div>
                    <div class="field">
                        <label for="secTitle{$s['id']}">ชื่อส่วน</label>
                        <input class="input" type="text" id="secTitle{$s['id']}" name="title" value="{$s['title']}" maxlength="191" required>
                    </div>
                    {if $s['type'] === 'text'}
                        <div class="field">
                            <label for="secContent{$s['id']}">เนื้อหา</label>
                            <textarea class="input" id="secContent{$s['id']}" name="content" rows="14">{$s['content']}</textarea>
                        </div>
                    {elseif $s['type'] === 'video'}
                        <div class="field">
                            <label for="secVideo{$s['id']}">URL วีดิโอ <span class="required">*</span></label>
                            <input class="input" type="url" id="secVideo{$s['id']}" name="video_url" value="{$s['video_url']}" required>
                        </div>
                    {else}
                        <p class="hint">ไฟล์ PDF แก้ได้เฉพาะชื่อ · ถ้าต้องการเปลี่ยนไฟล์ ให้ลบส่วนนี้แล้วเพิ่มใหม่</p>
                    {/if}
                    <div class="form-actions" style="margin-top:4px">
                        <button type="submit" class="btn btn-primary btn-sm">บันทึกการแก้ไข</button>
                        <button type="button" class="btn btn-sm btn-ghost" data-reveal="editSection{$s['id']}">ยกเลิก</button>
                    </div>
                </form>
            {/foreach}
        </div>
    {else}
        <p class="sub" style="padding:16px 0 0">ยังไม่มีเนื้อหา เพิ่มส่วนเนื้อหาด้านล่าง</p>
    {/if}

    {* ── แถบปุ่ม: กดแล้วจึงเปิดฟอร์มที่ต้องการ หน้าแก้ไขหน่วยจะได้ไม่ยาวเกินไป ── *}
    {var $canDraft = $course['ai_lesson_plan_enabled'] && !$drafted}
    <div class="ai-draft-toggle" id="contentTools">
        <button type="button" class="btn" data-reveal="addSectionPanel" aria-expanded="false" aria-controls="addSectionPanel">
            + เพิ่มส่วนเนื้อหา
        </button>
        {if $canDraft}
            <button type="button" class="btn btn-ai" data-reveal="contentDraftForm" aria-expanded="false" aria-controls="contentDraftForm">
                <span>✦</span> ให้ AI ช่วยร่างเนื้อหาของหน่วยนี้
            </button>
        {/if}
    </div>

    {* ── ให้ผู้ช่วย AI ร่างเนื้อหาของหน่วยนี้ ── *}
    {if $course['ai_lesson_plan_enabled']}
        {if $drafted}
            <form method="post" action="{$base}/courses/{$course['id']}/units/{$unit['id']}/content-draft/save"
                  style="margin-top:16px;border-top:1px solid var(--line);padding-top:16px">
                <input type="hidden" name="_token" value="{$csrf}">
                <div class="step-label">ผู้ช่วยร่างเนื้อหามาให้ {count($drafted)} หัวข้อ</div>
                <div class="hint" style="margin-top:6px">ติ๊กหัวข้อที่ต้องการ แล้วกดบันทึก · เนื้อหาจะถูกเพิ่มต่อท้ายของเดิม แก้ไขต่อได้</div>

                <div style="margin-top:10px">
                    {foreach $drafted as $i => $d}
                        <label class="outline-row">
                            <input type="checkbox" name="pick[]" value="{$i}" checked>
                            <span class="outline-no mono">{sprintf('%02d', $iterator->counter)}</span>
                            <span class="outline-main">
                                <span class="outline-title">{$d['title']}</span>
                                <span class="outline-sub">{$d['content']}</span>
                            </span>
                        </label>
                    {/foreach}
                </div>

                <div class="form-actions" style="margin-top:14px">
                    <div class="spacer"></div>
                    <button type="submit" class="btn btn-primary btn-sm">บันทึกหัวข้อที่เลือก</button>
                </div>
            </form>
        {else}
            <form method="post" action="{$base}/courses/{$course['id']}/units/{$unit['id']}/content-draft"
                  id="contentDraftForm" class="ai-draft-form reveal-panel" hidden
                  data-busy="กำลังร่างเนื้อหา…">
                <input type="hidden" name="_token" value="{$csrf}">
                <div class="ai-draft-form-head">
                    <div class="step-label">ให้ AI ช่วยร่างเนื้อหาของหน่วยนี้</div>
                    <button type="button" class="btn btn-sm btn-ghost" data-reveal="contentDraftForm">ปิด</button>
                </div>
                <div class="hint" style="margin-top:6px">
                    ผู้ช่วยจะใช้สาระสำคัญและจุดประสงค์ของหน่วยนี้เขียนเนื้อหาแยกเป็นหัวข้อย่อยมาให้เลือก
                </div>
                <textarea name="note" class="input note-input" style="margin-top:12px" maxlength="2000" rows="3"
                          aria-label="สั่งเพิ่มเติม"
                          placeholder="สั่งเพิ่มเติม เช่น ยกตัวอย่างจากร้านสะดวกซื้อ (ไม่บังคับ) · พิมพ์ได้หลายบรรทัด"></textarea>
                <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:10px">
                    <label class="hint" style="display:flex;gap:8px;align-items:center">
                        จำนวนหัวข้อย่อย
                        <select name="count" class="input" style="width:auto">
                            <option value="auto" selected>ให้ AI กำหนดตามความเหมาะสม</option>
                            {for $n = 2; $n <= 10; $n++}<option value="{$n}">{$n} หัวข้อ</option>{/for}
                        </select>
                    </label>
                    <button type="submit" class="btn btn-primary">✦ ให้ AI ร่างเนื้อหา</button>
                </div>
                <div style="margin-top:12px;max-width:520px">
                    {include '../_partials/ai-picker.latte', options: $ai['options'], chosen: $ai['chosen'], id: 'contentAi'}
                </div>
                <div class="busy-note" data-busy-note hidden>
                    <span class="spinner"></span>
                    <span>ผู้ช่วยกำลังเขียนเนื้อหาให้<span class="busy-dots"></span> อย่าปิดหน้านี้</span>
                </div>
            </form>
        {/if}
    {/if}

    {* ── เพิ่มส่วนเนื้อหา (เปิดจากปุ่มด้านบน) ── *}
    <div id="addSectionPanel" class="ai-draft-form add-section-panel reveal-panel" hidden>
        <div class="ai-draft-form-head" style="margin-bottom:12px">
            <div class="step-label">เพิ่มส่วนเนื้อหา</div>
            <button type="button" class="btn btn-sm btn-ghost" data-reveal="addSectionPanel">ปิด</button>
        </div>
        <div class="tabs" style="margin-bottom:16px" id="sectionTypeTabs">
            <a class="tab is-active" data-section-tab="text" href="#"><span class="msi">article</span>ข้อความ</a>
            <a class="tab" data-section-tab="video" href="#"><span class="msi">smart_display</span>วีดิโอ</a>
            <a class="tab" data-section-tab="pdf" href="#"><span class="msi">picture_as_pdf</span>PDF</a>
        </div>

        {* TEXT *}
        <form method="post" action="{$base}/courses/{$course['id']}/units/{$unit['id']}/sections"
              id="sectionForm-text" class="section-form">
            <input type="hidden" name="_token" value="{$csrf}">
            <input type="hidden" name="type" value="text">
            <div class="field">
                <label>ชื่อส่วน (ไม่บังคับ)</label>
                <input class="input" type="text" name="title" placeholder="เช่น บทนำ, ทฤษฎีพื้นฐาน">
            </div>
            <div class="field">
                <label>เนื้อหา</label>
                <textarea class="input" name="content" rows="6" placeholder="พิมพ์เนื้อหาที่นี่..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">เพิ่มส่วนข้อความ</button>
        </form>

        {* VIDEO *}
        <form method="post" action="{$base}/courses/{$course['id']}/units/{$unit['id']}/sections"
              id="sectionForm-video" class="section-form" hidden>
            <input type="hidden" name="_token" value="{$csrf}">
            <input type="hidden" name="type" value="video">
            <div class="field">
                <label>ชื่อส่วน (ไม่บังคับ)</label>
                <input class="input" type="text" name="title" placeholder="เช่น วีดิโอแนะนำ">
            </div>
            <div class="field">
                <label>URL วีดิโอ <span class="required">*</span></label>
                <input class="input" type="url" name="video_url"
                       placeholder="https://www.youtube.com/watch?v=..." required>
                <div class="hint">รองรับ YouTube, Google Drive และลิงก์วีดิโอทั่วไป</div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">เพิ่มส่วนวีดิโอ</button>
        </form>

        {* PDF *}
        <form method="post" action="{$base}/courses/{$course['id']}/units/{$unit['id']}/sections"
              enctype="multipart/form-data" id="sectionForm-pdf" class="section-form" hidden>
            <input type="hidden" name="_token" value="{$csrf}">
            <input type="hidden" name="type" value="pdf">
            <div class="field">
                <label>ชื่อส่วน (ไม่บังคับ)</label>
                <input class="input" type="text" name="title" placeholder="เช่น ใบความรู้ที่ 1">
            </div>
            <div class="field">
                <label>ไฟล์ PDF <span class="required">*</span></label>
                <input class="input" type="file" name="pdf_file" accept=".pdf,application/pdf" required>
                <div class="hint">ขนาดไม่เกิน 30 MB</div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">อัปโหลด PDF</button>
        </form>
    </div>
</div>

{/if}

{* ── องค์ประกอบของหน่วย: แบบทดสอบก่อนเรียน · ใบงาน · แบบทดสอบหลังเรียน (หน่วยสอบมีแต่แบบทดสอบ)
   แสดงของที่สร้างแล้วจริง พร้อมเครื่องหมาย ✓ / ยังไม่มี ให้ครูเห็นทันทีว่าหน่วยนี้ครบหรือยัง *}
{var $quizBase = $base . '/courses/' . $course['id'] . '/quizzes'}
<div class="card">
    <div class="card-head">{$isExam ? 'แบบทดสอบของหน่วยสอบ' : 'แบบทดสอบและใบงาน'}</div>
    <div class="parts">
        {if !$isExam}
            {include partQuizzes, title: 'แบบทดสอบก่อนเรียน', hint: 'ไม่คิดคะแนน ใช้วัดความก้าวหน้า', items: $pretests, kindKey: 'pretest', quizBase: $quizBase}

            <div n:class="part, $assignments ? is-done : is-missing">
                <div class="part-head">
                    <span class="part-mark" aria-hidden="true">{$assignments ? '✓' : ''}</span>
                    <div class="part-main">
                        <div class="part-title">ใบงาน</div>
                        <div class="part-meta">
                            {if $assignments}มอบหมายไว้แล้ว {count($assignments)} ใบงาน{else}ยังไม่มีใบงาน · ให้ AI ช่วยร่างได้{/if}
                        </div>
                    </div>
                    <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/units/{$unit['id']}/assignments/new">+ เพิ่มใบงาน</a>
                </div>
                {foreach $assignments as $a}
                    <div class="part-item">
                        <div class="part-main">
                            <div class="part-item-title">{$a['title']}</div>
                            <div class="part-meta">
                                เต็ม {(float) $a['max_score']} คะแนน
                                {if $a['due_at']} · กำหนดส่ง {App\Support\Thai::dateTime($a['due_at'])}{/if}
                                {if $a['submission_count'] > 0} · ส่งแล้ว {$a['submission_count']} คน{/if}
                            </div>
                        </div>
                        <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/assignments/{$a['id']}/submissions">งานที่ส่ง ({$a['submission_count']})</a>
                        <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/units/{$unit['id']}/assignments/{$a['id']}/edit">แก้ไข</a>
                    </div>
                {/foreach}
            </div>

            {include partQuizzes, title: 'แบบทดสอบหลังเรียน', hint: 'คิดคะแนนเปรียบเทียบกับเกณฑ์รายวิชา', items: $posttests, kindKey: 'posttest', quizBase: $quizBase}
        {else}
            {include partQuizzes, title: 'แบบทดสอบ' . $kinds[$kind], hint: 'คิดคะแนน · ออกข้อสอบครอบคลุมหน่วยการเรียนก่อนหน้า', items: $posttests, kindKey: 'posttest', quizBase: $quizBase}
        {/if}
    </div>
</div>


{* ── บันทึกหลังการจัดการเรียนรู้ (ข้อ 9 ของแผนการสอน) — กรอกหลังสอนจบหน่วย พิมพ์ลงแผนพร้อมวันที่บันทึก
   การ์ดแสดงสรุปสิ่งที่บันทึกไว้ · ปุ่ม "บันทึกหลังสอน" เปิดแบบฟอร์มใน modal (ลิงก์ #report-form เปิดให้ทันที) ── *}
{if !$isExam}
{var $reportFields = ['plan_result' => '9.1 ผลการใช้แผนการจัดการเรียนรู้', 'learner_result' => '9.2 ผลการเรียนรู้ของผู้เรียน', 'problems' => '9.3 ปัญหาที่พบและแนวทางแก้ไข']}
<div class="card" id="report" style="margin-top:16px">
    <div class="report-card-head">
        <div class="grow">
            <div class="card-head" style="margin-bottom:4px">บันทึกหลังการจัดการเรียนรู้</div>
            <div class="hint">
                {if $report}บันทึกไว้เมื่อ {App\Support\Thai::date($report['recorded_on'] ?? $report['updated_at'])} · {else}ยังไม่ได้บันทึก · {/if}กรอกหลังสอนหน่วยนี้จบ จะพิมพ์ลงข้อ 9 ของแผนการสอนหน่วยนี้
            </div>
        </div>
        <button type="button" n:class="btn, !$report ? btn-primary" data-open-report>
            <span class="msi">edit_note</span> {$report ? 'แก้ไขบันทึกหลังสอน' : 'บันทึกหลังสอน'}
        </button>
    </div>
    {if $report}
        <dl class="report-body" style="padding:4px 0 0">
            {foreach $reportFields as $field => $label}
                <dt>{$label}</dt>
                <dd n:class="!$report[$field] ? muted">{$report[$field] ?: 'ยังไม่ได้กรอก'}</dd>
            {/foreach}
        </dl>
    {/if}
</div>

<div class="modal-backdrop" id="reportModal" hidden>
    <div class="modal-panel report-modal" role="dialog" aria-modal="true" aria-labelledby="reportModalTitle">
        <div class="modal-head">
            <div class="grow">
                <div class="modal-title" id="reportModalTitle">บันทึกหลังการจัดการเรียนรู้</div>
                <div class="hint">{$unit['title']}</div>
            </div>
            <button type="button" class="icon-btn" data-close-report aria-label="ปิด">✕</button>
        </div>
        <form method="post" action="{$base}/courses/{$course['id']}/units/{$unit['id']}/report" class="modal-body" id="reportForm">
            <input type="hidden" name="_token" value="{$csrf}">
            <div class="field">
                <label for="planResult">{$reportFields['plan_result']}</label>
                <textarea class="input" id="planResult" name="plan_result" rows="3" maxlength="5000"
                          placeholder="เช่น จัดกิจกรรมได้ครบตามแผน ใช้เวลามากกว่าที่วางไว้ในขั้นฝึกปฏิบัติ">{$report['plan_result'] ?? ''}</textarea>
            </div>
            <div class="field">
                <label for="learnerResult">{$reportFields['learner_result']}</label>
                <textarea class="input" id="learnerResult" name="learner_result" rows="3" maxlength="5000"
                          placeholder="เช่น ผู้เรียนส่วนใหญ่ผ่านเกณฑ์ ปฏิบัติงานตามใบงานได้ถูกต้อง">{$report['learner_result'] ?? ''}</textarea>
                {if $learnerSummary}
                    <div class="hint" style="display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap;margin-top:6px">
                        <span style="flex:1 1 260px;white-space:pre-line">ผลจากระบบ: {$learnerSummary}</span>
                        <button type="button" class="btn btn-sm" id="useSummary" data-summary="{$learnerSummary}">ใส่ผลจากระบบ</button>
                    </div>
                {/if}
            </div>
            <div class="field">
                <label for="problems">{$reportFields['problems']}</label>
                <textarea class="input" id="problems" name="problems" rows="3" maxlength="5000"
                          placeholder="เช่น ผู้เรียนบางคนยังใช้โปรแกรมไม่คล่อง — จัดกลุ่มเพื่อนช่วยเพื่อนและสอนเสริมนอกเวลา">{$report['problems'] ?? ''}</textarea>
            </div>
            <div class="field" style="max-width:240px;margin-bottom:0">
                <label for="recordedOn">วันที่บันทึก</label>
                <input class="input" type="date" id="recordedOn" name="recorded_on" value="{$report['recorded_on'] ?? date('Y-m-d')}">
            </div>
        </form>
        <div class="modal-foot">
            <button type="button" class="btn" data-close-report>ยกเลิก</button>
            <div class="grow"></div>
            <button type="submit" form="reportForm" class="btn btn-primary">บันทึกหลังสอน</button>
        </div>
    </div>
</div>
{/if}
{/if}

{define partQuizzes}
    <div n:class="part, $items ? is-done : is-missing">
        <div class="part-head">
            <span class="part-mark" aria-hidden="true">{$items ? '✓' : ''}</span>
            <div class="part-main">
                <div class="part-title">{$title}</div>
                <div class="part-meta">{if $items}{count($items)} ฉบับ · {$hint}{else}ยังไม่ได้สร้าง · {$hint}{/if}</div>
            </div>
            <a class="btn btn-sm" href="{$quizBase}/create?unit_id={$unit['id']}&kind={$kindKey}">✦ สร้างด้วย AI</a>
        </div>
        {foreach $items as $q}
            <div class="part-item">
                <div class="part-main">
                    <div class="part-item-title">{$q['title']}</div>
                    <div class="part-meta">
                        {$q['question_count']} ข้อ
                        {if $q['submitted_count'] > 0} · ทำแล้ว {$q['submitted_count']} คน{/if}
                    </div>
                </div>
                {if $q['review_status'] === 'published'}<span class="tag tag-ok">เผยแพร่แล้ว</span>
                {elseif $q['review_status'] === 'pending'}<span class="tag tag-warn">รอตรวจ</span>
                {else}<span class="tag">ฉบับร่าง</span>{/if}
                <a class="btn btn-sm" href="{$quizBase}/{$q['id']}/review">เปิดดู</a>
            </div>
        {/foreach}
    </div>
{/define}

<script>
(function () {
    // ปุ่มเปิด/ปิดฟอร์ม: data-reveal="id ของฟอร์ม"
    document.querySelectorAll('[data-reveal]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var box = document.getElementById(btn.getAttribute('data-reveal'));
            if (!box) return;
            var open = box.hidden;
            // เปิดได้ทีละแผง · ระหว่างเปิดซ่อนแถบปุ่มไว้ กด "ปิด" แล้วแถบปุ่มกลับมา
            document.querySelectorAll('.reveal-panel').forEach(function (p) { p.hidden = true; });
            box.hidden = !open;
            var tools = document.getElementById('contentTools');
            if (tools) tools.hidden = open;
            document.querySelectorAll('[data-reveal]').forEach(function (b) {
                var target = document.getElementById(b.getAttribute('data-reveal'));
                b.setAttribute('aria-expanded', target && !target.hidden ? 'true' : 'false');
            });
            if (open) {
                var field = box.querySelector('textarea, input[type=text]');
                if (field) field.focus();
            }
        });
    });

    // เปลี่ยนประเภทหน่วย: หน่วยสอบซ่อนจุดประสงค์/สมรรถนะ และเปลี่ยนสาระสำคัญเป็นคำชี้แจงการสอบ
    var kind = document.getElementById('kind');
    if (kind) {
        kind.addEventListener('change', function () {
            var exam = kind.value !== 'lesson';
            document.querySelectorAll('[data-lesson-only]').forEach(function (el) { el.hidden = exam; });
            document.querySelectorAll('[data-exam-only]').forEach(function (el) { el.hidden = !exam; });
            var label = document.querySelector('[data-label-lesson]');
            var area = document.getElementById('key_content');
            if (label) label.textContent = label.getAttribute(exam ? 'data-label-exam' : 'data-label-lesson');
            if (area) area.placeholder = area.getAttribute(exam ? 'data-ph-exam' : 'data-ph-lesson');
        });
    }
})();

(function () {
    // แบบฟอร์มบันทึกหลังสอนใน modal: เปิดจากปุ่ม หรือเมื่อเข้าหน้านี้ด้วย #report-form (ลิงก์จากแท็บบันทึกหลังสอน)
    var modal = document.getElementById('reportModal');
    if (!modal) return;
    function open() {
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        document.getElementById('planResult').focus();
    }
    function close() {
        modal.hidden = true;
        document.body.style.overflow = '';
    }
    document.querySelectorAll('[data-open-report]').forEach(function (b) { b.addEventListener('click', open); });
    modal.querySelectorAll('[data-close-report]').forEach(function (b) { b.addEventListener('click', close); });
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
    if (location.hash === '#report-form') {
        document.getElementById('report').scrollIntoView();
        open();
    }

    // ใส่สรุปผลแบบทดสอบจากระบบลงข้อ 9.2 (ต่อท้ายถ้าครูพิมพ์ไว้แล้ว)
    var btn = document.getElementById('useSummary');
    var area = document.getElementById('learnerResult');
    if (!btn || !area) return;
    btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-summary');
        if (area.value.indexOf(text) === -1) {
            area.value = area.value.trim() ? area.value.trim() + '\n' + text : text;
        }
        area.focus();
    });
})();

(function () {
    var tabs = document.querySelectorAll('[data-section-tab]');
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function (e) {
            e.preventDefault();
            var type = this.getAttribute('data-section-tab');
            tabs.forEach(function (t) { t.classList.remove('is-active'); });
            this.classList.add('is-active');
            document.querySelectorAll('.section-form').forEach(function (f) { f.hidden = true; });
            var form = document.getElementById('sectionForm-' + type);
            if (form) form.hidden = false;
        });
    });
})();
</script>
{/block}
