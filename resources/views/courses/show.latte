{layout '../layout.latte'}

{block title}{$course['name']}{/block}

{block content}
<div class="course-page">
    <div class="course-header">
        <div class="course-header-inner">
            <div class="course-head-top">
                <div class="course-head-info course-banner" style="--cc:#{$course['color']};--ca:#{$course['accent']}">
                    {* ชั้นพื้นหลัง (รูปปก + วงแสง) ตัดขอบแยกไว้ — แบนเนอร์เองไม่ตัด เมนู AI จึงยื่นออกนอกแบนเนอร์ได้ *}
                    <div class="banner-bg" aria-hidden="true">
                        {if $course['cover_url']}<img class="cover-img" src="{$course['cover_url']}" alt="">{/if}
                    </div>
                    <div class="course-head-code">{$course['code']} · {$course['classroom_name'] ?? 'ยังไม่ระบุกลุ่มเรียน'}</div>
                    <h1>{$course['name']}</h1>
                    <div class="course-head-stats">
                        {$course['student_count']} นักเรียน · {$course['unit_count']} หน่วยการเรียน
                    </div>
                    <div class="banner-actions">
                        <a class="btn btn-icon-text" href="{$base}/courses/{$course['id']}/edit"><span class="msi" aria-hidden="true">edit</span>แก้ไขรายวิชา</a>
                        <a class="btn btn-icon-text" href="{$base}/courses/{$course['id']}/preview" title="เปิดดูรายวิชานี้แบบที่นักเรียนเห็น"><span class="msi" aria-hidden="true">visibility</span>มุมมองนักเรียน</a>
                        <a class="btn btn-icon-text" href="{$base}/courses/{$course['id']}/plan-print" target="_blank"><span class="msi" aria-hidden="true">print</span>พิมพ์แผนการสอน</a>
                        {if $course['ai_quiz_enabled'] || $course['ai_lesson_plan_enabled']}
                            <div class="ai-menu" data-ai-menu>
                                <button type="button" class="btn btn-ai" data-ai-toggle>
                                    <span>✦</span> ให้ AI ช่วย <span class="caret">▾</span>
                                </button>
                                <div class="ai-menu-panel" hidden>
                                    {if $course['ai_quiz_enabled']}
                                        <a href="{$base}/courses/{$course['id']}/quizzes/create">
                                            <div class="t">ออกข้อสอบจากหน่วยการเรียน</div>
                                            <div class="d">เลือกหน่วยแล้วให้ร่างข้อสอบให้</div>
                                        </a>
                                    {/if}
                                    {if $course['ai_lesson_plan_enabled']}
                                        <a href="{$base}/courses/{$course['id']}/lesson-plan">
                                            <div class="t">ทำแผนการจัดการเรียนรู้</div>
                                            <div class="d">ร่างตามแบบฟอร์ม สอศ.</div>
                                        </a>
                                    {/if}
                                    <div class="ai-menu-note">ผลลัพธ์ทุกชิ้นจะอยู่ในสถานะรอครูตรวจก่อนเผยแพร่</div>
                                </div>
                            </div>
                        {/if}
                    </div>
                </div>
            </div>

            <div class="tabs">
                {var $tabs = ['units' => ['หน่วยการเรียน', 'library_books'], 'feed' => ['ประกาศ', 'campaign'], 'quizzes' => ['แบบทดสอบ', 'quiz'], 'worksheets' => ['ใบงาน', 'description'], 'tasks' => ['งานที่มอบหมาย', 'assignment'], 'students' => ['นักเรียน', 'group'], 'scores' => ['คะแนน', 'leaderboard'], 'reports' => ['บันทึกหลังสอน', 'edit_note']]}
                {foreach $tabs as $key => [$label, $icon]}
                    <a href="{$base}/courses/{$course['id']}?tab={$key}" n:class="tab, $tab === $key ? is-active"><span class="msi">{$icon}</span>{$label}</a>
                {/foreach}
            </div>
        </div>
    </div>

    <div class="course-body">
        {if $tab === 'units'}
            <div class="list">
                {foreach $units as $u}
                    {* หน่วยที่นักเรียนยังมองไม่เห็น (ร่าง/รอตรวจ) แสดงแบบจาง · หน่วยที่เผยแพร่แล้วเด่นกว่า *}
                    <div n:class="list-row, $u['review_status'] === 'published' ? is-published : is-draft, $u['is_exam'] ? is-exam">
                        <div class="list-no">{$u['no']}</div>
                        <div class="list-main">
                            <div class="list-title">{$u['title']}</div>
                            <div class="list-meta">{$u['meta']}</div>
                        </div>
                        <span class="tag tag-{$u['tag_kind']}">{$u['tag']}</span>
                        <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/units/{$u['id']}/edit">แก้ไข</a>
                    </div>
                {/foreach}
                {if !$units}<div class="empty"><h3>ยังไม่มีหน่วยการเรียน</h3><p>กดปุ่มด้านล่างเพื่อเพิ่มหน่วยการเรียนแรก</p></div>{/if}
            </div>
            <div class="list-actions">
                <a class="btn" href="{$base}/courses/{$course['id']}/units/new">+ เพิ่มหน่วยการเรียน</a>
                <a class="btn" href="{$base}/courses/{$course['id']}/units/new?kind=midterm">+ หน่วยสอบกลางภาค</a>
                <a class="btn" href="{$base}/courses/{$course['id']}/units/new?kind=final">+ หน่วยสอบปลายภาค</a>
                {if $course['ai_lesson_plan_enabled']}
                    <a class="btn" href="{$base}/courses/{$course['id']}/units/design">✦ ให้ AI ออกแบบรายชื่อหน่วย</a>
                {/if}
            </div>

        {elseif $tab === 'feed'}
            {* ประกาศข่าวสารถึงนักเรียนทั้งรายวิชา (CourseFeedController) · นักเรียนเห็นที่หน้า /learn/{id} · ข้อความถึงรายคนอยู่ที่ /messages *}
            {if !$feedReady}
                <div class="alert alert-error">ระบบประกาศยังไม่พร้อม — ผู้ดูแลระบบต้องปรับฐานข้อมูล (000130) ที่หน้าฐานข้อมูลก่อน</div>
            {else}
                <form class="card feed-compose" method="post" action="{$base}/courses/{$course['id']}/posts">
                    <input type="hidden" name="_token" value="{$csrf}">
                    <h2>ประกาศถึงนักเรียนทั้งรายวิชา</h2>
                    <div class="card-sub">
                        นักเรียน {$course['student_count']} คนในรายวิชาจะเห็นประกาศที่หน้ารายวิชา พร้อมป้าย "ใหม่"
                        · ถ้าต้องการคุยกับนักเรียนเป็นรายคน ใช้ <a href="{$base}/messages?course={$course['id']}">ข้อความส่วนตัว</a>
                    </div>
                    <textarea class="input feed-input" name="body" rows="4" required maxlength="{App\Domain\CourseFeedRepository::MAX_BODY}"
                              placeholder="เช่น สัปดาห์หน้างดเรียนวันอังคาร ให้ทำใบงานที่ 3 ส่งในระบบแทน · วางลิงก์ได้ นักเรียนกดเปิดได้ทันที"></textarea>
                    <div class="feed-compose-foot">
                        <label class="check-row">
                            <input type="checkbox" name="pinned" value="1">
                            <span>ปักหมุดไว้บนสุด</span>
                        </label>
                        <button class="btn btn-primary" type="submit"><span class="msi" aria-hidden="true">campaign</span>ประกาศ</button>
                    </div>
                </form>

                {foreach $posts as $p}
                    <article n:class="card, feed-post, $p['pinned'] ? is-pinned">
                        <header class="feed-post-head">
                            <div class="mini-avatar">{App\Support\Thai::initials($p['author_name'] ?? '?')}</div>
                            <div class="grow">
                                <div class="feed-author">{$p['author_name'] ?? 'ครูผู้สอน'}</div>
                                <div class="hint">{App\Support\Thai::dateTime($p['created_at'])}{if $p['updated_at']} · แก้ไขแล้ว{/if}</div>
                            </div>
                            {if $p['pinned']}<span class="chip chip-ok"><span class="msi" aria-hidden="true">push_pin</span>ปักหมุด</span>{/if}
                        </header>
                        <div class="feed-body" data-feed-view>{App\Support\RichText::render($p['body'])}</div>
                        <form class="feed-edit" method="post" action="{$base}/courses/{$course['id']}/posts/{$p['id']}" data-feed-form hidden>
                            <input type="hidden" name="_token" value="{$csrf}">
                            <textarea class="input feed-input" name="body" rows="4" required maxlength="{App\Domain\CourseFeedRepository::MAX_BODY}">{$p['body']}</textarea>
                            <div class="feed-compose-foot">
                                <button type="button" class="btn btn-sm" data-feed-cancel>ยกเลิก</button>
                                <button class="btn btn-sm btn-primary" type="submit">บันทึกการแก้ไข</button>
                            </div>
                        </form>
                        <footer class="feed-post-foot">
                            <span class="hint feed-seen" title="นับนักเรียนที่เปิดหน้ารายวิชาหลังประกาศนี้">
                                <span class="msi" aria-hidden="true">visibility</span>เห็นแล้ว {$seenCounts[(int) $p['id']] ?? 0} จาก {$course['student_count']} คน
                            </span>
                            <span class="grow"></span>
                            <button type="button" class="btn btn-sm" data-feed-edit><span class="msi" aria-hidden="true">edit</span>แก้ไข</button>
                            <form method="post" action="{$base}/courses/{$course['id']}/posts/{$p['id']}/pin">
                                <input type="hidden" name="_token" value="{$csrf}">
                                <input type="hidden" name="pinned" value="{$p['pinned'] ? 0 : 1}">
                                <button class="btn btn-sm" type="submit"><span class="msi" aria-hidden="true">push_pin</span>{$p['pinned'] ? 'เลิกปักหมุด' : 'ปักหมุด'}</button>
                            </form>
                            <form method="post" action="{$base}/courses/{$course['id']}/posts/{$p['id']}/delete"
                                  data-confirm-title="ลบประกาศ" data-confirm-ok="ลบประกาศ" data-confirm-danger
                                  data-confirm="นักเรียนจะไม่เห็นประกาศนี้อีก และกู้คืนไม่ได้">
                                <input type="hidden" name="_token" value="{$csrf}">
                                <button class="btn btn-sm btn-danger" type="submit"><span class="msi" aria-hidden="true">delete</span>ลบ</button>
                            </form>
                        </footer>
                    </article>
                {/foreach}
                {if !$posts}
                    <div class="empty"><h3>ยังไม่มีประกาศ</h3><p>แจ้งข่าวสาร กำหนดส่งงาน หรือเปลี่ยนแปลงตารางเรียนให้นักเรียนทั้งรายวิชาทราบได้จากช่องด้านบน</p></div>
                {/if}
            {/if}

        {elseif $tab === 'quizzes'}
            {* จัดกลุ่มตามหน่วย · ไอคอน/สีแยกก่อนเรียน (ฟ้า) หลังเรียน (เขียว) และข้อสอบของหน่วยสอบ (ม่วง) *}
            {foreach $quizGroups as $g}
                <div class="list quiz-group">
                    <div class="quiz-group-head">
                        {if $g['no'] !== null}<span n:class="quiz-group-no, $g['is_exam'] ? is-exam">{$g['no']}</span>{/if}
                        <span class="quiz-group-title">{$g['no'] === null || $g['is_exam'] ? '' : 'หน่วยที่ ' . ltrim($g['no'], '0') . ' · '}{$g['title']}</span>
                        <span class="quiz-group-count">{count($g['quizzes'])} ชุด</span>
                    </div>
                    {foreach $g['quizzes'] as $q}
                        {var $qk = $g['is_exam'] ? 'exam' : ($q['kind'] === 'pretest' ? 'pre' : 'post')}
                        <div class="list-row">
                            <span class="quiz-kind-icon quiz-kind-{$qk}" aria-hidden="true">
                                <span class="msi">{$qk === 'exam' ? 'edit_note' : ($qk === 'pre' ? 'flag' : 'task_alt')}</span>
                            </span>
                            <div class="list-main">
                                <div class="list-title">{$q['title']}</div>
                                <div class="list-meta">
                                    <span class="quiz-kind-label quiz-kind-{$qk}">{$qk === 'exam' ? 'ข้อสอบ' : ($qk === 'pre' ? 'ก่อนเรียน' : 'หลังเรียน')}</span>
                                    · {$q['question_count']} ข้อ
                                    {if $q['submitted_count'] > 0} · ส่งแล้ว {$q['submitted_count']} คน{/if}
                                </div>
                            </div>
                            {if $q['review_status'] === 'published'}<span class="tag tag-ok">เผยแพร่แล้ว</span>
                            {elseif $q['review_status'] === 'pending'}<span class="tag tag-warn">รอตรวจ</span>
                            {else}<span class="tag">ฉบับร่าง</span>{/if}
                            <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/quizzes/{$q['id']}/review">เปิดดู</a>
                            <form method="post" action="{$base}/courses/{$course['id']}/quizzes/{$q['id']}/delete"
                                  data-confirm-title="ย้ายไปถังขยะ" data-confirm-ok="ย้ายไปถังขยะ" data-confirm-danger
                                  data-confirm="ย้าย &quot;{$q['title']}&quot; ไปที่ถังขยะใช่หรือไม่ · นักเรียนจะมองไม่เห็นชุดนี้ทันที{$q['submitted_count'] > 0 ? ' และผลสอบของนักเรียน ' . $q['submitted_count'] . ' คนจะถูกซ่อนจากหน้าคะแนน' : ''} · กู้คืนได้ภายใน {App\Domain\QuizRepository::TRASH_DAYS} วัน ก่อนถูกลบถาวร (ดูได้ที่เมนูถังขยะ)">
                                <input type="hidden" name="_token" value="{$csrf}">
                                <button type="submit" class="btn btn-sm btn-danger">ลบ</button>
                            </form>
                        </div>
                    {/foreach}
                </div>
            {/foreach}
            {if !$quizGroups}
                <div class="list">
                    <div class="empty">
                        <h3>ยังไม่มีแบบทดสอบในรายวิชานี้</h3>
                        <p>แบบทดสอบที่สร้างด้วยผู้ช่วย AI ทุกฉบับจะมาอยู่ที่นี่ ทั้งฉบับร่างและที่เผยแพร่แล้ว</p>
                    </div>
                </div>
            {/if}
            {if $course['ai_quiz_enabled']}
                <div class="list-actions">
                    <a class="btn" href="{$base}/courses/{$course['id']}/quizzes/create">✦ สร้างแบบทดสอบด้วย AI</a>
                </div>
            {/if}

        {elseif $tab === 'worksheets'}
            {* ใบงานของทุกหน่วย เรียงตามหน่วย · เพิ่มใบงานได้จากหน่วยที่ต้องการ *}
            <div class="list">
                {foreach $worksheets as $a}
                    <div class="list-row">
                        <div class="list-main">
                            <div class="list-title">{$a['title']}</div>
                            <div class="list-meta">
                                {$a['unit_title'] ?? 'ไม่ได้ผูกกับหน่วย'}
                                · เต็ม {(float) $a['max_score']} คะแนน
                                {if $a['due_at']} · กำหนดส่ง {App\Support\Thai::dateTime($a['due_at'])}{/if}
                                {if $a['submission_count'] > 0} · ส่งแล้ว {$a['submission_count']} คน{/if}
                            </div>
                        </div>
                        <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/assignments/{$a['id']}/submissions">งานที่ส่ง ({$a['submission_count']})</a>
                        {if $a['unit_id']}
                            <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/units/{$a['unit_id']}/assignments/{$a['id']}/edit">แก้ไข</a>
                        {/if}
                    </div>
                {/foreach}
                {if !$worksheets}
                    <div class="empty">
                        <h3>ยังไม่มีใบงานในรายวิชานี้</h3>
                        <p>ใบงานเป็นส่วนหนึ่งของหน่วยการเรียน · เลือกหน่วยด้านล่างเพื่อเพิ่มใบงาน ให้ AI ช่วยร่างได้</p>
                    </div>
                {/if}
            </div>
            {if $lessonUnits}
                <form class="list-actions" method="get" onsubmit="if (this.unit.value) location.href = this.unit.value; return false;">
                    <select class="input" name="unit" aria-label="เลือกหน่วยการเรียนที่จะเพิ่มใบงาน" style="max-width:420px">
                        {foreach $lessonUnits as $u}
                            <option value="{$base}/courses/{$course['id']}/units/{$u['id']}/assignments/new">หน่วยที่ {$iterator->counter} · {$u['title']}</option>
                        {/foreach}
                    </select>
                    <button type="submit" class="btn">+ เพิ่มใบงานในหน่วยนี้</button>
                </form>
            {/if}

        {elseif $tab === 'tasks'}
            {* งานที่ครูมอบหมายเพิ่มเติมนอกเหนือจากใบงานของหน่วย เช่น รายงาน โครงงาน งานค้นคว้า *}
            <div class="list">
                {foreach $tasks as $a}
                    <div class="list-row">
                        <div class="list-main">
                            <div class="list-title">{$a['title']}</div>
                            <div class="list-meta">
                                {$a['unit_title'] ?? 'ทั้งรายวิชา'}
                                · เต็ม {(float) $a['max_score']} คะแนน
                                {if $a['due_at']} · กำหนดส่ง {App\Support\Thai::dateTime($a['due_at'])}{else} · ไม่กำหนดวันส่ง{/if}
                                {if $a['submission_count'] > 0} · ส่งแล้ว {$a['submission_count']} คน{/if}
                            </div>
                        </div>
                        <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/assignments/{$a['id']}/submissions">งานที่ส่ง ({$a['submission_count']})</a>
                        <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/tasks/{$a['id']}/edit">แก้ไข</a>
                    </div>
                {/foreach}
                {if !$tasks}
                    <div class="empty">
                        <h3>ยังไม่มีงานที่มอบหมาย</h3>
                        <p>มอบหมายงานเพิ่มเติมนอกเหนือจากใบงานของหน่วยได้ที่นี่ เช่น รายงาน โครงงาน หรืองานค้นคว้า</p>
                    </div>
                {/if}
            </div>
            <div class="list-actions">
                <a class="btn" href="{$base}/courses/{$course['id']}/tasks/new">+ มอบหมายงาน</a>
            </div>

        {elseif $tab === 'students'}
            <div class="card join-invite">
                <div class="join-invite-head">
                    <div>
                        <h2>ให้นักเรียนเข้าร่วมรายวิชาเอง</h2>
                        <div class="card-sub">
                            {if $course['join_enabled']}
                                แจกรหัสหรือลิงก์นี้ นักเรียนเข้าสู่ระบบแล้วกรอกรหัส หรือเปิดลิงก์ ก็เข้ารายวิชาได้ทันที
                            {else}
                                ปิดการเข้าร่วมอยู่ · รหัสและลิงก์ใช้ไม่ได้จนกว่าจะเปิดอีกครั้ง
                            {/if}
                        </div>
                    </div>
                    <form method="post" action="{$base}/courses/{$course['id']}/join">
                        <input type="hidden" name="_token" value="{$csrf}">
                        {if $course['join_enabled']}
                            <button class="btn btn-sm" name="do" value="close">ปิดการเข้าร่วม</button>
                        {else}
                            <button class="btn btn-sm btn-primary" name="do" value="open">เปิดการเข้าร่วม</button>
                        {/if}
                    </form>
                </div>

                <div n:class="join-invite-body, !$course['join_enabled'] ? is-off">
                    <div class="join-invite-code">
                        <div class="join-label">รหัสเข้าร่วม</div>
                        <div class="join-code mono">{$joinCode}</div>
                        <div class="join-invite-actions">
                            <button type="button" class="btn btn-sm" data-copy="{$joinCode}">คัดลอกรหัส</button>
                            <button type="button" class="btn btn-sm" data-present="code" title="แสดงรหัสเต็มหน้าจอสำหรับฉายบนโปรเจกเตอร์">
                                <span class="msi" aria-hidden="true">fullscreen</span>ขยายรหัส
                            </button>
                        </div>
                    </div>
                    <div class="join-invite-link">
                        <div class="join-label">ลิงก์เข้าร่วม</div>
                        <input class="input mono" value="{$joinUrl}" readonly onfocus="this.select()">
                        <div class="join-invite-actions">
                            <button type="button" class="btn btn-sm" data-copy="{$joinUrl}">คัดลอกลิงก์</button>
                            <button type="button" class="btn btn-sm" data-present="qr" title="แสดง QR Code ลิงก์เข้าร่วมเต็มหน้าจอ ให้นักเรียนสแกนด้วยมือถือ">
                                <span class="msi" aria-hidden="true">qr_code_2</span>QR Code เต็มจอ
                            </button>
                            <form method="post" action="{$base}/courses/{$course['id']}/join"
                                  data-confirm-title="สร้างรหัสใหม่" data-confirm-ok="สร้างรหัสใหม่" data-confirm-danger
                                  data-confirm="รหัสและลิงก์เดิมจะใช้ไม่ได้ทันที · นักเรียนที่เข้าร่วมแล้วยังอยู่ในรายวิชาครบ">
                                <input type="hidden" name="_token" value="{$csrf}">
                                <button class="btn btn-sm" name="do" value="regenerate">สร้างรหัสใหม่</button>
                            </form>
                        </div>
                    </div>
                </div>
                {* ฉายรหัส / QR Code เต็มจอ (public/assets/js/join-present.js) *}
                <div class="join-present" id="joinPresent" hidden role="dialog" aria-modal="true" aria-label="ฉายรหัสเข้าร่วมรายวิชา"
                     data-code="{$joinCode}" data-url="{$joinUrl}">
                    <div class="join-present-bar">
                        <div class="join-present-switch" role="tablist">
                            <button type="button" data-mode="code"><span class="msi" aria-hidden="true">pin</span>รหัส</button>
                            <button type="button" data-mode="qr"><span class="msi" aria-hidden="true">qr_code_2</span>QR Code</button>
                        </div>
                        <button type="button" class="join-present-close" data-present-close title="ปิด (Esc)">
                            <span class="msi" aria-hidden="true">close</span>
                        </button>
                    </div>
                    <div class="join-present-body">
                        <div class="join-present-course">{$course['code']} {$course['name']}</div>
                        <div class="join-present-view" data-view="code">
                            <div class="join-present-hint">เข้าสู่ระบบแล้วกรอกรหัสเข้าร่วมรายวิชา</div>
                            <div class="join-present-code mono">{$joinCode}</div>
                            <div class="join-present-hint join-present-learn"></div>
                        </div>
                        <div class="join-present-view" data-view="qr" hidden>
                            <div class="join-present-hint">สแกนด้วยกล้องมือถือเพื่อเข้าร่วมรายวิชา</div>
                            <div class="join-present-qr" id="joinPresentQr" aria-label="QR Code ลิงก์เข้าร่วมรายวิชา" role="img"></div>
                            <div class="join-present-url mono">{$joinUrl}</div>
                            <div class="join-present-hint">หรือกรอกรหัส <b class="mono">{$joinCode}</b></div>
                        </div>
                        {if !$course['join_enabled']}
                            <div class="join-present-off">ปิดการเข้าร่วมอยู่ · เปิดการเข้าร่วมก่อนให้นักเรียนสแกนหรือกรอกรหัส</div>
                        {/if}
                    </div>
                </div>
            </div>

            <div class="card roster">
                <div class="roster-head">
                    <div>
                        <h2>เพิ่มนักเรียนจากกลุ่มเรียน</h2>
                        <div class="card-sub">เลือกกลุ่มเรียน ติ๊กนักเรียนที่ต้องการแล้วกดเพิ่ม · เพิ่มได้หลายกลุ่ม เปลี่ยนกลุ่มแล้วเพิ่มต่อได้เลย</div>
                    </div>
                    <form method="get" action="{$base}/courses/{$course['id']}" class="roster-pick">
                        <input type="hidden" name="tab" value="students">
                        <select class="input" name="group" data-combo data-combo-placeholder="พิมพ์ชื่อกลุ่ม เช่น ชคพ.1/1"
                                onchange="if (this.value) this.form.submit()">
                            <option value="">— เลือกกลุ่มเรียน —</option>
                            {foreach $classrooms as $r}
                                <option value="{$r['id']}" selected="{$rosterGroup && $rosterGroup['id'] == $r['id']}">
                                    {$r['name']}{if $r['id'] == $course['classroom_id']} (กลุ่มของรายวิชา){/if}
                                </option>
                            {/foreach}
                        </select>
                    </form>
                </div>

                {if $rosterGroup}
                    {if $roster}
                        <form method="post" action="{$base}/courses/{$course['id']}/students/classroom">
                            <input type="hidden" name="_token" value="{$csrf}">
                            <input type="hidden" name="classroom_id" value="{$rosterGroup['id']}">
                            <div class="table-scroll">
                                <table class="data roster-table">
                                    <thead>
                                        <tr>
                                            <th style="width:1%"><input type="checkbox" data-roster-all {if $rosterPending}checked{else}disabled{/if} title="เลือกทั้งหมด"></th>
                                            <th>รหัสนักศึกษา</th><th>ชื่อ-นามสกุล</th><th>อีเมล</th><th>สถานะ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {foreach $roster as $s}
                                            {var $inCourse = in_array($s['enrollment_status'], ['active', 'completed'], true)}
                                            <tr>
                                                <td><input type="checkbox" name="student_ids[]" value="{$s['id']}" data-roster-row {if $inCourse}disabled{else}checked{/if}></td>
                                                <td class="mono">{$s['username']}</td>
                                                <td>{$s['full_name']}</td>
                                                <td class="mono">{$s['email'] ?: '—'}</td>
                                                <td>{if $inCourse}<span class="chip chip-ok">อยู่ในรายวิชาแล้ว</span>{else}<span class="chip chip-muted">ยังไม่ได้เพิ่ม</span>{/if}</td>
                                            </tr>
                                        {/foreach}
                                    </tbody>
                                </table>
                            </div>
                            <div class="add-by-email-foot">
                                <span class="hint">กลุ่ม {$rosterGroup['name']} · {count($roster)} คน · ยังไม่ได้เพิ่ม {$rosterPending} คน</span>
                                <button class="btn btn-primary" type="submit" {if !$rosterPending}disabled{/if}>เพิ่มนักเรียนที่เลือกเข้ารายวิชา</button>
                            </div>
                        </form>
                    {else}
                        <div class="hint" style="margin-top:12px">ไม่พบนักเรียนในกลุ่ม {$rosterGroup['name']} — ผู้ดูแลระบบต้องโอนข้อมูลนักเรียนจาก RMS ก่อน</div>
                    {/if}
                {/if}
            </div>

            <form class="card add-by-email" method="post" action="{$base}/courses/{$course['id']}/students">
                <input type="hidden" name="_token" value="{$csrf}">
                <h2>เพิ่มนักเรียนด้วยอีเมล</h2>
                <div class="card-sub">ใส่อีเมลของนักเรียนที่มีบัญชีในระบบแล้ว ใส่หลายอีเมลได้ คั่นด้วยการขึ้นบรรทัดใหม่ เว้นวรรค หรือจุลภาค</div>
                <textarea class="input add-by-email-input mono" name="emails" rows="3" required
                          placeholder="somchai@rvc.ac.th&#10;suda@rvc.ac.th"></textarea>
                <div class="add-by-email-foot">
                    <span class="hint">ถ้านักเรียนยังไม่มีอีเมลในบัญชี เพิ่มได้ที่เมนู <a href="{$base}/students">นักเรียน</a> หรือให้เข้าร่วมด้วยรหัสด้านบน</span>
                    <button class="btn btn-primary" type="submit">เพิ่มเข้ารายวิชา</button>
                </div>
            </form>

            <div class="list">
                {foreach $students as $s}
                    <div class="list-row">
                        <div class="mini-avatar">{mb_substr($s['full_name'], 0, 2)}</div>
                        <div class="mono list-id">{$s['username']}</div>
                        <div class="list-main">
                            <div class="list-title">{$s['full_name']}</div>
                            {if $s['email']}<div class="hint mono">{$s['email']}</div>{/if}
                        </div>
                        <a class="btn btn-sm" href="{$base}/messages/{$course['id']}/{$s['id']}" title="ส่งข้อความส่วนตัวถึง {$s['full_name']}"><span class="msi" aria-hidden="true">chat</span>ส่งข้อความ</a>
                    </div>
                {/foreach}
                {if !$students}<div class="empty"><h3>ยังไม่มีนักเรียนในรายวิชานี้</h3><p>แจกรหัสหรือลิงก์เข้าร่วมด้านบนให้นักเรียน รายชื่อจะขึ้นที่นี่เมื่อนักเรียนเข้าร่วมแล้ว</p></div>{/if}
            </div>

        {elseif $tab === 'reports'}
            {* บันทึกหลังการจัดการเรียนรู้ของทุกหน่วยรวมไว้ที่เดียว · กรอก/แก้ในหน้าแก้ไขหน่วย (#report) · พิมพ์ลงข้อ 9 ของแผนการสอน *}
            {var $done = count(array_filter($reports, fn ($r) => $r['report'] !== null))}
            <div class="report-summary">
                <span>บันทึกแล้ว <b>{$done}</b> จาก {count($reports)} หน่วย</span>
                <span class="grow"></span>
                <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/plan-print" target="_blank" rel="noopener"><span class="msi">print</span> พิมพ์แผนการสอน</a>
            </div>
            {foreach $reports as $r}
                {var $u = $r['unit']}
                {var $rep = $r['report']}
                <div class="list quiz-group report-group">
                    <div class="quiz-group-head">
                        <span class="quiz-group-no">{sprintf('%02d', $r['no'])}</span>
                        <span class="quiz-group-title">หน่วยที่ {$r['no']} · {$u['title']}</span>
                        {if $rep}
                            <span class="tag tag-ok">บันทึกแล้ว {App\Support\Thai::date($rep['recorded_on'] ?? $rep['updated_at'])}</span>
                        {else}
                            <span class="tag">ยังไม่บันทึก</span>
                        {/if}
                        <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/units/{$u['id']}/edit#report-form">{$rep ? 'แก้ไข' : 'บันทึก'}</a>
                    </div>
                    {if $rep}
                        <dl class="report-body">
                            {foreach ['plan_result' => '9.1 ผลการใช้แผนการจัดการเรียนรู้', 'learner_result' => '9.2 ผลการเรียนรู้ของผู้เรียน', 'problems' => '9.3 ปัญหาที่พบและแนวทางแก้ไข'] as $field => $label}
                                <dt>{$label}</dt>
                                <dd n:class="!$rep[$field] ? muted">{$rep[$field] ?: 'ยังไม่ได้กรอก'}</dd>
                            {/foreach}
                        </dl>
                    {/if}
                </div>
            {/foreach}
            {if !$reports}<div class="empty"><h3>ยังไม่มีหน่วยการเรียน</h3><p>เพิ่มหน่วยการเรียนในแท็บหน่วยการเรียนก่อน แล้วบันทึกหลังสอนเมื่อสอนแต่ละหน่วยจบ</p></div>{/if}

        {else}
            {if $scoreRows}
                <div class="table-scroll">
                    <table class="data score-table">
                        <thead>
                        <tr>
                            <th>นักเรียน</th>
                            {foreach $scoreQuizzes as $q}<th class="num">{$q['title']|truncate:24}</th>{/foreach}
                            <th class="num">รวม</th>
                        </tr>
                        </thead>
                        <tbody>
                        {foreach $scoreRows as $r}
                            <tr>
                                <td>{$r['name']}</td>
                                {foreach $r['cells'] as $c}<td class="num mono">{$c}</td>{/foreach}
                                <td class="num mono" style="color:var(--brand);font-weight:500">{$r['total']}</td>
                            </tr>
                        {/foreach}
                        </tbody>
                    </table>
                </div>
            {else}
                <div class="empty"><h3>ยังไม่มีคะแนน</h3><p>คะแนนจะปรากฏเมื่อมีแบบทดสอบที่เผยแพร่และนักเรียนทำแล้ว</p></div>
            {/if}
        {/if}
    </div>
</div>

<script>
    (function () {
        var menu = document.querySelector('[data-ai-menu]');
        if (!menu) return;
        var toggle = menu.querySelector('[data-ai-toggle]');
        var panel = menu.querySelector('.ai-menu-panel');
        toggle.addEventListener('click', function (e) { e.stopPropagation(); panel.hidden = !panel.hidden; });
        document.addEventListener('click', function () { panel.hidden = true; });
    })();

    // แท็บประกาศ: สลับระหว่างข้อความประกาศกับฟอร์มแก้ไขของประกาศชิ้นนั้น
    document.querySelectorAll('.feed-post').forEach(function (post) {
        var view = post.querySelector('[data-feed-view]');
        var form = post.querySelector('[data-feed-form]');
        var edit = post.querySelector('[data-feed-edit]');
        if (!form || !edit) return;
        var toggle = function (editing) {
            form.hidden = !editing;
            view.hidden = editing;
            edit.hidden = editing;
            if (editing) form.querySelector('textarea').focus();
        };
        edit.addEventListener('click', function () { toggle(true); });
        form.querySelector('[data-feed-cancel]').addEventListener('click', function () { toggle(false); });
    });

    // ปุ่มคัดลอกรหัส/ลิงก์เข้าร่วม
    // ติ๊ก/เอาออกทั้งกลุ่ม — ข้ามคนที่อยู่ในรายวิชาแล้ว (checkbox ถูกปิดไว้)
    var rosterAll = document.querySelector('[data-roster-all]');
    if (rosterAll) {
        var rows = document.querySelectorAll('[data-roster-row]:not(:disabled)');
        rosterAll.addEventListener('change', function () {
            rows.forEach(function (c) { c.checked = rosterAll.checked; });
        });
        rows.forEach(function (c) {
            c.addEventListener('change', function () {
                rosterAll.checked = Array.prototype.every.call(rows, function (x) { return x.checked; });
            });
        });
    }

    document.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var text = btn.getAttribute('data-copy');
            var label = btn.textContent;
            var done = function () {
                btn.textContent = 'คัดลอกแล้ว ✓';
                setTimeout(function () { btn.textContent = label; }, 1600);
            };
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(done);
            } else {
                var t = document.createElement('textarea');
                t.value = text;
                document.body.appendChild(t);
                t.select();
                document.execCommand('copy');
                t.remove();
                done();
            }
        });
    });
</script>
<script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.min.js" defer></script>
<script src="{$base}/assets/js/join-present.js" defer></script>
{/block}
