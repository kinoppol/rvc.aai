{layout '../layout.latte'}

{block title}{$unit['title']}{/block}

{block content}
{var $preview = $preview ?? false}
{var $isExam = App\Domain\UnitRepository::isExam($unit)}
{var $pct = $progress['total'] ? (int) round($progress['done'] * 100 / $progress['total']) : 0}
<div class="learn-page">
    {if $preview}
        {* ครูเปิดดูในมุมมองนักเรียน · ปุ่มทำแบบทดสอบถูกปิดไว้ *}
        <a class="back-link" href="{$base}/courses/{$course['id']}/preview">← กลับไปที่ {$course['name']} (มุมมองนักเรียน)</a>
        <div class="preview-banner">
            <span class="msi" aria-hidden="true">visibility</span>
            <div>
                <b>มุมมองของนักเรียน</b> · หน้านี้คือสิ่งที่นักเรียนจะเห็น ปุ่มทำแบบทดสอบถูกปิดไว้ในโหมดนี้
                {if $unit['review_status'] !== 'published'}<br><span class="preview-warn">หน่วยนี้ยังไม่เผยแพร่ นักเรียนยังมองไม่เห็น</span>{/if}
            </div>
            <a class="btn btn-sm" href="{$base}/courses/{$course['id']}/units/{$unit['id']}/edit">แก้ไขหน่วย</a>
        </div>
    {else}
        <a class="back-link" href="{$base}/learn/{$course['id']}">← กลับไปที่ {$course['name']}</a>
        {if $progress['total'] && $pct === 100}
            <div class="learn-congrats">
                <span class="learn-medal" aria-hidden="true"><span class="msi">emoji_events</span></span>
                <div>
                    <div class="learn-congrats-title">ยอดเยี่ยมมาก {$studentName}</div>
                    <div class="learn-congrats-sub">คุณเรียนครบทุกรายการของ{$unit['kind_label'] ?? 'หน่วยนี้'} แล้ว</div>
                </div>
                <a class="btn btn-sm" href="{$base}/learn/{$course['id']}">ไปหน่วยถัดไป</a>
            </div>
        {/if}
    {/if}

    <section class="learn-hero" style="--cc:#{$course['color']};--ca:#{$course['accent']}">
        <div class="learn-chips">
            <span>{$unit['kind_label'] ?? 'หน่วยการเรียน'}</span>
            <span>{$course['code']} {$course['name']}</span>
        </div>
        <h1>{$unit['title']}</h1>
        <div class="learn-hero-meta">
            <span class="msi" aria-hidden="true">schedule</span>
            {if $progress['minutes']}ประมาณ {$progress['minutes']} นาที · {/if}{count($items)} รายการ
        </div>
        {if $typeCounts}<div class="learn-hero-sub">{$typeCounts}</div>{/if}
        <div class="learn-progress">
            {if $nextItem}
                {var $ctaText = $progress['done'] ? 'เรียนต่อ' : 'เริ่มเรียน'}
                {if $nextItem['kind'] === 'quiz'}
                    {if $preview}
                        <button class="learn-cta" type="button" disabled>{$ctaText}</button>
                    {else}
                        <form method="post" action="{$base}/learn/quizzes/{$nextItem['id']}/start">
                            <input type="hidden" name="_token" value="{$csrf}">
                            <button class="learn-cta" type="submit">{$ctaText}</button>
                        </form>
                    {/if}
                {else}
                    <a class="learn-cta" href="{$base}{$itemBase}/{$nextItem['kind']}/{$nextItem['id']}">{$ctaText}</a>
                {/if}
            {/if}
            <div class="learn-bar" style="--p:{$pct}" role="progressbar" aria-valuenow="{$pct}" aria-valuemin="0" aria-valuemax="100"><span></span></div>
            <b>{$pct}%</b>
        </div>
    </section>

    <section class="learn-card">
        {if $unit['key_content']}
            <h2 class="learn-h">{$isExam ? 'คำชี้แจงการสอบ' : 'สาระสำคัญ'}</h2>
            <p class="learn-text">{$unit['key_content']}</p>
        {/if}
        {if $unit['objectives']}
            <h2 class="learn-h">จุดประสงค์การเรียนรู้</h2>
            <p class="learn-text">{$unit['objectives']}</p>
        {/if}
        {if $unit['competencies']}
            <h2 class="learn-h">สมรรถนะ</h2>
            <p class="learn-text">{$unit['competencies']}</p>
        {/if}

        <h2 class="learn-list-title">{$isExam ? 'การสอบ' : 'เนื้อหาหน่วย'} ({count($items)} รายการ)</h2>
        {if $items}
            <div class="path-list">
                {foreach $items as $it}
                    {include '../_partials/path-row.latte', it: $it, no: $iterator->counter, itemBase: $itemBase, preview: $preview}
                {/foreach}
            </div>
        {else}
            <div class="empty"><h3>ครูยังไม่ได้ใส่เนื้อหาในหน่วยนี้</h3></div>
        {/if}
    </section>
</div>
{/block}
