{layout '../layout.latte'}

{block title}วิชาที่เรียน{/block}

{block content}
<div class="dash">
    <div class="dash-greeting">วิชาที่เรียน</div>
    <div class="dash-sub">{$term ?? ''} · {count($courses)} รายวิชา</div>

    {include '../_partials/join-form.latte'}

    {if $courses}
        <div class="course-grid">
            {foreach $courses as $c}
                <a class="course-card" href="{$base}/learn/{$c['id']}">
                    <div class="course-card-head" style="--cc:#{$c['color']};--ca:#{$c['accent']}">
                        {if $c['cover_url']}<img class="cover-img" src="{$c['cover_url']}" alt="" loading="lazy">{/if}
                        <div class="name">{$c['name']}</div>
                        <div class="code">{$c['code']}</div>
                        <div class="teacher">{$c['teacher_name'] ?? '—'}</div>
                    </div>
                    <div class="course-card-body">
                        {if $unseenPosts[(int) $c['id']] ?? 0}
                            <span class="chip chip-warn"><span class="msi" aria-hidden="true">campaign</span>ประกาศใหม่ {$unseenPosts[(int) $c['id']]}</span>
                        {/if}
                    </div>
                    <div class="course-card-icons" aria-hidden="true">
                        <span class="msi" title="งานของฉัน">assignment</span>
                        <span class="msi" title="เปิดรายวิชา">folder_open</span>
                    </div>
                </a>
            {/foreach}
        </div>
    {else}
        <div class="empty" style="margin-top:26px"><h3>ยังไม่ได้ลงทะเบียนในรายวิชาใด</h3><p>ขอรหัสหรือลิงก์เข้าร่วมจากครูประจำวิชา แล้วกรอกในช่องด้านบน</p></div>
    {/if}
</div>
{/block}
