<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{$kicker} · {$heading} · {$appName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=Noto+Sans+Thai:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="{$base}/assets/css/app.css?v={$assetVer ?? 1}">
</head>
<body>
{*
    ทำข้อสอบแบบไม่บันทึก ตรวจในเบราว์เซอร์ ไม่ส่งอะไรไปเซิร์ฟเวอร์ — ใช้สองแบบ
      • ซ้อมสอบในโหมดคุมสอบ (StudentController::practice / previewPractice) ข้อสอบเป็นข้อตกลงการสอบ
      • ครูทดลองสอบในมุมมองนักเรียน (StudentController::tryQuiz) ใช้ข้อสอบจริงของชุดนั้น
    โหมดคุมสอบ (ถ้าเปิด) ทำงานแบบ data-practice: เตือนและแสดงหน้าระงับให้เห็น แต่ไม่บันทึก ไม่ระงับจริง
*}
<div class="take" id="take" data-submit-text="{$teacherTrial ? 'ส่งคำตอบ' : 'ส่งคำตอบ (ซ้อม)'}" {if $proctorOn}data-proctor="1" data-practice="1" data-plimit="{$limit}" data-switches="0" data-copies="0"
     data-locked="0" data-student="{$studentName} · {$studentCode}"{/if} data-until="{$until ?? ''}" data-timeup="{$timeUpText}">

    {* ครูทดลองสอบ: หน้าจอเหมือนที่นักเรียนเห็นทุกประการ · ข้อมูลสำหรับครูอยู่ในป้ายลอยมุมจอ (.trial-only) อย่างเดียว *}
    {if $teacherTrial}
        <div class="trial-only trial-float" role="note">
            <span class="trial-only-tag">เฉพาะครู · นักเรียนไม่เห็นป้ายนี้</span>
            <span>ทดลองสอบในมุมมองนักเรียน · ไม่บันทึกคำตอบ · ใช้ข้อสอบที่บันทึกไว้ล่าสุด{if $quiz['review_status'] !== 'published'} · ชุดนี้ยังไม่เผยแพร่{/if}{if !$proctorOn} · โหมดคุมสอบปิดอยู่{/if}</span>
            <a href="{$base}{$backUrl}" data-leave>ออกจากการทดลอง</a>
        </div>
    {/if}

    <header class="take-bar">
        <div class="take-bar-inner">
            <div class="grow">
                <div class="take-code mono">{$kicker}</div>
                <div class="take-title">{$heading}</div>
            </div>
            <div class="take-clock mono" id="clock" title="เวลาที่เหลือ"></div>
        </div>
        <div class="bar take-progress"><span id="progress" style="width:0%"></span></div>
        <div class="take-bar-inner take-meta">
            <span id="posText">ข้อ 1 จาก {count($questions)}</span>
            {if $teacherTrial}<span>ตอบแล้ว 0 ข้อ</span>
            {elseif $proctorOn}<span class="pr-counters" id="prCounters">สลับหน้าจอ 0/{$limit} · คัดลอก/จับภาพ 0/{$limit}</span>{/if}
        </div>
    </header>

    <main class="take-main">
        {foreach $questions as $i => $q}
            <section class="take-q" data-answer="{$q['answer'] ?? ''}" {if $i > 0}hidden{/if}>
                <div class="take-q-text">{$q['q']}</div>
                {if $q['c']}
                    <div class="take-choices">
                        {foreach $q['c'] as $k => $c}
                            <button type="button" class="take-choice" data-choice="{$k}">
                                <span class="take-choice-key mono">{$c['label']}</span>
                                <span>{$c['text']}</span>
                            </button>
                        {/foreach}
                    </div>
                {else}
                    <textarea class="input take-answer" data-text placeholder="พิมพ์คำตอบของคุณที่นี่" rows="3"></textarea>
                {/if}
                <p class="practice-why" hidden>{$q['why']}</p>
            </section>
        {/foreach}

        <section class="practice-done" id="practiceDone" hidden>
            <div class="result-check">✓</div>
            <h2>{$teacherTrial ? 'ทดลองสอบเสร็จแล้ว' : 'ซ้อมเสร็จแล้ว'}</h2>
            <p id="practiceScore"></p>
            <p class="hint">{$doneHint}</p>
            <div class="practice-done-actions">
                <button type="button" class="btn btn-primary" id="practiceAgain">{$teacherTrial ? 'ทดลองอีกครั้ง' : 'ซ้อมอีกครั้ง'}</button>
                <a class="btn" href="{$base}{$backUrl}" id="practiceBack">กลับ</a>
            </div>
        </section>
    </main>

    <footer class="take-foot" id="practiceFoot">
        <button type="button" class="btn" id="prevBtn">ข้อก่อนหน้า</button>
        <span class="grow hint" style="text-align:center">{$footNote}</span>
        <button type="button" class="btn btn-primary" id="nextBtn">ข้อถัดไป</button>
    </footer>

    {if $proctorOn}{include '../_partials/proctor-overlays.latte', limit: $limit, practice: !$teacherTrial, trial: $teacherTrial, switches: 0, copies: 0}{/if}
</div>

{if $proctorOn}<script src="{$base}/assets/js/quiz-proctor.js?v={$assetVer ?? 1}"></script>{/if}
<script src="{$base}/assets/js/quiz-practice.js?v={$assetVer ?? 1}"></script>
</body>
</html>
