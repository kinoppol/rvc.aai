{layout '../layout.latte'}

{block title}{$item['title']}{/block}

{* อ่านส่วนเนื้อหา / ใบงานทีละรายการ พร้อมปุ่มก่อนหน้า-ถัดไปตามลำดับในหน่วย *}
{define navLink, $target, $dir}
    {var $text = $dir === 'prev' ? 'ก่อนหน้า' : 'ถัดไป'}
    {if $target['kind'] === 'quiz'}
        {if $preview}
            <button class="learn-nav-btn" type="button" disabled>
                {if $dir === 'prev'}<span class="msi" aria-hidden="true">arrow_back</span>{/if}
                <span><small>{$text} · {$target['label']}</small>{$target['title']}</span>
                {if $dir === 'next'}<span class="msi" aria-hidden="true">arrow_forward</span>{/if}
            </button>
        {else}
            <form method="post" action="{$base}/learn/quizzes/{$target['id']}/start">
                <input type="hidden" name="_token" value="{$csrf}">
                <button class="learn-nav-btn" type="submit">
                    {if $dir === 'prev'}<span class="msi" aria-hidden="true">arrow_back</span>{/if}
                    <span><small>{$text} · {$target['label']}</small>{$target['title']}</span>
                    {if $dir === 'next'}<span class="msi" aria-hidden="true">arrow_forward</span>{/if}
                </button>
            </form>
        {/if}
    {else}
        <a class="learn-nav-btn" href="{$base}{$itemBase}/{$target['kind']}/{$target['id']}">
            {if $dir === 'prev'}<span class="msi" aria-hidden="true">arrow_back</span>{/if}
            <span><small>{$text} · {$target['label']}</small>{$target['title']}</span>
            {if $dir === 'next'}<span class="msi" aria-hidden="true">arrow_forward</span>{/if}
        </a>
    {/if}
{/define}

{block content}
<div class="learn-page">
    <a class="back-link" href="{$base}{$itemBase}">← {$unit['kind_label'] ?? 'หน่วยการเรียน'} · {$unit['title']}</a>
    {if $preview}
        <div class="preview-banner">
            <span class="msi" aria-hidden="true">visibility</span>
            <div><b>มุมมองของนักเรียน</b> · การเปิดดูในโหมดนี้ไม่นับเป็นความคืบหน้าของนักเรียน</div>
        </div>
    {/if}

    <div class="learn-item-head">
        <span class="path-type path-tone-{$item['tone']}"><span class="msi" aria-hidden="true">{$item['icon']}</span>{$item['label']}</span>
        <span class="path-meta">รายการที่ {$position} จาก {count($items)}{if $item['meta']} · {$item['meta']}{/if}</span>
    </div>
    <h1 class="learn-item-title">{$item['title']}</h1>

    <section class="learn-card learn-item-body">
        {if $item['kind'] === 'section'}
            {if $record['type'] === 'text'}
                <div class="learn-text learn-reading">{$record['content']}</div>
            {elseif $record['type'] === 'video'}
                <div class="learn-video">
                    <iframe src="{$record['video_url']}" allowfullscreen loading="lazy" title="{$item['title']}"></iframe>
                </div>
            {else}
                {var $fileUrl = $base . $itemBase . '/section/' . $record['id'] . '/file'}
                <div class="learn-file">
                    <span class="msi" aria-hidden="true">description</span>
                    <span class="learn-file-name">{$record['file_name'] ?? 'ไฟล์ PDF'} <small class="learn-pdf-count"></small></span>
                    <a class="btn btn-sm" href="{$fileUrl}" target="_blank" rel="noopener"><span class="msi" aria-hidden="true">open_in_new</span>เปิดเต็มจอ</a>
                </div>
                {* อ่านในหน้าได้เลยไม่ต้องดาวน์โหลด — pdf-view.js วาดด้วย PDF.js (ใช้ได้บนมือถือ) ไม่ได้ก็ใช้ iframe *}
                <div class="learn-pdf" data-pdf-src="{$fileUrl}" data-pdf-title="{$record['file_name'] ?? 'ไฟล์ PDF'}">
                    <noscript><iframe src="{$fileUrl}" title="{$record['file_name'] ?? 'ไฟล์ PDF'}"></iframe></noscript>
                </div>
                <script src="{$base}/assets/js/pdf-view.js?v={$assetVer}" defer></script>
            {/if}
        {else}
            {if $record['description']}
                <div class="learn-text learn-reading">{$record['description']}</div>
            {else}
                <p class="learn-text">ครูยังไม่ได้ใส่รายละเอียดของใบงานนี้</p>
            {/if}
            <p class="learn-note">
                <span class="msi" aria-hidden="true">info</span>
                ส่งใบงานได้ที่ช่องด้านล่าง{if $item['score']} · เต็ม {$item['score']}{/if}{if $record['due_at']} · กำหนดส่ง {App\Support\Thai::dateTime($record['due_at'])}{if !$record['allow_late']} (ไม่รับส่งช้า){/if}{/if}
            </p>
        {/if}
    </section>

    {if $item['kind'] === 'worksheet'}
        {include '../_partials/submission.latte'}
    {/if}

    <nav class="learn-nav" aria-label="รายการก่อนหน้าและถัดไป">
        <div>{if $prevItem}{include navLink, $prevItem, 'prev'}{/if}</div>
        <div>
            {if $nextInPath}
                {include navLink, $nextInPath, 'next'}
            {else}
                <a class="learn-nav-btn" href="{$base}{$itemBase}"><span><small>จบหน่วยแล้ว</small>กลับไปหน้าหน่วย</span><span class="msi" aria-hidden="true">arrow_forward</span></a>
            {/if}
        </div>
    </nav>
</div>
{/block}
