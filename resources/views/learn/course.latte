{layout '../layout.latte'}

{block title}{$course['name']}{/block}

{block content}
<div class="course-page">
    <div class="course-header">
        <div class="course-header-inner">
            <div class="course-banner" style="--cc:#{$course['color']};--ca:#{$course['accent']}">
            {if $course['cover_url']}<img class="cover-img" src="{$course['cover_url']}" alt="">{/if}
            <div class="course-head-code">{$course['code']} · ผู้สอน {$course['teacher_name'] ?? '—'}</div>
            <h1>{$course['name']}</h1>
            <div class="course-head-stats">{count($units)} หน่วยการเรียน</div>
            </div>
        </div>
    </div>

    <div class="course-body">
        {if $units}
            <div class="list">
                {var $no = 0}
                {foreach $units as $u}
                    {* หน่วยสอบกลางภาค/ปลายภาคไม่นับเลขหน่วย *}
                    {var $exam = App\Domain\UnitRepository::isExam($u)}
                    {if !$exam}{do $no++}{/if}
                    <a n:class="list-row, $exam ? 'is-exam is-published'" href="{$base}/learn/units/{$u['id']}" style="color:inherit">
                        <div class="list-no">{$exam ? 'สอบ' : sprintf('%02d', $no)}</div>
                        <div class="list-main">
                            <div class="list-title">{$u['title']}</div>
                            {if $u['key_content']}<div class="list-meta">{$u['key_content']}</div>{/if}
                        </div>
                    </a>
                    {foreach $quizzesByUnit[(int) $u['id']] ?? [] as $q}
                        {include '../_partials/quiz-row.latte', q: $q}
                    {/foreach}
                {/foreach}
            </div>
        {elseif !$otherQuizzes}
            <div class="empty"><h3>ยังไม่มีหน่วยการเรียนที่เผยแพร่</h3></div>
        {/if}

        {if $otherQuizzes}
            <h2 class="learn-section-title">แบบทดสอบ</h2>
            <div class="list">
                {foreach $otherQuizzes as $q}
                    {include '../_partials/quiz-row.latte', q: $q}
                {/foreach}
            </div>
        {/if}
    </div>
</div>
{/block}
