{layout '../layout.latte'}

{block title}ผู้ช่วย AI ของฉัน{/block}

{block content}
<div class="wizard-page" style="max-width:1000px" id="aiSettings" data-base="{$base}">
    <h1>ผู้ช่วย AI ของฉัน</h1>
    <div class="sub">เลือกได้ว่าจะให้ผู้ช่วยทำงานด้วยเครื่องของส่วนกลาง หรือด้วยบริการที่ครูเชื่อมเอง</div>

    <div class="ai-cards">
        <div class="card ai-card ai-card-college">
            <span class="tag" style="background:var(--brand);color:#fff">แนะนำ · {$key && $routePref !== 'college' ? 'สำรอง' : 'ใช้อยู่'}</span>
            <h2>AI ของส่วนกลาง</h2>
            <p>เครื่องหรือบริการที่ส่วนกลางจัดให้ ผู้ดูแลระบบเป็นผู้ตั้งค่าให้ทั้งหมด ครูใช้ได้ทันทีโดยไม่ต้องกรอกอะไร</p>
            <ul class="feat">
                <li><span class="ok">✓</span> ใช้ได้เลย ไม่ต้องกรอกอะไร</li>
                <li><span class="ok">✓</span> ข้อมูลอยู่ในวิทยาลัย</li>
                <li><span class="dot">•</span> ช้ากว่าเมื่อมีครูใช้พร้อมกันหลายคน</li>
            </ul>
            <div class="quota-box">
                <div class="quota-box-row"><span>โควตาเดือนนี้</span><span class="mono">เหลือ {$quota['left']} จาก {$quota['limit']} ครั้ง</span></div>
                <div class="bar"><span style="width: {100 - $quota['pct']}%"></span></div>
                <div class="hint">โควตารีเซ็ตทุกวันที่ 1 ของเดือน</div>
            </div>
            <div class="ai-status">
                <span n:class="dot-status, $endpoint && $endpoint['status'] === 'online' ? is-online"></span>
                {if $endpoint && $endpoint['status'] === 'online'}
                    ตอนนี้พร้อมใช้งาน{if $queue > 0} · มีคิวรอ {$queue} งาน{/if}
                {else}
                    ตอนนี้เครื่องของส่วนกลางไม่พร้อมใช้งาน
                {/if}
            </div>
        </div>

        <div class="card ai-card">
            <span class="tag tag-muted">{$key ? ($routePref === 'byok' ? 'เชื่อมแล้ว · ใช้อยู่' : 'เชื่อมแล้ว · สำรอง') : 'ยังไม่ได้เชื่อม'}</span>
            <h2>AI ของฉัน</h2>
            <p>ครูที่มีบัญชีบริการ AI ของตัวเองอยู่แล้ว เอามาเชื่อมได้ ค่าเริ่มต้นระบบจะใช้ของครูก่อน และเลือกเปลี่ยนได้ที่หัวข้อด้านล่าง</p>
            <ul class="feat">
                <li><span class="ok">✓</span> ได้ผลเร็วขึ้น ไม่ต้องรอคิว</li>
                <li><span class="ok">✓</span> ไม่ใช้โควตาของส่วนกลาง</li>
                <li><span class="dot">•</span> ค่าใช้บริการเป็นของครูเอง</li>
            </ul>

            {if !$byokAllowed}
                <div class="alert alert-info" style="margin-top:16px"><span>ℹ</span><div>ผู้ดูแลระบบปิดการเชื่อม AI ส่วนตัวไว้ ติดต่อฝ่าย IT หากต้องการใช้งาน</div></div>
            {elseif $keys}
                {* ครูเชื่อมได้หลายบริการ แต่ละบริการเปิดได้หลายโมเดล *}
                <div class="key-list">
                    {foreach $keys as $k}
                        <div class="key-item">
                            <div class="key-head">
                                <strong>{$k['provider_name']}</strong>
                                <span class="hint">รหัสลงท้าย <span class="mono">…{$k['key_last4']}</span>{if $k['verified_ago']} · ทดสอบล่าสุด{$k['verified_ago']}{/if}</span>
                            </div>
                            <div class="model-chips">
                                {foreach $k['models'] as $m}
                                    <span n:class="chip, $iterator->first ? chip-ok : chip-muted" title="{$m}">{$m}{if $iterator->first} · หลัก{/if}</span>
                                {else}
                                    <span class="chip chip-muted">โมเดลเริ่มต้นของผู้ให้บริการ</span>
                                {/foreach}
                            </div>
                            <div class="key-btns">
                                <button type="button" class="btn btn-sm" data-edit-models="{$k['id']}"
                                        data-models="{json_encode($k['models'])}" data-name="{$k['provider_name']}">เลือกโมเดล</button>
                                <form method="post" action="{$base}/settings/ai/disconnect"
                                      data-confirm-title="ยกเลิกการเชื่อม {$k['provider_name']}" data-confirm-ok="ยกเลิกการเชื่อม" data-confirm-danger
                                      data-confirm="ยกเลิกการเชื่อม {$k['provider_name']} · รหัสที่บันทึกไว้จะถูกลบ และงานจะใช้ AI ตัวอื่นแทน">
                                    <input type="hidden" name="_token" value="{$csrf}">
                                    <input type="hidden" name="key_id" value="{$k['id']}">
                                    <button type="submit" class="btn btn-sm btn-ghost-danger">ยกเลิกการเชื่อม</button>
                                </form>
                            </div>
                        </div>
                    {/foreach}
                </div>
                <button type="button" class="btn btn-block" style="margin-top:12px" data-open-wizard>+ เชื่อม AI เพิ่มอีกบริการ</button>
            {else}
                <button type="button" class="btn btn-primary btn-block" style="margin-top:16px" data-open-wizard>เชื่อมต่อ AI ของฉัน</button>
                <div class="hint" style="margin-top:10px">ใช้เวลาประมาณ 3 นาที มีขั้นตอนบอกทีละหน้าจอ ถ้าไม่เชื่อมก็ใช้ AI ของส่วนกลางได้ตามปกติ</div>
            {/if}
        </div>
    </div>

    {if count($aiOptions) > 1}
    <div class="card" style="margin-top:24px">
        <h2>AI ที่ใช้เป็นค่าเริ่มต้น</h2>
        <div class="hint" style="margin-top:6px">
            ใช้กับทุกงานที่ไม่ได้เลือก AI ไว้เอง · ตอนสั่งงานในช่องสนทนา ออกข้อสอบ หรือทำแผนการสอน ยังเลือกเปลี่ยนเป็นรายครั้งได้
            · ถ้าตัวที่เลือกใช้ไม่ได้ ระบบจะสลับไปตัวอื่นให้อัตโนมัติ
        </div>
        <form method="post" action="{$base}/settings/ai/default" class="default-ai-form" style="margin-top:12px">
            <input type="hidden" name="_token" value="{$csrf}">
            <select class="input" name="target" aria-label="AI ที่ใช้เป็นค่าเริ่มต้น">
                <option value="">อัตโนมัติ · AI ของฉันก่อน แล้วจึงของส่วนกลาง</option>
                {var $group = null}
                {foreach $aiOptions as $o}
                    {if $o['group'] !== $group}
                        {if $group !== null}</optgroup>{/if}
                        <optgroup label="{$o['group']}">
                        {var $group = $o['group']}
                    {/if}
                    <option value="{$o['id']}" selected="{$o['id'] === $aiDefault}">{$o['label']}{if !$o['online']} (ปิดอยู่){/if}</option>
                {/foreach}
                {if $group !== null}</optgroup>{/if}
            </select>
            <button type="submit" class="btn btn-primary">บันทึก</button>
        </form>
    </div>
    {/if}

    <div class="card" style="margin-top:24px">
        <h2>คุณภาพของผลลัพธ์</h2>
        <form method="post" action="{$base}/settings/ai/mode" class="mode-row" style="margin-top:12px">
            <input type="hidden" name="_token" value="{$csrf}">
            <button type="submit" name="mode" value="fast" n:class="level-card, $qualityPref === 'fast' ? is-on">
                <div class="level-name">โหมดประหยัด</div>
                <div class="level-desc">ตอบไว เหมาะกับร่างข้อสอบและสรุปสั้น</div>
            </button>
            <button type="submit" name="mode" value="quality" n:class="level-card, $qualityPref === 'quality' ? is-on">
                <div class="level-name">โหมดคุณภาพสูง</div>
                <div class="level-desc">ใช้เวลามากกว่า เหมาะกับแผนการสอนและเอกสารส่งฝ่ายวิชาการ</div>
            </button>
        </form>
    </div>
</div>

{if $byokAllowed}
<div class="modal-backdrop" id="wizardModal" hidden>
    <div class="modal-panel">
        <div class="modal-head">
            <div class="grow">
                <div class="modal-title">เชื่อม AI ของฉัน</div>
                <div class="hint" id="wizStepName">ขั้นที่ 1 จาก 3 · เลือกบริการ</div>
            </div>
            <button type="button" class="icon-btn" data-close-wizard>✕</button>
        </div>
        <div class="modal-progress"><span id="wizBar" style="width:33%"></span></div>

        <form method="post" action="{$base}/settings/ai/connect" class="modal-body" id="wizardForm" data-busy="กำลังตรวจสอบรหัสกับผู้ให้บริการ…">
            <input type="hidden" name="_token" value="{$csrf}">
            <input type="hidden" name="provider" id="wizProvider" value="google">

            <div class="wiz-step" data-step="1">
                <p class="hint">เลือกบริการที่ครูมีบัญชีอยู่แล้ว ถ้าไม่มีเลย ข้ามไปใช้ AI ของส่วนกลางได้</p>
                <div class="prov-list">
                    {foreach $providers as $pv => $name}
                        <button type="button" data-prov="{$pv}" n:class="prov-row, $iterator->first ? is-on">
                            <span class="prov-mark mono">{$pv === 'google' ? 'GA' : ($pv === 'openrouter' ? 'OR' : '···')}</span>
                            <span class="grow">
                                <span class="prov-name">{$name}</span>
                                <span class="prov-hint">{$pv === 'google' ? 'ขอรหัสฟรีได้ด้วยบัญชี Google' : ($pv === 'openrouter' ? 'เลือกได้หลายผู้ให้บริการในบัญชีเดียว' : 'สำหรับครูที่มีระบบของตัวเองอยู่แล้ว')}</span>
                            </span>
                            <span class="prov-tick">✓</span>
                        </button>
                    {/foreach}
                </div>
            </div>

            <div class="wiz-step" data-step="2" hidden>
                <p class="hint">เปิดหน้าเว็บของ <b id="wizProvName">Google AI Studio</b> แล้วทำตาม 3 ขั้นนี้ จากนั้นกลับมาวางรหัสในขั้นถัดไป</p>
                <ol class="key-steps">
                    <li><span>1</span>ลงชื่อเข้าใช้ด้วยบัญชีของครู แล้วมองหาเมนู “รหัสสำหรับเชื่อมต่อ” (API key)</li>
                    <li><span>2</span>กดสร้างรหัสใหม่ ระบบจะแสดงข้อความยาว ๆ หนึ่งบรรทัด</li>
                    <li><span>3</span>กดคัดลอกทั้งบรรทัด แล้วกลับมาที่หน้านี้เพื่อวางในขั้นถัดไป</li>
                </ol>
                <div class="field" id="baseUrlField" hidden>
                    <label for="wizBaseUrl">ที่อยู่ของบริการ (เฉพาะบริการที่กรอกเอง)</label>
                    <input class="input mono" id="wizBaseUrl" name="base_url" placeholder="https://…">
                </div>
            </div>

            <div class="wiz-step" data-step="3" hidden>
                <p class="hint">วางรหัสที่คัดลอกมาในช่องนี้ ระบบเก็บรหัสไว้เฉพาะบัญชีของครู และไม่แสดงให้ผู้อื่นเห็น</p>
                <div class="field">
                    <label for="wizKey">รหัสเชื่อมต่อจาก <span id="wizProvName2">Google AI Studio</span></label>
                    <div style="display:flex;gap:9px">
                        <input class="input mono" type="password" id="wizKey" name="key" style="flex:1" autocomplete="off">
                        <button type="button" class="btn btn-ai" id="wizTestBtn">ทดสอบการเชื่อมต่อ</button>
                    </div>
                </div>
                <div id="wizTestResult"></div>
                <div class="field" id="wizModelsField" style="margin-top:14px" hidden>
                    <label>โมเดลที่จะเปิดใช้ · เลือกได้หลายตัว</label>
                    <div id="wizModels"></div>
                </div>
            </div>
        </form>

        <div class="modal-foot">
            <button type="button" class="btn" id="wizBackBtn">ปิด</button>
            <div class="grow"></div>
            <button type="button" class="btn btn-primary" id="wizNextBtn">ถัดไป</button>
        </div>
    </div>
</div>

<div class="modal-backdrop" id="modelsModal" hidden>
    <div class="modal-panel">
        <div class="modal-head">
            <div class="grow">
                <div class="modal-title">เลือกโมเดลที่เปิดใช้</div>
                <div class="hint" id="modelsModalName"></div>
            </div>
            <button type="button" class="icon-btn" data-close-models>✕</button>
        </div>
        <form method="post" class="modal-body" id="modelsForm">
            <input type="hidden" name="_token" value="{$csrf}">
            <div class="hint" id="modelsLoading" style="margin-bottom:10px">กำลังดึงรายชื่อโมเดลจากผู้ให้บริการ…</div>
            <div id="modelsPicker"></div>
        </form>
        <div class="modal-foot">
            <button type="button" class="btn" data-close-models>ยกเลิก</button>
            <div class="grow"></div>
            <button type="submit" form="modelsForm" class="btn btn-primary">บันทึกโมเดล</button>
        </div>
    </div>
</div>
{/if}

<script src="{$base}/assets/js/model-picker.js"></script>
<script>
(function () {
    var root = document.getElementById('aiSettings'), base = root.dataset.base;
    var modal = document.getElementById('wizardModal');
    if (!modal) return;
    var step = 1, tested = false, csrf = document.getElementById('wizardForm')._token.value;
    var names = { google: 'Google AI Studio', openrouter: 'OpenRouter', openai_compatible: 'บริการที่กรอกที่อยู่เอง' };

    function show(s) {
        step = s; tested = false;
        modal.querySelectorAll('.wiz-step').forEach(function (el) { el.hidden = +el.dataset.step !== s; });
        document.getElementById('wizBar').style.width = (s / 3 * 100) + '%';
        document.getElementById('wizStepName').textContent = 'ขั้นที่ ' + s + ' จาก 3 · ' + ['เลือกบริการ', 'ไปขอรหัส', 'วางรหัสและทดสอบ'][s - 1];
        document.getElementById('wizBackBtn').textContent = s === 1 ? 'ปิด' : 'ย้อนกลับ';
        document.getElementById('wizNextBtn').textContent = s === 3 ? 'เสร็จสิ้น ใช้ AI ของฉัน' : 'ถัดไป';
        var prov = document.getElementById('wizProvider').value;
        document.getElementById('wizProvName').textContent = names[prov];
        document.getElementById('wizProvName2').textContent = names[prov];
        document.getElementById('baseUrlField').hidden = prov !== 'openai_compatible';
        document.getElementById('wizTestResult').innerHTML = '';
        document.getElementById('wizModelsField').hidden = true;
        document.getElementById('wizModels').innerHTML = '';
    }
    function open() { modal.hidden = false; document.body.style.overflow = 'hidden'; show(1); }
    function close() { modal.hidden = true; document.body.style.overflow = ''; }

    root.querySelectorAll('[data-open-wizard]').forEach(function (b) { b.addEventListener('click', open); });
    modal.querySelector('[data-close-wizard]').addEventListener('click', close);
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (!modal.hidden) close();
        if (!document.getElementById('modelsModal').hidden) { document.getElementById('modelsModal').hidden = true; document.body.style.overflow = ''; }
    });

    modal.querySelectorAll('.prov-row').forEach(function (row) {
        row.addEventListener('click', function () {
            modal.querySelectorAll('.prov-row').forEach(function (r) { r.classList.remove('is-on'); });
            row.classList.add('is-on');
            document.getElementById('wizProvider').value = row.dataset.prov;
        });
    });

    document.getElementById('wizBackBtn').addEventListener('click', function () {
        step === 1 ? close() : show(step - 1);
    });

    document.getElementById('wizTestBtn').addEventListener('click', runTest);
    function runTest() {
        var btn = document.getElementById('wizTestBtn');
        btn.disabled = true; btn.textContent = 'กำลังทดสอบ…';
        var body = new URLSearchParams({
            _token: csrf,
            provider: document.getElementById('wizProvider').value,
            key: document.getElementById('wizKey').value,
            base_url: document.getElementById('wizBaseUrl').value
        });
        fetch(base + '/settings/ai/test', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                btn.disabled = false; btn.textContent = 'ทดสอบการเชื่อมต่อ';
                tested = d.ok;
                var box = document.getElementById('wizTestResult');
                box.className = 'alert ' + (d.ok ? 'alert-success' : 'alert-error');
                box.style.marginTop = '14px';
                box.innerHTML = '<span>' + (d.ok ? '✓' : '✕') + '</span><div></div>';
                box.querySelector('div').textContent = d.message;

                // ทดสอบผ่าน — ให้เลือกโมเดลที่จะเปิดใช้ (ติ๊กตัวที่ผู้ให้บริการแนะนำไว้ให้ก่อน)
                var field = document.getElementById('wizModelsField');
                field.hidden = !d.ok;
                if (d.ok) {
                    var picker = RvcModelPicker(document.getElementById('wizModels'), { name: 'models[]' });
                    picker.setModels(d.models || []);
                    picker.suggest(d.model);
                }
            });
    }

    /* เลือกโมเดลของบริการที่เชื่อมไว้แล้ว — ดึงรายชื่อด้วยรหัสที่เก็บไว้ ครูไม่ต้องวางรหัสใหม่ */
    var modelsModal = document.getElementById('modelsModal');
    var modelsForm = document.getElementById('modelsForm');
    function closeModels() { modelsModal.hidden = true; document.body.style.overflow = ''; }
    modelsModal.querySelectorAll('[data-close-models]').forEach(function (b) { b.addEventListener('click', closeModels); });
    modelsModal.addEventListener('click', function (e) { if (e.target === modelsModal) closeModels(); });

    root.querySelectorAll('[data-edit-models]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = btn.dataset.editModels;
            modelsForm.action = base + '/settings/ai/keys/' + id + '/models';
            document.getElementById('modelsModalName').textContent = btn.dataset.name;
            var loading = document.getElementById('modelsLoading');
            loading.hidden = false;
            loading.textContent = 'กำลังดึงรายชื่อโมเดลจากผู้ให้บริการ…';
            var picker = RvcModelPicker(document.getElementById('modelsPicker'), {
                name: 'models[]',
                selected: JSON.parse(btn.dataset.models || '[]')
            });
            modelsModal.hidden = false;
            document.body.style.overflow = 'hidden';

            fetch(base + '/settings/ai/keys/' + id + '/probe', {
                method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ _token: csrf })
            }).then(function (r) { return r.json(); }).then(function (d) {
                if (d.models && d.models.length) {
                    picker.setModels(d.models);
                    loading.hidden = true;
                } else {
                    loading.textContent = d.ok
                        ? 'ผู้ให้บริการไม่ได้บอกรายชื่อโมเดล · พิมพ์ชื่อโมเดลเองด้านล่างได้'
                        : 'ดึงรายชื่อโมเดลไม่ได้ · ' + d.message;
                }
            }).catch(function () { loading.textContent = 'ดึงรายชื่อโมเดลไม่สำเร็จ · พิมพ์ชื่อโมเดลเองได้'; });
        });
    });

    document.getElementById('wizNextBtn').addEventListener('click', function () {
        if (step < 3) { show(step + 1); return; }
        if (!tested) { runTest(); return; }
        document.getElementById('wizardForm').submit();
    });
})();
</script>
{/block}
