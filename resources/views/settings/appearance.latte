{layout '../layout.latte'}

{block title}สีหลักของหน้าจอ{/block}

{block content}
<div class="wizard-page" style="max-width:820px" id="appearancePage">
    <h1>สีหลักของหน้าจอ</h1>
    <div class="sub">
        {if $isAdmin}
            เลือกสีของคุณเอง หรือตั้งเป็นค่าเริ่มต้นให้ผู้ใช้ทุกคนที่ยังไม่ได้เลือกสีเอง
        {else}
            เลือกสีที่ถนัดตาได้ตามใจ · ถ้าไม่ตั้งเอง ระบบจะใช้สีที่ส่วนกลางกำหนดให้
        {/if}
    </div>

    <form method="post" action="{$base}/settings/appearance" class="card" style="margin-top:22px">
        <input type="hidden" name="_token" value="{$csrf}">
        <input type="hidden" name="color" id="colorValue" value="{$current}">

        <div class="step-label">สีสำเร็จรูป</div>
        <div class="swatches" style="margin-top:12px">
            {foreach $presets as $hex => $label}
                <button type="button" class="swatch{if $hex === $current} is-on{/if}" data-hex="{$hex}" title="{$label}">
                    <span class="swatch-dot" style="background:#{$hex}"></span>
                    <span class="swatch-name">{$label}</span>
                </button>
            {/foreach}
        </div>

        <div class="hr" style="margin:20px 0"></div>

        <div class="step-label">เลือกสีเอง</div>
        <div style="display:flex;gap:12px;align-items:center;margin-top:12px;flex-wrap:wrap">
            <input type="color" id="colorPicker" value="#{$current}" class="color-input" title="เลือกสีเอง">
            <input type="text" id="colorHex" class="input mono" style="width:140px" maxlength="7" value="#{$current}">
            <span class="hint">ใส่รหัสสีแบบ #RRGGBB ได้</span>
        </div>

        <div class="hr" style="margin:20px 0"></div>

        <div class="step-label">ตัวอย่าง</div>
        <div class="preview-row" style="margin-top:12px">
            <button type="button" class="btn btn-primary">ปุ่มหลัก</button>
            <button type="button" class="btn">ปุ่มรอง</button>
            <span class="tag" style="background:var(--brandSoft);color:var(--brand)">ป้ายกำกับ</span>
            <span class="chip chip-ok">สถานะ</span>
            <a href="#" onclick="return false">ลิงก์ในระบบ</a>
        </div>

        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:22px">
            <button type="submit" class="btn btn-primary">บันทึกสีของฉัน</button>

            {if $isAdmin}
                <button type="submit" name="as_default" value="1" class="btn">บันทึกและตั้งเป็นค่าเริ่มต้นของทุกคน</button>
            {/if}

            {if $usesOwn}
                <button type="submit" name="reset" value="1" class="btn btn-ghost-danger">กลับไปใช้สีของส่วนกลาง</button>
            {/if}
        </div>

        <div class="hint" style="margin-top:14px">
            สีของส่วนกลางตอนนี้คือ <span class="mono">#{$siteHex}</span>
            {if $usesOwn} · คุณตั้งสีของตัวเองไว้แล้ว{else} · คุณกำลังใช้สีของส่วนกลาง{/if}
        </div>
    </form>
</div>

<script>
(function () {
    var page = document.getElementById('appearancePage');
    if (!page) { return; }

    var value = document.getElementById('colorValue');
    var picker = document.getElementById('colorPicker');
    var hex = document.getElementById('colorHex');
    var root = document.documentElement;

    /* แสดงผลทันทีที่เลือก โดยยังไม่ต้องบันทึก */
    function preview(h) {
        h = h.replace('#', '').toUpperCase();
        // เช็คความยาวแยกต่างหาก เพราะตัวนับซ้ำในนิพจน์ปกติจะชนกับไวยากรณ์ของ Latte
        if (h.length !== 6 || /[^0-9A-F]/.test(h)) { return; }

        value.value = h;
        picker.value = '#' + h;
        if (hex.value.replace('#', '').toUpperCase() !== h) { hex.value = '#' + h; }

        var rgb = [h.slice(0, 2), h.slice(2, 4), h.slice(4, 6)].map(function (p) { return parseInt(p, 16); });
        var dark = root.getAttribute('data-theme') === 'dark';
        var mix = function (to, amount) {
            return '#' + rgb.map(function (c, i) {
                return Math.round(c + (to[i] - c) * amount).toString(16).padStart(2, '0');
            }).join('');
        };
        var white = [255, 255, 255], night = [14, 21, 19];
        var light = (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]) / 255;

        root.style.setProperty('--brand', dark ? mix(white, 0.42) : '#' + h);
        root.style.setProperty('--brandInk', dark ? '#08201C' : (light > 0.55 ? '#16221F' : '#FFFFFF'));
        root.style.setProperty('--brandSoft', dark ? mix(night, 0.76) : mix(white, 0.88));
        root.style.setProperty('--brandLine', dark ? mix(night, 0.58) : mix(white, 0.62));

        page.querySelectorAll('.swatch').forEach(function (b) {
            b.classList.toggle('is-on', b.dataset.hex === h);
        });
    }

    page.querySelectorAll('.swatch').forEach(function (b) {
        b.addEventListener('click', function () { preview(b.dataset.hex); });
    });
    picker.addEventListener('input', function () { preview(picker.value); });
    hex.addEventListener('input', function () { preview(hex.value); });
})();
</script>
{/block}
